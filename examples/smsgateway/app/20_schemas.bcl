# Request contracts. They run before any stage does: nothing is read, priced or
# queued for a request that does not fit.

shape "sms_send" {
  description "POST /v1/messages"
  additional_properties false
  prop "to"          { kind string required true min_length 5 max_length 32 description "Recipient: +9779841234567, 009779841234567 or a national number" }
  prop "text"        { kind string required true min_length 1 max_length 1600 }
  prop "from"        { kind string max_length 16 description "Sender id; defaults to the account's" }
  prop "type"        { kind string enum ["otp", "transactional", "promotional"] default "transactional" }
  prop "reference"   { kind string max_length 100 pattern "^[A-Za-z0-9._:-]+$" description "Idempotency key: the same reference never sends or charges twice" }
  prop "dlr"         { kind bool default true }
  prop "schedule_at" { kind string format date_time description "RFC 3339; at most 7 days ahead" }
  prop "expires_in"  { kind int min 1 max 604800 description "Seconds before an unsent message is dropped" }
  prop "meta"        { kind object }
}
