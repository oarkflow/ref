# SMS gateway: platform resources.
#
# The application is these files. Go supplies the vocabulary (resource kinds
# and actions); everything an operator decides lives here: which providers
# exist and what they cost, how messages are routed and priced, how failures
# are retried, and which stages a message passes through.

name "sms-gateway"
environment env("APP_ENV", "development")

# ---- Storage ---------------------------------------------------------------
#
# One database holds configuration, the ledger and the messages. Payments and
# state changes share a transaction, so SQLite (one writer) and PostgreSQL both
# work; with SQLite keep a single connection.

resource "db" {
  kind "database.sql"
  description "Messages, ledger, users, runtime configuration"
  config {
    driver "sqlite"
    dsn env("SMS_DSN", "file:.data/sms/sms.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)")
    max_open_connections 1
    ping true
  }
}

# ---- Queue ----------------------------------------------------------------
#
# github.com/oarkflow/broker, embedded, with a write-ahead log. Every provider
# has its own queue (sms.dispatch.<provider>) and its own consumers, so a slow
# or failing provider cannot starve the others. Configuration changes travel as
# broadcast events and are applied by their own consumers.

resource "bus" {
  kind "queue.broker"
  description "Durable queues: dispatch per provider, receipts, configuration events"
  config {
    dir env("SMS_BROKER_DIR", ".data/sms/broker")
    node_id env("SMS_NODE_ID", "node-1")
    concurrency 4
    visibility_timeout 60s
    # A safety net for crashes and infrastructure errors. Delivery retries and
    # failover are the provider's retry policy below, applied by the pipeline.
    retry { max_attempts 10 initial 500ms max 30s factor 2 jitter true }
    # A receipt can outrun the commit of the submission it describes; it is
    # retried quickly at first.
    consumer "sms.dlr"      { concurrency 2 retry { max_attempts 14 initial 200ms max 30s factor 2 } }
    consumer "sms.config.*" { concurrency 1 }
  }
}

# ---- The SMS platform ------------------------------------------------------

resource "sms" {
  kind "sms.hub"
  description "Users, providers, routing, ledger, consumers"
  config {
    database "db"
    queue "bus"

    currency "USD"
    default_country "NP"
    default_sender "DEMO"
    max_segments 6
    ttl 24h

    # Funds are held when a message is accepted. "submit" charges when a
    # provider accepts it; "delivered" waits for the handset's receipt. A
    # message that ends failed is never charged.
    capture_on "submit"
    refund_on_dlr_failure true

    # What a message type is routed for, and the floors it will not go below.
    routing {
      default "balanced"
      objectives { otp "highest_delivery" transactional "balanced" promotional "lowest_cost" }
      quality_floor { otp 85 }
      delivery_floor { otp 0.9 }
      breaker_failures 5
      breaker_open 30s
    }

    # What users pay per segment. The most specific rate wins: a user's own
    # rate first, then the one matching the most of country and type, then the
    # default. Rates added through the admin API override these.
    pricing {
      default 0.020
      country { NP 0.015 IN 0.012 GB 0.045 US 0.012 }
      rate "otp_np" { country "NP" type "otp" price 0.030 }
      rate "otp_in" { country "IN" type "otp" price 0.025 }
    }

    recovery { interval 15s grace 30s batch 200 }

    # Accounts created on first start. An existing account is never overwritten,
    # and the opening balance is credited once. Issue an API key with
    # POST /v1/admin/users/{id}/key.
    seed {
      user "demo" {
        name "Demo account"
        default_sender "DEMO"
        balance 25.0
      }
      user "acme_alice" {
        name "Alice (ACME)"
        tenant "acme"
        balance 10.0
      }
      user "acme_bob" {
        name "Bob (ACME)"
        tenant "acme"
        balance 10.0
      }
      # ACME's premium Nepal route is for ACME only; Alice also gets the India
      # vendor, which no other account may use (everyone else reaches India
      # through the catch-all).
      assignment "acme_premium" { tenant "acme" provider "premium_np" }
      assignment "alice_in"     { user_id "acme_alice" provider "in_vendor" countries ["IN"] priority 5 }
      rate "acme_np" { user_id "acme_alice" country "NP" sell_per_segment_micros 12000 }
    }
  }
}

# ---- Authentication ---------------------------------------------------------

resource "sender_auth" {
  kind "sms.auth"
  description "Account API keys (Authorization: Bearer <key>)"
  depends_on ["sms"]
  config { hub "sms" }
}

resource "admin_auth" {
  kind "auth.api_key"
  description "Operator key (X-API-Key or Authorization: Bearer)"
  config {
    key env.required("SMS_ADMIN_KEY")
    principal_id "operator"
    roles ["admin"]
  }
}
