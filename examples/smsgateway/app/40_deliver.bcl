# Delivery pipeline.
#
# Each provider has a queue, sms.dispatch.<provider>, and consumers sized by the
# provider's `concurrency`. The hub runs this intent for every job:
#
#   load_job        claim the message for this job; stale or duplicate jobs stop here
#   provider_send   circuit breaker, per-provider rate limit, timeout, gateway.Send
#   settle          the decision:
#                     accepted           -> CAPTURE the held funds, mark submitted
#                     retryable          -> retry the same provider after backoff
#                                           (the provider's `retry` policy)
#                     provider fault     -> fail over to the next provider
#                     permanent          -> fail the message, RELEASE the funds
#                     chain exhausted    -> fail the message, RELEASE the funds
#
# Every transition is a compare-and-set on the message, so a redelivered job or a
# second worker cannot repeat a send decision or a payment.

intent "sms.deliver" {
  description "Deliver one message through one provider"
  idempotent true
  response "outcome"
  timeout 90s

  node "job"    { uses "sms.load_job"      resource "sms" kind effect requires [input]       provides [job] }
  node "send"   { uses "sms.provider_send" resource "sms" kind effect requires [job]         provides [sent] }
  node "settle" { uses "sms.settle"        resource "sms" kind effect requires [job, sent]   provides [outcome] }
}

# Delivery receipts: pushed by a gateway (SMPP), or posted to the webhook below.
intent "sms.dlr" {
  description "Apply one delivery receipt"
  idempotent true
  response "outcome"
  node "apply" { uses "sms.dlr_apply" resource "sms" kind effect requires [input] provides [outcome] }
}

intent "sms.dlr_webhook" {
  description "A provider's receipt webhook"
  response "result"
  node "provider" { uses "request.param" kind pure provides [provider] config { name "provider" } }
  node "result"   { uses "sms.dlr_ingest" resource "sms" kind effect requires [provider] provides [result] }
}
route "sms.dlr_webhook" {
  description "Receipts from a provider; checked against the provider's webhook_secret"
  method POST
  path "/v1/webhooks/dlr/:provider"
  intent "sms.dlr_webhook"
  status 202
  max_body_bytes 262144
}
