# Submit pipeline.
#
#   authenticate (route) -> validate_user -> check_data -> route -> accept -> enqueue
#
# Stages are nodes; their order is what each requires and provides. To add a
# stage (a content filter, a fraud check, a sender-id registry) write the action
# in Go, register it, and put a node here between the ones it should sit between.
#
#   validate_user  active account, rate limit, daily cap
#   check_data     number, sender, text, segments, type, schedule, opt-outs
#   content        (example stage) deny patterns for chosen message types
#   route          the ordered chain of providers for this user and destination
#   accept         price it, HOLD the funds and store the message: one transaction,
#                  idempotent by reference, so a replay never charges twice
#   enqueue        publish the dispatch job to the first provider's queue

intent "sms.submit" {
  description "Accept one SMS: validate, route, take payment, queue"
  response "result"
  input_schema "sms_send"
  timeout 10s

  node "user"   { uses "sms.validate_user" resource "sms" kind read                           provides [user] }
  node "data"   { uses "sms.check_data"    resource "sms" kind read   requires [input, user]  provides [draft] }

  # An example of an added stage: a content policy, written in its own Go
  # package (internal/stages) and joined to the pipeline here. It consumes
  # `draft` and provides `vetted`; route and accept read `vetted` via draft_fact.
  node "content" {
    uses "sms.content_policy"
    kind read
    requires [draft]
    provides [vetted]
    config {
      types ["promotional"]
      deny ["(?i)\\b(lottery|jackpot|you have won)\\b", "(?i)\\bfree (money|bitcoin)\\b"]
      message "Promotional messages may not contain gambling or prize-draw content."
    }
  }

  node "route"  { uses "sms.route"         resource "sms" kind read   requires [user, vetted] provides [route] config { draft_fact "vetted" } }
  node "accept" { uses "sms.accept"        resource "sms" kind effect requires [user, vetted, route] provides [accepted] config { draft_fact "vetted" } }
  node "queue"  { uses "sms.enqueue"       resource "sms" kind effect requires [accepted]     provides [result] }
}

route "sms.submit" {
  description "Send an SMS. Answers 202 once the message is stored and paid for; delivery follows."
  method POST
  path "/v1/messages"
  intent "sms.submit"
  auth "sender_auth"
  status 202
  cache_control "no-store"
  max_body_bytes 65536
}

# What would happen to a message, without sending or charging anything.
intent "sms.explain" {
  response "result"
  node "result" { uses "sms.query" resource "sms" kind read requires [input] provides [result] config { op "route.explain" } }
}
route "sms.explain" { method POST path "/v1/route/explain" intent "sms.explain" auth "sender_auth" cache_control "no-store" }
