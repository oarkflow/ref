# Operator API. Every route needs the operator key (X-API-Key or
# Authorization: Bearer). Changes are stored, applied on this node and broadcast
# on the queue; each node's configuration consumers apply them, so every node
# converges on what the database says.

intent "admin.users.list" {
  response "result"
  node "result" { uses "sms.admin" resource "sms" kind read provides [result] config { op "user.list" } }
}
route "admin.users.list" { method GET path "/v1/admin/users" intent "admin.users.list" auth "admin_auth" cache_control "no-store" }

intent "admin.users.create" {
  response "result"
  node "result" { uses "sms.admin" resource "sms" kind effect requires [input] provides [result] config { op "user.put" } }
}
route "admin.users.create" { method POST path "/v1/admin/users" intent "admin.users.create" auth "admin_auth" cache_control "no-store" }

intent "admin.users.get" {
  response "result"
  node "id"     { uses "request.param" kind pure provides [id] config { name "id" } }
  node "result" { uses "sms.admin" resource "sms" kind read requires [id] provides [result] config { op "user.get" } }
}
route "admin.users.get" { method GET path "/v1/admin/users/:id" intent "admin.users.get" auth "admin_auth" cache_control "no-store" }

intent "admin.users.put" {
  response "result"
  node "id"     { uses "request.param" kind pure provides [id] config { name "id" } }
  node "result" { uses "sms.admin" resource "sms" kind effect requires [id, input] provides [result] config { op "user.put" } }
}
route "admin.users.put" { method PUT path "/v1/admin/users/:id" intent "admin.users.put" auth "admin_auth" cache_control "no-store" }

intent "admin.users.delete" {
  response "result"
  node "id"     { uses "request.param" kind pure provides [id] config { name "id" } }
  node "result" { uses "sms.admin" resource "sms" kind effect requires [id] provides [result] config { op "user.delete" } }
}
route "admin.users.delete" { method DELETE path "/v1/admin/users/:id" intent "admin.users.delete" auth "admin_auth" cache_control "no-store" }

