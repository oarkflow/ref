bcl { version "1.0" }

# GENERATED by the console from the routing rules (Admin > Rules > Routing rules).
# Do not edit by hand: the next change to a routing rule replaces it.
#
# This checked-in copy is the PLACEHOLDER the engine loads at start and the origin
# that rules.reset returns to. It deliberately holds no rules: the routing rules
# live in the routing_rules table, and this definition is generated from them and
# republished (config/46_converge.bcl). A hand-written copy of generated output
# would be a second, silent source of truth — and a checked-in one silently
# outranks the table on a fresh database, so a rule switched off in the console
# would keep routing traffic.

module "custom_routing" {
  version "1"
  environment "production"

  # One decision per provider, holding only the rules that name it: a message
  # is checked against the rules of each candidate, not against all of them.
  # "placeholder" is never evaluated; a definition must hold one decision, and with
  # no rules enabled this is it.
  decision_schema "placeholder" { effects [allow] default allow strategy first_match }
  decision_table "placeholder" {
    default allow
    hit_policy first
  }
}
