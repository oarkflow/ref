bcl { version "1.0" }

# GENERATED by the console from the routing rules (Admin > Rules > Routing rules).
# Do not edit by hand: the next change to a routing rule replaces it.

module "custom_routing" {
  version "1"
  environment "production"

  decision_schema "custom" { effects [allow, deny] default allow strategy first_match }
  decision_table "custom" {
    default allow
    hit_policy first

    row "rr_example_promo_never_live" {
      priority 1090
      when {
        all {
          provider.id == "smspasal_real"
          message.type matches "^(promotional)$"
}
      }
      then { outcome { decision deny reason "routing rule: Never send promotional messages over the live SMSPasal" attributes { tier "rule" priority 290000 exclusive false rule_id "rr_example_promo_never_live" } } }
    }

    row "rr_example_demo_live_number" {
      priority 1070
      when {
        all {
          provider.id == "smspasal_real"
          user.id == "demo"
          message.to matches "^(9779856034616)$"
}
      }
      then { outcome { decision allow reason "routing rule: Demo: my test number goes out through the live SMSPasal" attributes { tier "rule" priority 270000 exclusive false rule_id "rr_example_demo_live_number" } } }
    }

    row "rr_example_demo_login_code_sandbox" {
      priority 1060
      when {
        all {
          provider.id == "np_telecom"
          user.id == "demo"
          message.template matches "^(otp_login)$"
}
      }
      then { outcome { decision allow reason "routing rule: Demo: the login code template uses the sandbox carrier" attributes { tier "rule" priority 260000 exclusive false rule_id "rr_example_demo_login_code_sandbox" } } }
    }
}
}
