bcl { version "1.0" }

# Routing policy.
#
# For one message, each provider in the catalog (a row of the providers table,
# with its live health) is a candidate. Routing is two halves, and they happen in
# this order and no other:
#
#   1. FILTER (route_eligibility, below) — per candidate: may this provider
#      carry this message? A deny names the reason. An allow says which tier the
#      provider belongs to — which the ranking then reads as a score — and
#      whether the message is RESERVED for this provider alone. The filter
#      decides on identity and state: capability, assignment, ownership, whether
#      an operator's rule named it. It never compares candidates to each other,
#      so no provider is dropped for scoring badly.
#   2. RANK (the route_* rankings at the bottom) — score whatever survived the
#      filter, and put them in order, best first. That order is the chain a
#      message is sent down, and fails over along.
#
# A score can move a candidate up or down the chain. It can never remove one:
# that is the filter's job, and keeping the two apart is what makes the outcome
# depend on whether a provider may carry a message rather than on how its tier
# happened to be numbered.
#
# What routing deliberately does NOT read: the request's `dlr`. A delivery
# receipt is a reporting question, not a carrier-selection one, and a request
# field that changed which provider a message went to would mean two identical
# messages took different routes. Whether a receipt can actually be delivered is
# settled after routing, by rules/validate.bcl, which refuses a message that
# asked for one when nothing on its route can report it.
#
# Facts: message, user, and provider (the candidate): id, kind, state,
# circuit_open, quality, delivery_rate, cost_per_segment, cost (this message),
# price_known, countries, message_types, owner, users, tenants, assigned_only,
# prefix_pattern, supports_unicode / _dlr / _alpha / _long, sender_countries,
# successes, failures, consecutive_failures, failure_rate. Lists are written
# |a|b| so a row can test membership.
#
# A tier's priority is a score, added by the ranking and far larger than anything
# else in one, so a tier always outranks the next. That is an ordering statement,
# made in the ranking — not a filter.
#
# The order of the rows below is the policy. It reads in three bands:
#
#   1000-970  the provider cannot carry this message at all: it is switched off,
#             its circuit is open, the text cannot be encoded in what it sends,
#             or the law of the sender's country forbids it. No operator rule
#             overrules these, because the message would be lost or unlawful.
#    950      an operator's routing rule names this provider for this message.
#             It admits the provider (even one assigned to another account). The
#             priority the rule carries is not applied here; the ranking reads it
#             once the filtering is done.
#    940-900  limits an operator may knowingly overrule: a capability the
#             provider lacks, a message type it does not carry, a quality floor.
#             They sit BELOW the rule, so a rule that says "use this provider
#             here" wins. They sit above the tiers, so a provider nobody named is
#             still measured against them.
#
# The band a row is in is therefore a statement about who may overrule it, and
# moving a row between bands changes who decides, not what is true.

module "routing" {
  version "1"
  environment "production"

  decision_schema "route_eligibility" { effects [allow, deny] default deny strategy first_match }
  decision_table "route_eligibility" {
    default deny
    hit_policy first

    # ---- Hard limits: no rule overrules these ------------------------------
    row "provider-not-active" {
      priority 1000
      when { provider.state != "active" }
      then { outcome { decision deny reason "the provider is not active" attributes { code "PROVIDER_STATE" transient true } } }
    }
    row "circuit-open" {
      priority 990
      when { provider.circuit_open == 1 }
      then { outcome { decision deny reason "the provider is failing on this route and its circuit is open" attributes { code "CIRCUIT_OPEN" transient true } } }
    }
    # Text that cannot be encoded is not a trade-off, it is corruption.
    row "no-unicode" {
      priority 980
      when {
        all {
          message.unicode == true
          provider.supports_unicode == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send unicode text" attributes { code "NO_UNICODE" } } }
    }
    row "sender-country-not-supported" {
      priority 970
      when {
        all {
          provider.sender_countries != ""
          message.sender_country != ""
          not {
            contains(provider.sender_countries, "|" + message.sender_country + "|")
          }
        }
      }
      then { outcome { decision deny reason "the provider cannot send from a number registered in the sender's country" attributes { code "SENDER_COUNTRY" } } }
    }

    # ---- An operator's rule names this provider for this message -----------
    # It is admitted even when it is assigned to other accounts or owned by one,
    # and it goes to the top of the chain. The limits above still apply, and so
    # does the countries the provider serves.
    row "granted-by-a-routing-rule" {
      priority 950
      when {
        all {
          provider.granted == true
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "rule" } } }
    }

    # ---- Limits an operator may overrule ----------------------------------
    row "no-alpha-sender" {
      priority 940
      when {
        all {
          message.sender_kind == "alpha"
          provider.supports_alpha == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send from an alphanumeric sender id" attributes { code "NO_ALPHA_SENDER" } } }
    }
    row "no-long-messages" {
      priority 930
      when {
        all {
          message.segments > 1
          provider.supports_long == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send multi-segment messages" attributes { code "NO_LONG_SMS" } } }
    }
    row "message-type-not-carried" {
      priority 920
      when {
        all {
          provider.message_types != ""
          not {
            contains(provider.message_types, "|" + message.type + "|")
          }
        }
      }
      then { outcome { decision deny reason "the provider does not carry this message type" attributes { code "TYPE_NOT_CARRIED" } } }
    }
    # An OTP is not worth sending through a provider that drops messages.
    row "otp-quality-floor" {
      priority 910
      when {
        all {
          message.type == "otp"
          provider.quality < 85
        }
      }
      then { outcome { decision deny reason "an OTP needs a provider of quality 85 or better" attributes { code "QUALITY_FLOOR" } } }
    }
    row "a-private-provider-of-someone-else" {
      priority 900
      when {
        all {
          provider.owner != ""
          provider.owner != user.id
        }
      }
      then { outcome { decision deny reason "the provider belongs to another account" attributes { code "NOT_YOURS" } } }
    }

    # ---- Tiers a usable provider can belong to, best first --------------------
    # The tier is a class of provider. The ranking below turns it into a score,
    # which is where the order is decided. `reserves` is the stronger statement:
    # the message belongs to that provider, so the engine drops every other
    # candidate whatever its score — a filter on identity, not a ranking.
    #
    # A provider the account owns is the only one it uses.
    row "owned-by-the-account" {
      priority 800
      when { provider.owner == user.id }
      then { outcome { decision allow attributes { tier "user" priority 100000 reserves true } } }
    }
    # Assigned to this account, for the destination.
    row "assigned-to-the-account" {
      priority 790
      when {
        all {
          contains(provider.users, "|" + user.id + "|")
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "user" priority 90000 } } }
    }
    # Assigned to the account's tenant, for the destination.
    row "assigned-to-the-tenant" {
      priority 780
      when {
        all {
          contains(provider.tenants, "|" + user.tenant + "|")
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "tenant" priority 70000 } } }
    }
    # A route bought for one operator's number range.
    row "operator-range" {
      priority 770
      when {
        all {
          provider.assigned_only == 0
          provider.prefix_pattern != ""
          message.to matches provider.prefix_pattern
        }
      }
      then { outcome { decision allow attributes { tier "operator" priority 60000 } } }
    }
    row "serves-the-country" {
      priority 760
      when {
        all {
          provider.assigned_only == 0
          provider.prefix_pattern == ""
          provider.countries != ""
          contains(provider.countries, "|" + message.country + "|")
        }
      }
      then { outcome { decision allow attributes { tier "country" priority 50000 } } }
    }
    # Last resort for any destination.
    row "catch-all" {
      priority 750
      when {
        all {
          provider.assigned_only == 0
          provider.countries == ""
        }
      }
      then { outcome { decision allow attributes { tier "platform" priority 10000 } } }
    }
    # Nothing above makes the provider usable for this account and destination.
    row "not-available-here" {
      priority 1
      when { provider.id != "" }
      then { outcome { decision deny reason "no routing rule makes this provider available to this account for this destination" attributes { code "NOT_AVAILABLE" } } }
    }
  }

  # What a message is routed for. An account's objective (users.objective) is
  # read first; it is one of exactly these words, validated on the way in:
  # lowest_cost, highest_delivery, balanced.
  decision_schema "route_objective" { effects [allow] default allow strategy first_match }
  decision_table "route_objective" {
    default allow
    hit_policy first

    row "account-prefers-cost" {
      priority 100
      when { user.objective == "lowest_cost" }
      then { outcome { decision allow attributes { ranking "route_cost" } } }
    }
    row "account-prefers-delivery" {
      priority 90
      when { user.objective == "highest_delivery" }
      then { outcome { decision allow attributes { ranking "route_delivery" } } }
    }
    row "account-prefers-balanced" {
      priority 85
      when { user.objective == "balanced" }
      then { outcome { decision allow attributes { ranking "route_balanced" } } }
    }
    row "otp-wants-delivery" {
      priority 80
      when { message.type == "otp" }
      then { outcome { decision allow attributes { ranking "route_delivery" } } }
    }
    row "promotion-wants-price" {
      priority 70
      when { message.type == "promotional" }
      then { outcome { decision allow attributes { ranking "route_cost" } } }
    }
    row "everything-else" {
      priority 10
      when { message.type != "" }
      then { outcome { decision allow attributes { ranking "route_balanced" } } }
    }
  }

  # ---- Rankings: what is ordered, and in what order --------------------------
  # The RANK half, and it runs only on candidates the filter above kept.
  #
  # A candidate's score is its tier's priority (priority_path) plus, for each
  # score block, weight * clamp((metric - min) / (max - min), 0, 1): the weight is
  # what the metric is worth at its best, in the same units for every metric. The
  # tier priorities are 10000 apart, so the metrics only order candidates within
  # a tier: 400 + 100 + 150 + 50 can never lift one over the next tier. Observed
  # failures cost points.
  #
  # These scores order. They cannot exclude: a provider the filter kept is in the
  # chain however badly it scores, as a fall-back behind the ones that scored well.
  # That is the whole division of labour — the filter asks "may this provider
  # carry this message", the ranking asks "which first".
  #
  # Nothing here reads the request's dlr either, so two messages that differ only
  # in whether they asked for a receipt get the same chain.
  #
  # One weight is small on purpose: price_known (30) breaks an exact tie towards
  # the provider whose cost is actually on file, rather than towards one that is
  # cheap only because nobody has priced it.

  decision_schema "route_delivery" { effects [allow] default allow strategy first_match }
  ranking "route_delivery" {
    selection best
    priority_path "provider.priority"
    score "delivery-rate" { metric "provider.delivery_rate" weight 400 normalize [0.8, 1] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "consecutive-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
    score "failure-rate" { metric "provider.failure_rate" weight -100 normalize [0, 0.5] }
    score "cost" { metric "provider.cost_per_segment" weight -50 normalize [0, 0.2] }
    score "priced" { metric "provider.price_known" weight 30 normalize [0, 1] }
  }

  decision_schema "route_cost" { effects [allow] default allow strategy first_match }
  ranking "route_cost" {
    selection best
    priority_path "provider.priority"
    score "cost" { metric "provider.cost_per_segment" weight -2000 normalize [0, 0.2] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "consecutive-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
    # Cheapest first must still mean delivered first: a carrier that drops half
    # its traffic is not cheap, it is free and useless.
    score "delivery-rate" { metric "provider.delivery_rate" weight 120 normalize [0.8, 1] }
    score "failure-rate" { metric "provider.failure_rate" weight -120 normalize [0, 0.5] }
    score "priced" { metric "provider.price_known" weight 30 normalize [0, 1] }
  }

  decision_schema "route_balanced" { effects [allow] default allow strategy first_match }
  ranking "route_balanced" {
    selection best
    priority_path "provider.priority"
    score "delivery-rate" { metric "provider.delivery_rate" weight 200 normalize [0.8, 1] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "cost" { metric "provider.cost_per_segment" weight -150 normalize [0, 0.2] }
    score "consecutive-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
    score "failure-rate" { metric "provider.failure_rate" weight -150 normalize [0, 0.5] }
    score "priced" { metric "provider.price_known" weight 30 normalize [0, 1] }
  }
}
