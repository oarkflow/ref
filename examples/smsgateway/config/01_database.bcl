# ---------------------------------------------------------------------------
# Storage. Accounts, the ledger, messages and provider health live in one
# database, so a payment and the state change it belongs to commit together.
# SQLite (one connection) and PostgreSQL both work.
#
# Money is held in micros of the platform currency (1 unit = 1,000,000).
# ---------------------------------------------------------------------------

resource "db" {
  kind "database.sql"
  description "Accounts, ledger, messages, provider catalog and health"
  config {
    driver env("SMS_DB_DRIVER", "sqlite")
    dsn env("SMS_DSN", "file:.data/sms.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)")
    max_open_connections env("SMS_DB_CONNECTIONS", "1")
    ping true
    migrations [
      "CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, tenant TEXT NOT NULL, name TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'active', api_key_hash TEXT NOT NULL DEFAULT '', email TEXT NOT NULL DEFAULT '', password_hash TEXT NOT NULL DEFAULT '', roles TEXT NOT NULL DEFAULT 'sender', default_sender TEXT NOT NULL DEFAULT '', senders TEXT NOT NULL DEFAULT '', countries TEXT NOT NULL DEFAULT '', rate_per_second INTEGER NOT NULL DEFAULT 0, daily_limit INTEGER NOT NULL DEFAULT 0, max_price DOUBLE PRECISION NOT NULL DEFAULT 0, objective TEXT NOT NULL DEFAULT '', plan TEXT NOT NULL DEFAULT '', created_ms BIGINT NOT NULL DEFAULT 0)",
      "CREATE INDEX IF NOT EXISTS users_key ON users(api_key_hash)",
      "CREATE INDEX IF NOT EXISTS users_email ON users(email)",
      "CREATE TABLE IF NOT EXISTS balances (user_id TEXT PRIMARY KEY, balance BIGINT NOT NULL DEFAULT 0, held BIGINT NOT NULL DEFAULT 0)",
      "CREATE TABLE IF NOT EXISTS holds (message_id TEXT PRIMARY KEY, user_id TEXT NOT NULL, amount BIGINT NOT NULL, state TEXT NOT NULL, updated_ms BIGINT NOT NULL)",
      "CREATE TABLE IF NOT EXISTS ledger (message_id TEXT NOT NULL, kind TEXT NOT NULL, user_id TEXT NOT NULL, amount BIGINT NOT NULL, at_ms BIGINT NOT NULL, PRIMARY KEY (message_id, kind))",
      "CREATE INDEX IF NOT EXISTS ledger_user ON ledger(user_id, at_ms)",
      "CREATE TABLE IF NOT EXISTS topups (ref TEXT PRIMARY KEY, user_id TEXT NOT NULL, amount BIGINT NOT NULL, at_ms BIGINT NOT NULL)",
      "CREATE TABLE IF NOT EXISTS messages (id TEXT PRIMARY KEY, user_id TEXT NOT NULL, tenant TEXT NOT NULL, idem_key TEXT, payload_hash TEXT NOT NULL DEFAULT '', state TEXT NOT NULL, provider TEXT NOT NULL DEFAULT '', provider_msg_id TEXT NOT NULL DEFAULT '', plan TEXT NOT NULL DEFAULT '[]', plan_index INTEGER NOT NULL DEFAULT 0, attempt INTEGER NOT NULL DEFAULT 0, total_attempts INTEGER NOT NULL DEFAULT 0, dispatch_seq BIGINT NOT NULL DEFAULT 1, next_run_ms BIGINT NOT NULL DEFAULT 0, claim_until_ms BIGINT NOT NULL DEFAULT 0, to_number TEXT NOT NULL, country TEXT NOT NULL, sender TEXT NOT NULL, msg_type TEXT NOT NULL, segments INTEGER NOT NULL, encoding TEXT NOT NULL DEFAULT '', want_dlr INTEGER NOT NULL DEFAULT 1, body TEXT NOT NULL DEFAULT '', price BIGINT NOT NULL DEFAULT 0, cost BIGINT NOT NULL DEFAULT 0, currency TEXT NOT NULL, err_code TEXT NOT NULL DEFAULT '', err_text TEXT NOT NULL DEFAULT '', created_ms BIGINT NOT NULL, updated_ms BIGINT NOT NULL, submitted_ms BIGINT NOT NULL DEFAULT 0, delivered_ms BIGINT NOT NULL DEFAULT 0, expires_ms BIGINT NOT NULL DEFAULT 0)",
      "CREATE UNIQUE INDEX IF NOT EXISTS messages_idem ON messages(user_id, idem_key)",
      "CREATE INDEX IF NOT EXISTS messages_provider ON messages(provider, provider_msg_id)",
      "CREATE INDEX IF NOT EXISTS messages_state ON messages(state, next_run_ms)",
      "CREATE INDEX IF NOT EXISTS messages_user ON messages(user_id, created_ms)",
      "CREATE TABLE IF NOT EXISTS attempts (message_id TEXT NOT NULL, n INTEGER NOT NULL, provider TEXT NOT NULL, outcome TEXT NOT NULL, code TEXT NOT NULL DEFAULT '', err_text TEXT NOT NULL DEFAULT '', latency_ms BIGINT NOT NULL DEFAULT 0, at_ms BIGINT NOT NULL, PRIMARY KEY (message_id, n))",
      "CREATE TABLE IF NOT EXISTS campaigns (id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL, state TEXT NOT NULL, text TEXT NOT NULL DEFAULT '', template TEXT NOT NULL DEFAULT '', vars TEXT NOT NULL DEFAULT '{}', sender TEXT NOT NULL DEFAULT '', msg_type TEXT NOT NULL DEFAULT '', total INTEGER NOT NULL, valid INTEGER NOT NULL DEFAULT 0, skipped INTEGER NOT NULL DEFAULT 0, source TEXT NOT NULL DEFAULT 'list', phone_field TEXT NOT NULL DEFAULT 'phone', region TEXT NOT NULL DEFAULT 'NP', audience_id TEXT NOT NULL DEFAULT '', sent INTEGER NOT NULL DEFAULT 0, failed INTEGER NOT NULL DEFAULT 0, run_id TEXT NOT NULL DEFAULT '', decided_by TEXT NOT NULL DEFAULT '', note TEXT NOT NULL DEFAULT '', created_ms BIGINT NOT NULL, updated_ms BIGINT NOT NULL)",
      "CREATE INDEX IF NOT EXISTS campaigns_user ON campaigns(user_id, created_ms)",
      "CREATE TABLE IF NOT EXISTS campaign_recipients (campaign_id TEXT NOT NULL, n INTEGER NOT NULL, to_number TEXT NOT NULL, e164 TEXT NOT NULL DEFAULT '', state TEXT NOT NULL DEFAULT 'pending', reason TEXT NOT NULL DEFAULT '', fields TEXT NOT NULL DEFAULT '{}', message_id TEXT NOT NULL DEFAULT '', PRIMARY KEY (campaign_id, n))",
      "CREATE TABLE IF NOT EXISTS notifications (id TEXT PRIMARY KEY, user_id TEXT NOT NULL, kind TEXT NOT NULL, level TEXT NOT NULL DEFAULT 'info', title TEXT NOT NULL, body TEXT NOT NULL DEFAULT '', ref TEXT NOT NULL DEFAULT '', created_ms BIGINT NOT NULL, read_ms BIGINT NOT NULL DEFAULT 0)",
      "CREATE INDEX IF NOT EXISTS notifications_user ON notifications(user_id, created_ms)",
      "CREATE TABLE IF NOT EXISTS audiences (id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL, total INTEGER NOT NULL DEFAULT 0, valid INTEGER NOT NULL DEFAULT 0, skipped INTEGER NOT NULL DEFAULT 0, phone_field TEXT NOT NULL DEFAULT 'phone', region TEXT NOT NULL DEFAULT 'NP', created_ms BIGINT NOT NULL)",
      "CREATE INDEX IF NOT EXISTS audiences_user ON audiences(user_id, created_ms)",
      "CREATE TABLE IF NOT EXISTS audience_members (audience_id TEXT NOT NULL, n INTEGER NOT NULL, to_number TEXT NOT NULL, e164 TEXT NOT NULL DEFAULT '', state TEXT NOT NULL DEFAULT 'pending', reason TEXT NOT NULL DEFAULT '', fields TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (audience_id, n))",
      "CREATE TABLE IF NOT EXISTS message_templates (name TEXT NOT NULL, lang TEXT NOT NULL DEFAULT '', label TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', fields TEXT NOT NULL DEFAULT '[]', PRIMARY KEY (name, lang))",
      "CREATE TABLE IF NOT EXISTS routing_rules (id TEXT PRIMARY KEY, name TEXT NOT NULL, enabled INTEGER NOT NULL DEFAULT 1, account TEXT NOT NULL DEFAULT '', tenant TEXT NOT NULL DEFAULT '', countries TEXT NOT NULL DEFAULT '', recipient_prefix TEXT NOT NULL DEFAULT '', recipients TEXT NOT NULL DEFAULT '', templates TEXT NOT NULL DEFAULT '', recipient_pattern TEXT NOT NULL DEFAULT '', sender_pattern TEXT NOT NULL DEFAULT '', content_words TEXT NOT NULL DEFAULT '', content_pattern TEXT NOT NULL DEFAULT '', types TEXT NOT NULL DEFAULT '', min_segments INTEGER NOT NULL DEFAULT 0, max_segments INTEGER NOT NULL DEFAULT 0, mode TEXT NOT NULL DEFAULT 'use', provider TEXT NOT NULL, priority INTEGER NOT NULL DEFAULT 0, note TEXT NOT NULL DEFAULT '', updated_ms BIGINT NOT NULL DEFAULT 0)",
      "CREATE INDEX IF NOT EXISTS routing_rules_account ON routing_rules(account)",
      "CREATE TABLE IF NOT EXISTS routing_published (name TEXT PRIMARY KEY, fingerprint TEXT NOT NULL, source TEXT NOT NULL, rule_count INTEGER NOT NULL DEFAULT 0, at_ms BIGINT NOT NULL DEFAULT 0)",
      "CREATE TABLE IF NOT EXISTS optouts (scope TEXT NOT NULL, number TEXT NOT NULL, reason TEXT NOT NULL DEFAULT '', at_ms BIGINT NOT NULL, PRIMARY KEY (scope, number))",
      "CREATE TABLE IF NOT EXISTS providers (id TEXT PRIMARY KEY, kind TEXT NOT NULL, channel TEXT NOT NULL DEFAULT '', settings TEXT NOT NULL DEFAULT '{}', sandbox INTEGER NOT NULL DEFAULT 1, state TEXT NOT NULL DEFAULT 'active', quality DOUBLE PRECISION NOT NULL DEFAULT 80, delivery_rate DOUBLE PRECISION NOT NULL DEFAULT 0.95, countries TEXT NOT NULL DEFAULT '', message_types TEXT NOT NULL DEFAULT '', owner TEXT NOT NULL DEFAULT '', tenants TEXT NOT NULL DEFAULT '', users TEXT NOT NULL DEFAULT '', assigned_only INTEGER NOT NULL DEFAULT 0, supports_unicode INTEGER NOT NULL DEFAULT 1, supports_dlr INTEGER NOT NULL DEFAULT 1, supports_alpha INTEGER NOT NULL DEFAULT 1, supports_long INTEGER NOT NULL DEFAULT 1, sender_countries TEXT NOT NULL DEFAULT '', prefix_pattern TEXT NOT NULL DEFAULT '', max_attempts INTEGER NOT NULL DEFAULT 3, backoff_initial_s DOUBLE PRECISION NOT NULL DEFAULT 1, backoff_max_s DOUBLE PRECISION NOT NULL DEFAULT 60, backoff_factor DOUBLE PRECISION NOT NULL DEFAULT 2, description TEXT NOT NULL DEFAULT '')",
      "CREATE TABLE IF NOT EXISTS channels (name TEXT PRIMARY KEY, kind TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', credential_fields TEXT NOT NULL DEFAULT '[]', setting_fields TEXT NOT NULL DEFAULT '[]', sandbox INTEGER NOT NULL DEFAULT 0)",
      "CREATE TABLE IF NOT EXISTS provider_accounts (provider TEXT NOT NULL, name TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'active', public TEXT NOT NULL DEFAULT '{}', secret TEXT NOT NULL DEFAULT '', note TEXT NOT NULL DEFAULT '', used BIGINT NOT NULL DEFAULT 0, failures BIGINT NOT NULL DEFAULT 0, last_used_ms BIGINT NOT NULL DEFAULT 0, cooldown_until_ms BIGINT NOT NULL DEFAULT 0, PRIMARY KEY (provider, name))",
      "CREATE TABLE IF NOT EXISTS provider_costs (provider TEXT NOT NULL, country TEXT NOT NULL, per_segment DOUBLE PRECISION NOT NULL, PRIMARY KEY (provider, country))",
      "CREATE TABLE IF NOT EXISTS provider_health (provider TEXT NOT NULL, route TEXT NOT NULL, successes BIGINT NOT NULL DEFAULT 0, failures BIGINT NOT NULL DEFAULT 0, consecutive_failures BIGINT NOT NULL DEFAULT 0, open_until_ms BIGINT NOT NULL DEFAULT 0, latency_ms BIGINT NOT NULL DEFAULT 0, updated_ms BIGINT NOT NULL DEFAULT 0, PRIMARY KEY (provider, route))",

      # ---- Providers: what the routing rules read. Connectivity (hosts, binds, secrets) is in 02_resources.bcl.
      "INSERT INTO providers (id, kind, channel, quality, delivery_rate, countries, max_attempts, backoff_initial_s, backoff_max_s, backoff_factor, description) VALUES ('np_telecom', 'smpp', 'np_telecom', 92, 0.97, '|NP|', 3, 1, 15, 2, 'Primary Nepal route over SMPP') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO providers (id, kind, channel, quality, delivery_rate, countries, tenants, assigned_only, max_attempts, backoff_initial_s, backoff_max_s, backoff_factor, description) VALUES ('premium_np', 'http', 'premium_np', 98, 0.995, '|NP|', '|acme|', 1, 2, 0.5, 5, 2, 'Premium Nepal route, sold to one tenant') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO providers (id, kind, channel, quality, delivery_rate, countries, users, assigned_only, max_attempts, backoff_initial_s, backoff_max_s, backoff_factor, description) VALUES ('in_vendor', 'http', 'in_vendor', 88, 0.95, '|IN|', '|acme_alice|', 1, 4, 1, 20, 2, 'India route, assigned to one account') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO providers (id, kind, channel, quality, delivery_rate, countries, max_attempts, backoff_initial_s, backoff_max_s, backoff_factor, description) VALUES ('global_fallback', 'http', 'global_fallback', 70, 0.9, '', 3, 1, 10, 2, 'Catch-all for every other country') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO providers (id, kind, channel, quality, delivery_rate, countries, users, assigned_only, supports_dlr, max_attempts, backoff_initial_s, backoff_max_s, backoff_factor, description) VALUES ('smspasal', 'http', 'smspasal', 90, 0.95, '|NP|', '|smspasal_live|', 1, 0, 2, 1, 10, 2, 'SMSPasal HTTP API (text, GET/POST). Assigned to the smspasal_live account.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO channels (name, kind, description, credential_fields, setting_fields, sandbox) VALUES ('np_telecom', 'smpp', 'SMPP bind to the Nepal carrier', '[{\"name\":\"system_id\",\"label\":\"System id\",\"secret\":false},{\"name\":\"password\",\"label\":\"Password\",\"secret\":true}]', '[{\"name\":\"from_override\",\"label\":\"Sender id\",\"kind\":\"text\",\"hint\":\"Sent as the sender of every message through this provider (an id the provider has approved). Empty: the sender given with the message\"}]', 1) ON CONFLICT (name) DO NOTHING",
      "INSERT INTO channels (name, kind, description, credential_fields, setting_fields, sandbox) VALUES ('premium_np', 'http', 'Premium Nepal vendor, JSON API', '[{\"name\":\"token\",\"label\":\"API token\",\"secret\":true}]', '[{\"name\":\"endpoint\",\"label\":\"Endpoint\",\"kind\":\"text\",\"default\":\"/send\",\"required\":true,\"hint\":\"Path (or full URL) called for each message, relative to the channel address\"},{\"name\":\"from_override\",\"label\":\"Sender id\",\"kind\":\"text\",\"hint\":\"Sent as the sender of every message through this provider (an id the provider has approved). Empty: the sender given with the message\"}]', 1) ON CONFLICT (name) DO NOTHING",
      "INSERT INTO channels (name, kind, description, credential_fields, setting_fields, sandbox) VALUES ('in_vendor', 'http', 'India vendor, JSON API', '[{\"name\":\"token\",\"label\":\"API token\",\"secret\":true}]', '[{\"name\":\"endpoint\",\"label\":\"Endpoint\",\"kind\":\"text\",\"default\":\"/send\",\"required\":true,\"hint\":\"Path (or full URL) called for each message, relative to the channel address\"},{\"name\":\"from_override\",\"label\":\"Sender id\",\"kind\":\"text\",\"hint\":\"Sent as the sender of every message through this provider (an id the provider has approved). Empty: the sender given with the message\"}]', 1) ON CONFLICT (name) DO NOTHING",
      "INSERT INTO channels (name, kind, description, credential_fields, setting_fields, sandbox) VALUES ('global_fallback', 'http', 'Catch-all vendor, JSON API', '[{\"name\":\"token\",\"label\":\"API token\",\"secret\":true}]', '[{\"name\":\"endpoint\",\"label\":\"Endpoint\",\"kind\":\"text\",\"default\":\"/send\",\"required\":true,\"hint\":\"Path (or full URL) called for each message, relative to the channel address\"},{\"name\":\"from_override\",\"label\":\"Sender id\",\"kind\":\"text\",\"hint\":\"Sent as the sender of every message through this provider (an id the provider has approved). Empty: the sender given with the message\"}]', 1) ON CONFLICT (name) DO NOTHING",
      "INSERT INTO channels (name, kind, description, credential_fields, setting_fields, sandbox) VALUES ('smspasal', 'http', 'SMSPasal text API (GET)', '[{\"name\":\"key\",\"label\":\"API key\",\"secret\":true},{\"name\":\"routeid\",\"label\":\"Route id\",\"secret\":false},{\"name\":\"campaign\",\"label\":\"Campaign id\",\"secret\":false}]', '[{\"name\":\"url\",\"label\":\"API URL\",\"kind\":\"url\",\"required\":true,\"hint\":\"https://sms.smspasal.com/smsapi/index.php for the real service\"},{\"name\":\"from_override\",\"label\":\"Sender id\",\"kind\":\"text\",\"hint\":\"Sent as the sender of every message through this provider (an id the provider has approved). Empty: the sender given with the message\"}]', 1) ON CONFLICT (name) DO NOTHING",
      "INSERT INTO provider_costs (provider, country, per_segment) VALUES ('smspasal', '*', 0.012) ON CONFLICT (provider, country) DO NOTHING",
      "INSERT INTO provider_costs (provider, country, per_segment) VALUES ('np_telecom', '*', 0.011) ON CONFLICT (provider, country) DO NOTHING",
      "INSERT INTO provider_costs (provider, country, per_segment) VALUES ('premium_np', '*', 0.018) ON CONFLICT (provider, country) DO NOTHING",
      "INSERT INTO provider_costs (provider, country, per_segment) VALUES ('in_vendor', '*', 0.004) ON CONFLICT (provider, country) DO NOTHING",
      "INSERT INTO provider_costs (provider, country, per_segment) VALUES ('global_fallback', '*', 0.030) ON CONFLICT (provider, country) DO NOTHING",

      "INSERT INTO message_templates (name, lang, label, description, fields) VALUES ('otp_login', '', 'One-time login code', 'OTP for signing in (English)', '[{\"name\":\"brand\",\"label\":\"Brand\",\"default\":\"Acme\",\"hint\":\"Who the code is from\"},{\"name\":\"code\",\"label\":\"Code\",\"default\":\"\",\"hint\":\"The one-time code\"},{\"name\":\"minutes\",\"label\":\"Minutes valid\",\"default\":\"5\",\"hint\":\"How long the code works\"}]') ON CONFLICT (name, lang) DO NOTHING",
      "INSERT INTO message_templates (name, lang, label, description, fields) VALUES ('otp_login', 'ne', 'One-time login code (Nepali)', 'OTP for signing in (Nepali, Unicode)', '[{\"name\":\"brand\",\"label\":\"Brand\",\"default\":\"Acme\",\"hint\":\"Who the code is from\"},{\"name\":\"code\",\"label\":\"Code\",\"default\":\"\",\"hint\":\"The one-time code\"},{\"name\":\"minutes\",\"label\":\"Minutes valid\",\"default\":\"5\",\"hint\":\"How long the code works\"}]') ON CONFLICT (name, lang) DO NOTHING",
      "INSERT INTO message_templates (name, lang, label, description, fields) VALUES ('payment_received', '', 'Payment received', 'Transactional receipt', '[{\"name\":\"currency\",\"label\":\"Currency\",\"default\":\"NPR\",\"hint\":\"\"},{\"name\":\"amount\",\"label\":\"Amount\",\"default\":\"\",\"hint\":\"e.g. 1,250.00\"},{\"name\":\"date\",\"label\":\"Date\",\"default\":\"\",\"hint\":\"e.g. 4 Oct 2026\"},{\"name\":\"receipt\",\"label\":\"Receipt number\",\"default\":\"\",\"hint\":\" \"}]') ON CONFLICT (name, lang) DO NOTHING",
      "INSERT INTO message_templates (name, lang, label, description, fields) VALUES ('spring_sale', '', 'Spring sale', 'Promotional message', '[{\"name\":\"discount\",\"label\":\"Discount %\",\"default\":\"10\",\"hint\":\"0 for no discount line\"},{\"name\":\"ends\",\"label\":\"Ends on\",\"default\":\"\",\"hint\":\"e.g. Sunday\"},{\"name\":\"url\",\"label\":\"Shop link\",\"default\":\"\",\"hint\":\"\"}]') ON CONFLICT (name, lang) DO NOTHING",

      "INSERT INTO provider_accounts (provider, name, public, secret, note) VALUES ('np_telecom', 'primary', '{\"system_id\":\"smsgw\"}', 'v1.k3V79Pu7bnVd8xFxu5IhWjKqmGjpsjQZg/RtX37mJHEUQOlugloMez06dosbckah0lM', 'Development sandbox credentials') ON CONFLICT (provider, name) DO NOTHING",
      "INSERT INTO provider_accounts (provider, name, public, secret, note) VALUES ('premium_np', 'primary', '{}', 'v1.HS82+sohf3WORCr/ZzOTP8l/ZC4vBgMOtyUr+PDolNn48dt1DbCjY8X4DBk/VlQPBckTKTc', 'Development sandbox credentials') ON CONFLICT (provider, name) DO NOTHING",
      "INSERT INTO provider_accounts (provider, name, public, secret, note) VALUES ('in_vendor', 'primary', '{}', 'v1.HS82+sohf3WORCr/ZzOTP8l/ZC4vBgMOtyUr+PDolNn48dt1DbCjY8X4DBk/VlQPBckTKTc', 'Development sandbox credentials') ON CONFLICT (provider, name) DO NOTHING",
      "INSERT INTO provider_accounts (provider, name, public, secret, note) VALUES ('global_fallback', 'primary', '{}', 'v1.HS82+sohf3WORCr/ZzOTP8l/ZC4vBgMOtyUr+PDolNn48dt1DbCjY8X4DBk/VlQPBckTKTc', 'Development sandbox credentials') ON CONFLICT (provider, name) DO NOTHING",
      "INSERT INTO provider_accounts (provider, name, public, secret, note) VALUES ('smspasal', 'primary', '{\"routeid\":\"10259\",\"campaign\":\"9801\"}', 'v1./UBZmzedDdSrOtPrHwWJnu228HW17AfHppgy5mPypmBfErv+g1XFFAQ8Ksq34WQjmO2A', 'Development sandbox credentials') ON CONFLICT (provider, name) DO NOTHING",

      "UPDATE providers SET settings = '{\"url\":\"http://127.0.0.1:9100/smsapi/index.php\"}' WHERE id = 'smspasal' AND settings = '{}'",
      "UPDATE providers SET settings = '{\"endpoint\":\"/send\"}' WHERE id IN ('premium_np', 'in_vendor', 'global_fallback') AND settings = '{}'",

      # ---- Example routing rules (Admin > Rules). The enabled ones are also in rules/custom_routing.bcl,
      # the definition generated from them, so a fresh start already applies them.
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_demo_live_number', 'Demo: my test number goes out through the live SMSPasal', 1, 'demo', '', '', '9779856034616', '', '', '', 0, 'use', 'smspasal_real', 70, 'Matches the number however it is written: +977 9856034616, 009779856034616, 9779856034616 or 9856034616.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_demo_login_code_sandbox', 'Demo: the login code template uses the sandbox carrier', 1, 'demo', '', '', '', 'otp_login', '', '', 0, 'use', 'np_telecom', 60, 'Messages sent with the otp_login template.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_promo_never_live', 'Never send promotional messages over the live SMSPasal', 1, '', '', '', '', '', '', 'promotional', 0, 'avoid', 'smspasal_real', 90, 'A safety rule for the live provider.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_acme_receipts_premium', 'ACME: payment receipts over the premium route', 0, '', 'acme', '', '', 'payment_received', '', '', 0, 'use', 'premium_np', 55, 'Switched off: an example of a tenant plus a template.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_long_messages', 'Long messages (3 or more segments) over np_telecom', 0, '', '', '', '', '', '', '', 3, 'use', 'np_telecom', 5, 'Switched off: an example of a size based rule.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_india_vendor', 'India numbers over in_vendor', 0, '', '', 'IN', '', '', '', '', 0, 'use', 'in_vendor', 10, 'Switched off: an example of a country rule that admits a provider assigned to one account.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_demo_invoices', 'Demo: invoice texts over np_telecom', 0, 'demo', '', '', '', '', 'invoice', '', 0, 'use', 'np_telecom', 60, 'Switched off: an example of a content rule for one account.') ON CONFLICT (id) DO NOTHING",
      "INSERT INTO routing_rules (id, name, enabled, account, tenant, countries, recipients, templates, content_words, types, min_segments, mode, provider, priority, note) VALUES ('rr_example_otp_text_only_np', 'OTP texts only over np_telecom', 0, '', '', '', '', '', 'otp|verification code', '', 0, 'only', 'np_telecom', 20, 'Switched off: an example of an exclusive content rule.') ON CONFLICT (id) DO NOTHING",

      # ---- Accounts. Issue an API key with POST /v1/admin/users/{id}/key.
      # Console logins (development passwords: operator-pass-123 and demo-pass-123).
      # Set a password with POST /v1/admin/users/{id}/password.
      "INSERT INTO users (id, tenant, name, email, password_hash, roles, created_ms) VALUES ('operator', 'platform', 'Operator', 'operator@example.com', '$argon2id$v=19$m=65536,t=3,p=4$AE/K2AxIJcmNszHWCLOrkw$KVGCjD72y/oIcHKx20117cQRpp7FUjBDrM5jCEguNaY', 'admin', 0) ON CONFLICT (id) DO NOTHING",
      "INSERT INTO users (id, tenant, name, default_sender, email, password_hash, created_ms) VALUES ('demo', 'demo', 'Demo account', 'DEMO', 'demo@example.com', '$argon2id$v=19$m=65536,t=3,p=4$eDD0luSHIcwokQnO0Gza9Q$S2pJcg0R2LeH6eSFPa0vlZYZjSvsZ34k8iBLQ0Qf5vg', 0) ON CONFLICT (id) DO NOTHING",
      "INSERT INTO users (id, tenant, name, created_ms) VALUES ('acme_alice', 'acme', 'Alice (ACME)', 0) ON CONFLICT (id) DO NOTHING",
      "INSERT INTO users (id, tenant, name, created_ms) VALUES ('acme_bob', 'acme', 'Bob (ACME)', 0) ON CONFLICT (id) DO NOTHING",
      "INSERT INTO users (id, tenant, name, default_sender, created_ms) VALUES ('smspasal_live', 'live', 'SMSPasal live test account', 'SMSPasal', 0) ON CONFLICT (id) DO NOTHING",
      "INSERT INTO balances (user_id, balance, held) VALUES ('smspasal_live', 1000000, 0) ON CONFLICT (user_id) DO NOTHING",
      "INSERT INTO balances (user_id, balance, held) VALUES ('demo', 25000000, 0) ON CONFLICT (user_id) DO NOTHING",
      "INSERT INTO balances (user_id, balance, held) VALUES ('acme_alice', 10000000, 0) ON CONFLICT (user_id) DO NOTHING",
      "INSERT INTO balances (user_id, balance, held) VALUES ('acme_bob', 10000000, 0) ON CONFLICT (user_id) DO NOTHING"
    ]
  }
}
