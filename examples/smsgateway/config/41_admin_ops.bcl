# ---------------------------------------------------------------------------
# Operator views over providers, messages and traffic, and the controls that
# change routing without a deploy.
# ---------------------------------------------------------------------------

intent "admin.providers.list" {
  response "rows"
  node "rows" {
    uses "database.query" resource "db" kind read provides [rows]
    config {
      statement "SELECT p.*, COALESCE(SUM(h.successes), 0) AS successes, COALESCE(SUM(h.failures), 0) AS failures, COALESCE(MAX(h.open_until_ms), 0) AS open_until_ms FROM providers p LEFT JOIN provider_health h ON h.provider = p.id GROUP BY p.id ORDER BY p.id"
    }
  }
}
route "admin.providers.list" { method GET path "/v1/admin/providers" intent "admin.providers.list" auth "admin_auth" cache_control "no-store" }

intent "admin.providers.state" {
  response "result"
  input_schema "provider_state"
  node "id" { uses "request.param" kind pure provides [id] config { name "id" } }
  node "changed" {
    uses "database.transaction" resource "db" kind effect requires [id, input] provides [changed]
    config { statements [ { name "set" sql "UPDATE providers SET state = $1 WHERE id = $2" args [input.state, id] require_affected true failure { code "NOT_FOUND" status 404 message "no such provider" } } ] }
  }
  node "result" { uses "data.transform" kind pure requires [id, input, changed] provides [result] config { data { extract { id "id" state "input.state" } pick ["id", "state"] } } }
}
route "admin.providers.state" { method PUT path "/v1/admin/providers/:id/state" intent "admin.providers.state" auth "admin_auth" cache_control "no-store" }

intent "admin.messages.list" {
  response "rows"
  node "state" { uses "request.param" kind pure provides [state] config { name "state" from "query" required false default "" } }
  node "rows" {
    uses "database.query" resource "db" kind read requires [state] provides [rows]
    config {
      statement "SELECT id, user_id, state, provider, to_number AS \"to\", country, msg_type AS type, segments, price, err_code, total_attempts, created_ms FROM messages WHERE ($1 = '' OR state = $1) ORDER BY created_ms DESC LIMIT 200"
      args [state]
    }
  }
}
route "admin.messages.list" { method GET path "/v1/admin/messages" intent "admin.messages.list" auth "admin_auth" cache_control "no-store" }

# One message in full, for an operator: which carrier carried it, every attempt
# with the carrier's own wording, and the state of the plan. This is where the
# detail that an account is not shown lives — /v1/messages/{id} answers the same
# question in the account's vocabulary and names no carrier.
intent "admin.messages.get" {
  description "One message with its carriers and every attempt"
  response "result"
  node "id" { uses "request.param" kind pure provides [id] config { name "id" } }
  node "rows" {
    uses "database.query" resource "db" kind read requires [id] provides [rows]
    config {
      statement "SELECT id, user_id, state, provider, provider_msg_id, plan, plan_index, to_number AS \"to\", country, sender AS \"from\", msg_type AS type, segments, encoding, want_dlr, price, cost, currency, err_code, err_text, attempt, total_attempts, created_ms, submitted_ms, delivered_ms FROM messages WHERE id = $1"
      args [id] require_rows true not_found_message "no such message"
    }
  }
  node "row" { uses "data.first" requires [rows] provides [row] config { source_fact "rows" } }
  node "tries" {
    uses "database.query" resource "db" kind read requires [row] provides [tries]
    config { statement "SELECT n, provider, outcome, code, err_text, latency_ms, at_ms FROM attempts WHERE message_id = $1 ORDER BY n" args [row.id] }
  }
  node "health" {
    uses "database.query" resource "db" kind read requires [row] provides [health]
    config { statement "SELECT h.route, h.successes, h.failures, h.consecutive_failures, h.open_until_ms FROM provider_health h WHERE h.provider = $1 ORDER BY h.route" args [row.provider] }
  }
  node "result" {
    uses "data.transform" kind pure requires [row, tries, health] provides [result]
    config { data { extract { message "row" attempts "tries" health "health" } pick ["message", "attempts", "health"] } }
  }
}
route "admin.messages.get" { method GET path "/v1/admin/messages/:id" intent "admin.messages.get" auth "admin_auth" cache_control "no-store" }

intent "admin.stats" {
  response "result"
  node "since" { uses "expression" kind pure provides [since] config { expression "unix_millis() - 86400000" } }
  node "by_state" {
    uses "database.query" resource "db" kind read provides [by_state]
    config { statement "SELECT state, COUNT(*) AS n FROM messages GROUP BY state ORDER BY state" }
  }
  node "by_provider" {
    uses "database.query" resource "db" kind read provides [by_provider]
    config { statement "SELECT provider, state, COUNT(*) AS n, COALESCE(SUM(cost), 0) AS cost FROM messages GROUP BY provider, state ORDER BY provider, state" }
  }
  node "money" {
    uses "database.query" resource "db" kind read provides [money]
    config { statement "SELECT COALESCE(SUM(balance), 0) AS balance, COALESCE(SUM(held), 0) AS held FROM balances" }
  }
  # Messages accepted in each of the last 24 hours (hour = whole hours since 1970).
  node "hourly" {
    uses "database.query" resource "db" kind read requires [since] provides [hourly]
    config { statement "SELECT created_ms / 3600000 AS hour, COUNT(*) AS n, SUM(CASE WHEN state = 'failed' THEN 1 ELSE 0 END) AS failed FROM messages WHERE created_ms >= $1 GROUP BY created_ms / 3600000 ORDER BY hour" args [since] }
  }
  node "day" {
    uses "database.query" resource "db" kind read requires [since] provides [day]
    config { statement "SELECT COUNT(*) AS total, COALESCE(SUM(CASE WHEN state = 'delivered' THEN 1 ELSE 0 END), 0) AS delivered, COALESCE(SUM(CASE WHEN state = 'failed' THEN 1 ELSE 0 END), 0) AS failed, COALESCE(SUM(price), 0) AS revenue FROM messages WHERE created_ms >= $1" args [since] }
  }
  node "people" {
    uses "database.query" resource "db" kind read provides [people]
    config { statement "SELECT COUNT(*) AS accounts FROM users" }
  }
  node "result" {
    uses "data.transform" kind pure requires [by_state, by_provider, money, hourly, day, people] provides [result]
    config { data { extract { states "by_state" providers "by_provider" money "money" hourly "hourly" day "day" accounts "people" } pick ["states", "providers", "money", "hourly", "day", "accounts"] } }
  }
}
route "admin.stats" { method GET path "/v1/admin/stats" intent "admin.stats" auth "admin_auth" cache_control "no-store" }

intent "admin.optouts.put" {
  response "result"
  input_schema "optout_put"
  node "row" {
    uses "data.transform" kind pure requires [input] provides [row]
    config { data { extract { scope "input.scope != nil ? input.scope : '*'" number "regex_replace(input.number, '[^0-9]', '')" reason "input.reason != nil ? input.reason : ''" now_ms "unix_millis()" } } }
  }
  node "saved" {
    uses "database.transaction" resource "db" kind effect requires [row] provides [saved]
    config { statements [ { name "put" sql "INSERT INTO optouts (scope, number, reason, at_ms) VALUES ($1, $2, $3, $4) ON CONFLICT (scope, number) DO UPDATE SET reason = excluded.reason" args [row.scope, row.number, row.reason, row.now_ms] } ] }
  }
  node "result" { uses "data.transform" kind pure requires [row, saved] provides [result] config { data { extract { scope "row.scope" number "row.number" } pick ["scope", "number"] } } }
}
route "admin.optouts.put" { method POST path "/v1/admin/optouts" intent "admin.optouts.put" auth "admin_auth" cache_control "no-store" }
