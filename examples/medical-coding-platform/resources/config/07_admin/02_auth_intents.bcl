intent "auth.login" {
  description "Authenticate user credentials with Argon2id and start session"
  response "response"
  input_schema "login_credentials"
  timeout 5s

  node "find_user" {
    uses "database.query"
    resource "database"
    kind read
    requires [input]
    provides [user_rows]
    config {
      statement "SELECT u.id, u.email, u.name, u.password_hash, u.roles, u.status, (SELECT group_concat(DISTINCT CASE WHEN m.work_item_id <> '*' THEN m.work_item_id WHEN m.facility_id <> '*' THEN m.facility_id ELSE m.company_id END) FROM v_membership_scope m WHERE m.user_id = u.id) AS org_units, (SELECT group_concat(DISTINCT CASE WHEN m.work_item_id <> '*' THEN m.work_item_id WHEN m.facility_id <> '*' THEN m.facility_id ELSE m.company_id END) FROM v_membership_scope m WHERE m.user_id = u.id AND m.role = 'admin') AS admin_units, (SELECT group_concat(DISTINCT CASE WHEN m.work_item_id <> '*' THEN m.work_item_id WHEN m.facility_id <> '*' THEN m.facility_id ELSE m.company_id END || ':' || m.role) FROM v_membership_scope m WHERE m.user_id = u.id) AS workspace_roles FROM users u WHERE u.email = LOWER($1) AND u.status = 'active' LIMIT 1"
      args ["input.email"]
      require_rows true
      not_found_message "invalid email or password"
    }
  }

  node "login" {
    uses "auth.login"
    resource "sessions"
    kind effect
    requires [input, user_rows]
    provides [principal]
    config {
      user_fact "user_rows"
      password_fact "input.password"
      password_field "password_hash"
      id_field "id"
      username_field "email"
      email_field "email"
      roles_field "roles"
      # Where the user works and administers, for workspace scoping.
      session_fields ["org_units", "admin_units", "workspace_roles"]
    }
  }

  node "response" {
    uses "collect"
    requires [principal]
    provides [response]
    config {
      success true
      user "principal"
    }
  }
}

intent "auth.me" {
  description "Get authenticated user profile"
  response "response"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "profile" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [profile_rows]
    config {
      statement "SELECT id, email, name, roles, status, avatar FROM users WHERE id = $1"
      args [user_id]
      require_rows true
      not_found_message "user not found"
    }
  }

  node "response" {
    uses "collect"
    requires [profile_rows]
    provides [response]
    config {
      user "profile_rows"
    }
  }
}

intent "auth.user_roles" {
  description "Get assigned roles by work item and entity for frontend permission checks"
  response "response"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "roles" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [roles]
    config {
      statement "SELECT m.work_item_id, m.company_id, m.role FROM memberships m WHERE m.user_id = $1"
      args [user_id]
    }
  }

  node "response" {
    uses "collect"
    requires [roles]
    provides [response]
  }
}

intent "auth.user_roles_by_id" {
  description "Get roles for a specific user ID"
  response "response"

  node "uid" {
    uses "request.param"
    provides [uid]
    config {
      name "user_id"
    }
  }

  node "roles" {
    uses "database.query"
    resource "database"
    kind read
    requires [uid]
    provides [roles]
    config {
      statement "SELECT m.work_item_id, m.company_id, m.role FROM memberships m WHERE m.user_id = $1"
      args [uid]
    }
  }

  node "response" {
    uses "collect"
    requires [roles]
    provides [response]
  }
}

intent "auth.user_info" {
  description "Get user profile and settings by user ID"
  response "response"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "profile" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [profile_rows]
    config {
      statement "SELECT id, email, name, roles, status, avatar FROM users WHERE id = $1"
      args [user_id]
      require_rows true
      not_found_message "user not found"
    }
  }

  node "response" {
    uses "collect"
    requires [profile_rows]
    provides [response]
    config {
      user "profile_rows"
    }
  }
}

intent "auth.logout" {
  description "Sign out user session"
  response "response"

  node "response" {
    uses "collect"
    provides [response]
    config {
      success true
      message "Logged out successfully"
    }
  }
}

intent "auth.login_info" {
  description "Get authentication endpoint metadata"
  response "response"

  node "response" {
    uses "collect"
    provides [response]
    config {
      service "CLEAR Medical Coding Platform"
      auth_types ["password", "session"]
    }
  }
}

