      statement "SELECT u.id, u.email, u.name, u.status FROM users u WHERE u.roles LIKE '%coder%' AND ($1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope t JOIN v_membership_scope a ON a.user_id = $2 AND a.role = 'admin' AND a.company_id = t.company_id AND a.facility_id IN ('*', t.facility_id) AND a.work_item_id IN ('*', t.work_item_id) WHERE t.user_id = u.id)) ORDER BY u.name ASC"
