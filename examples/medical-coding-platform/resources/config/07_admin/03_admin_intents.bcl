intent "admin.users_list" {
  description "List staff the caller administers (everyone for a global admin)"
  response "response"

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin') THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [is_global, caller_id, authorized]
    provides [users]
    config {
      statement "SELECT u.id, u.email, u.name, u.roles, u.status, u.created_at FROM users u WHERE $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope t JOIN v_membership_scope a ON a.user_id = $2 AND a.role = 'admin' AND a.company_id = t.company_id AND a.facility_id IN ('*', t.facility_id) AND a.work_item_id IN ('*', t.work_item_id) WHERE t.user_id = u.id) ORDER BY u.name ASC"
      args [is_global, caller_id]
    }
  }

  node "response" {
    uses "collect"
    requires [users]
    provides [response]
    config {
      data "users"
    }
  }
}

intent "admin.user_create" {
  description "Provision a user; a workspace admin creates them with the base role and grants workspace roles separately"
  response "response"
  input_schema "user_create_input"

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin') THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "id" {
    uses "expression"
    provides [user_id]
    config {
      expression "'usr_' + uuid()"
    }
  }

  node "hasher" {
    uses "auth.password_hash"
    requires [input]
    provides [pwd_hash]
    config {
      value_fact "input.password"
      algorithm "argon2id"
      memory 65536
      iterations 3
      parallelism 4
      min_length 8
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, pwd_hash, input, is_global, authorized]
    provides [saved]
    config {
      statement "INSERT INTO users (id, email, name, password_hash, roles, status, created_at, updated_at) VALUES ($1, LOWER($2), $3, $4, CASE WHEN $6 = 1 THEN $5 ELSE 'user' END, 'active', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
      args [user_id, input.email, input.name, pwd_hash, input.role, is_global]
    }
  }

  node "response" {
    uses "collect"
    requires [user_id, saved]
    provides [response]
    config {
      user_id "user_id"
      status "created"
    }
  }
}

intent "admin.rules" {
  description "Return application clinical and billing validation rules"
  response "response"

  node "rules" {
    uses "rules.catalog"
    resource "policy_engine"
    kind read
    provides [app_rules]
  }

  node "response" {
    uses "collect"
    requires [app_rules]
    provides [response]
    config {
      unwrap true
    }
  }
}

intent "admin.coders_list" {
  description "List medical coders the caller administers"
  response "response"

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin') THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [is_global, caller_id, authorized]
    provides [coders]
