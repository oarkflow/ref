}

intent "admin.user_update" {
  description "Update a user profile and status; workspace admins cannot change global administrators"
  response "response"

  node "id" {
    uses "request.param"
    provides [user_id]
    config {
      name "id"
    }
  }

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, user_id]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR (EXISTS (SELECT 1 FROM v_membership_scope t JOIN v_membership_scope a ON a.user_id = $2 AND a.role = 'admin' AND a.company_id = t.company_id AND a.facility_id IN ('*', t.facility_id) AND a.work_item_id IN ('*', t.work_item_id) WHERE t.user_id = $3) AND NOT EXISTS (SELECT 1 FROM users g WHERE g.id = $3 AND g.roles LIKE '%admin%')) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, user_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, input, authorized]
    provides [updated]
    config {
      statement "UPDATE users SET name = COALESCE($1, name), status = COALESCE($2, status), updated_at = CURRENT_TIMESTAMP WHERE id = $3"
      args [input.name, input.status, user_id]
      require_affected true
      not_found_message "user not found"
    }
  }

  node "response" {
    uses "collect"
    requires [updated]
    provides [response]
    config {
      status "updated"
    }
  }
}

intent "admin.change_password" {
  description "Change user password with Argon2id"
  response "response"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "hasher" {
    uses "auth.password_hash"
    requires [input]
    provides [pwd_hash]
    config {
      value_fact "input.password"
      algorithm "argon2id"
      memory 65536
      iterations 3
      parallelism 4
      min_length 8
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, pwd_hash]
    provides [updated]
    config {
      statement "UPDATE users SET password_hash = $1, updated_at = CURRENT_TIMESTAMP WHERE id = $2"
      args [pwd_hash, user_id]
    }
  }

  node "response" {
    uses "collect"
    requires [updated]
    provides [response]
    config {
      status "password_updated"
    }
  }
}

intent "admin.assign_roles" {
  description "Grant a role on a company, facility or work item the caller administers"
  response "response"
  input_schema "role_assign_input"

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, input]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN $6 = 'super_admin' THEN 0 WHEN NOT ((CASE WHEN $5 <> '*' THEN COALESCE((SELECT facility_id FROM work_items WHERE work_item_id = $5), '') ELSE $4 END) = '*' OR (SELECT client_id FROM facilities WHERE facility_id = (CASE WHEN $5 <> '*' THEN COALESCE((SELECT facility_id FROM work_items WHERE work_item_id = $5), '') ELSE $4 END)) = $3) THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = $3 AND a.facility_id IN ('*', (CASE WHEN $5 <> '*' THEN COALESCE((SELECT facility_id FROM work_items WHERE work_item_id = $5), '') ELSE $4 END)) AND a.work_item_id IN ('*', $5)) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, input.company_id, input.facility_id, input.work_item_id, input.role]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO memberships (user_id, company_id, work_item_id, role, created_at) VALUES ($1, $2, $3, $4, CURRENT_TIMESTAMP)"
      args [input.user_id, input.company_id, input.work_item_id, input.role]
    }
  }

  node "facility_scope" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [saved, input]
    provides [scoped]
    config {
      statement "INSERT INTO membership_scopes (membership_id, facility_id) SELECT MAX(id), $4 FROM memberships WHERE user_id = $1 AND company_id = $2 AND work_item_id = '*' AND role = $3 HAVING $5 = '*' AND $4 <> '*'"
      args [input.user_id, input.company_id, input.role, input.facility_id, input.work_item_id]
    }
  }

  node "response" {
    uses "collect"
    requires [saved, scoped]
    provides [response]
    config {
      status "role_assigned"
    }
  }
}

intent "admin.revoke_roles" {
  description "Revoke a role, only within workspaces the caller administers"
  response "response"
  input_schema "role_revoke_input"

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin') THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "delete" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input, is_global, caller_id, authorized]
    provides [deleted]
    config {
      statement "DELETE FROM memberships WHERE user_id = $1 AND role = $2 AND ($3 = 1 OR id IN (SELECT t.id FROM v_membership_scope t JOIN v_membership_scope a ON a.user_id = $4 AND a.role = 'admin' AND a.company_id = t.company_id AND a.facility_id IN ('*', t.facility_id) AND a.work_item_id IN ('*', t.work_item_id) WHERE t.user_id = $1 AND t.role = $2)) AND ($5 = '' OR company_id = $5) AND ($6 = '' OR work_item_id = $6)"
      args [input.user_id, input.role, is_global, caller_id, input.company_id, input.work_item_id]
    }
  }

  node "cleanup" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [deleted]
    provides [cleaned]
    config {
      statement "DELETE FROM membership_scopes WHERE membership_id NOT IN (SELECT id FROM memberships)"
    }
  }

  node "response" {
    uses "collect"
    requires [deleted, cleaned]
    provides [response]
    config {
      status "role_revoked"
    }
  }
}

