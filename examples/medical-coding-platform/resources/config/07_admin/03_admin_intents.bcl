    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [is_global, caller_id, authorized]
    provides [companies]
    config {
      statement "SELECT id, name, slug, status, created_at FROM companies WHERE status = 'active' AND ($1 = 1 OR id IN (SELECT company_id FROM v_membership_scope WHERE user_id = $2 AND role = 'admin')) ORDER BY name ASC"
      args [is_global, caller_id]
    }
  }

  node "response" {
    uses "collect"
    requires [companies]
    provides [response]
    config {
      data "companies"
    }
  }
}

intent "admin.company_create" {
  description "Register a new client company"
  response "response"

  node "id" {
    uses "expression"
    provides [company_id]
    config {
      expression "'cmp_' + uuid()"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [company_id, input]
    provides [saved]
    config {
      statement "INSERT INTO companies (id, name, slug, status, created_at) VALUES ($1, $2, LOWER(REPLACE($2, ' ', '-')), 'active', CURRENT_TIMESTAMP)"
      args [company_id, input.name]
    }
  }

  node "response" {
    uses "collect"
    requires [company_id, saved]
    provides [response]
    config {
      id "company_id"
      status "created"
    }
  }
}

intent "admin.company_get" {
  description "Get a company the caller administers"
  response "response"

  node "id" {
    uses "request.param"
    provides [company_id]
    config {
      name "id"
    }
  }

  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, company_id]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin' AND company_id = $3) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, company_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [company_id, authorized]
    provides [company_rows]
    config {
      statement "SELECT id, name, slug, status, created_at FROM companies WHERE id = $1"
      args [company_id]
      require_rows true
      not_found_message "company not found"
    }
  }

  node "response" {
    uses "collect"
    requires [company_rows]
    provides [response]
    config {
      data "company_rows"
    }
  }
}

