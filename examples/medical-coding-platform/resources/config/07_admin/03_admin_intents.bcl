    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, user_id]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR (EXISTS (SELECT 1 FROM v_membership_scope t JOIN v_membership_scope a ON a.user_id = $2 AND a.role = 'admin' AND a.company_id = t.company_id AND a.facility_id IN ('*', t.facility_id) AND a.work_item_id IN ('*', t.work_item_id) WHERE t.user_id = $3)) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, user_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id, authorized]
    provides [user_rows]
    config {
      statement "SELECT id, email, name, roles, status, created_at FROM users WHERE id = $1"
      args [user_id]
