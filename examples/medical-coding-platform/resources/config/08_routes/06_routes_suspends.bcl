route "suspends.reasons_list" {
  method POST
  path "/web/client/coding/suspend_reasons"
  intent "suspends.reasons_list"
  allow_anonymous true
  cache_control "no-store"
}

route "suspends.suspend_chart" {
  method POST
  path "/web/client/coding/:wid/:eid/suspend"
  intent "suspends.suspend_chart"
  allow_anonymous true
  cache_control "no-store"
}

route "suspends.release_chart" {
  method POST
  path "/web/client/coding/:wid/:eid/release-suspends"
  intent "suspends.release_chart"
  allow_anonymous true
  cache_control "no-store"
}
