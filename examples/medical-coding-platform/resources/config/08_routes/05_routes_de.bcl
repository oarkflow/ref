route "de.queue_list" {
  method GET
  path "/coding/:wid/de-list"
  intent "de.queue_list"
  allow_anonymous true
  cache_control "no-store"
}

route "web_client.de.queue_list" {
  method GET
  path "/web/client/coding/:wid/de-list"
  intent "de.queue_list"
  allow_anonymous true
  cache_control "no-store"
}

