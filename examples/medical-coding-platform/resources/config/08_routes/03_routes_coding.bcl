route "coding.open_list" {
  method GET
  path "/web/client/coding/:wid/open-list"
  intent "queues.open_list"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.inprogress_list" {
  method GET
  path "/web/client/coding/:wid/in-progress-list"
  intent "queues.inprogress_list"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.start_coding" {
  method POST
  path "/web/client/coding/:wid/:eid/start-coding"
  intent "encounters.start_coding"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.patient_details" {
  method GET
  path "/web/client/coding/:wid/:eid/patient-details"
  intent "queues.patient_details"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.documentation" {
  method GET
  path "/web/client/coding/:wid/:eid/documentation"
  intent "coding.get_documentation"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.save_documentation" {
  method POST
  path "/web/client/coding/:wid/:eid/save-coding-documentation"
  intent "coding.save_documentation"
  allow_anonymous true
