}

route "coding.summary" {
  method GET
  path "/web/client/coding/:wid/:eid/summary"
  intent "coding.summary"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.inprogress_count" {
  method GET
  path "/web/client/coding/in-progress-count"
  intent "queues.inprogress_count"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.search_encounters" {
  method POST
  path "/web/client/coding/search-encounters"
  intent "encounters.search"
  allow_anonymous true
  cache_control "no-store"
}

route "coding.abandon" {
  method POST
  path "/web/client/coding/:wid/:eid/abandon-encounter"
