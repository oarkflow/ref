route "admin.users" {
  method GET
  path "/users"
  intent "admin.users_list"
  allow_anonymous true
  cache_control "no-store"
}

route "web_client.admin.users" {
  method GET
  path "/web/client/users"
  intent "admin.users_list"
  allow_anonymous true
  cache_control "no-store"
}

