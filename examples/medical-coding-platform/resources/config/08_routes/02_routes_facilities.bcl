route "workitems.types_create" {
  method POST
  path "/workitem/types"
  intent "workitems.types_create"
  session "sessions"
  auth "session_auth"
  allow_anonymous false
  authz { roles ["admin", "super_admin"] authorizer "authorization" }
  cache_control "no-store"
}

