route "facilities.summary" {
  method GET
  path "/coding/facilities/info"
  intent "queues.facility_summary"
  session "sessions"
  auth "session_auth"
  allow_anonymous false
  cache_control "no-store"
}

route "web_client.facilities.summary" {
  method GET
  path "/web/client/coding/facilities/info"
  intent "queues.facility_summary"
  session "sessions"
  auth "session_auth"
  allow_anonymous false
  cache_control "no-store"
}

