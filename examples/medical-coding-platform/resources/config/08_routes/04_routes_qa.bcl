route "qa.queue_list" {
  method GET
  path "/coding/:wid/qa-list"
  intent "qa.queue_list"
  session "sessions"
  auth "session_auth"
  allow_anonymous false
  cache_control "no-store"
}

route "web_client.qa.queue_list" {
  method GET
  path "/web/client/coding/:wid/qa-list"
  intent "qa.queue_list"
  session "sessions"
  auth "session_auth"
  allow_anonymous false
  cache_control "no-store"
}

