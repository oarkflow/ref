intent "de.complete" {
  description "Mark Data Entry finished and finalize chart"
  response "response"
  input_schema "de_complete_input"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "complete" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [wid, eid, user_id]
    provides [completed]
    config {
      statement "UPDATE encounter_details SET encounter_status = 'COMPLETE', dataentry_complete = 1, dataentry_assigned = COALESCE(dataentry_assigned, $3), updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1 AND work_item_id = $2 AND encounter_status IN ('DE_OPEN', 'DE_IN_PROGRESS')"
      args [eid, wid, user_id]
      require_affected true
      not_found_message "encounter is not awaiting data entry"
    }
  }

  node "update_header" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [completed, eid]
    provides [header_updated]
    config {
      statement "UPDATE encounters SET status = 'COMPLETE', updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1"
      args [eid]
    }
  }

  node "response" {
    uses "collect"
    requires [completed, header_updated]
    provides [response]
    config {
      status "de_completed"
    }
  }
}
