intent "de.complete" {
  description "Mark Data Entry finished and finalize chart"
  response "response"
  input_schema "de_complete_input"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id != '' ? principal.id : 'usr_de_01'"
    }
  }

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "complete" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [wid, eid]
    provides [completed]
    config {
      statement "UPDATE encounter_details SET encounter_status = 'DE_COMPLETE', dataentry_complete = 1, updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1 AND work_item_id = $2 AND encounter_status = 'DE_IN_PROGRESS'"
      args [eid, wid]
      require_affected true
      not_found_message "encounter not in DE in progress status"
    }
  }

  node "update_header" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [completed, eid]
    provides [header_updated]
    config {
      statement "UPDATE encounters SET status = 'DE_COMPLETE', updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1"
      args [eid]
    }
  }

  node "response" {
    uses "collect"
    requires [completed, header_updated]
    provides [response]
    config {
      status "de_completed"
    }
  }
}
