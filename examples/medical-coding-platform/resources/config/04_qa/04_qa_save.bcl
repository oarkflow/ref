intent "qa.save_documentation" {
  description "Save QA findings and determine if encounter is approved or returned to coding"
  response "response"
  input_schema "qa_save_input"

  node "user" {
    uses "expression"
    provides [user_id]
    config {
      expression "principal.id"
    }
  }

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "target_status" {
    uses "expression"
    requires [input]
    provides [next_status]
    config {
      expression "input.return_to_coder ? 'IN_PROGRESS' : 'DE_OPEN'"
    }
  }

  node "save_event" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [eid, wid, user_id, input, details_updated]
    provides [event_saved]
    config {
      statement "INSERT INTO qa_events (encounter_id, work_item_id, qa_user_id, coder_user_id, agreement_status, notes, created_at) VALUES ($1, $2, $3, COALESCE((SELECT code_assigned FROM encounter_details WHERE encounter_id = $1 AND work_item_id = $2), 'unassigned'), $4, $5, CURRENT_TIMESTAMP)"
      args [eid, wid, user_id, input.agreement_status, input.notes]
    }
  }

  node "update_details" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [eid, wid, next_status, user_id]
    provides [details_updated]
    config {
      statement "UPDATE encounter_details SET encounter_status = $1, qa_complete = CASE WHEN $1 = 'IN_PROGRESS' THEN 0 ELSE 1 END, qa_assigned = COALESCE(qa_assigned, $4), updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $2 AND work_item_id = $3 AND encounter_status IN ('IN_QA', 'QA_IN_PROGRESS')"
      args [next_status, eid, wid, user_id]
      require_affected true
      not_found_message "encounter is not awaiting QA review"
    }
  }

  node "update_header" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [details_updated, eid, next_status]
    provides [header_updated]
    config {
      statement "UPDATE encounters SET status = $1, updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $2"
      args [next_status, eid]
    }
  }

  node "response" {
    uses "collect"
    requires [event_saved, details_updated, header_updated, next_status]
    provides [response]
    config {
      status "qa_saved"
      encounter_status "next_status"
    }
  }
}

intent "qa.edit_documentation" {
  description "Edit and update QA documentation"
  response "response"
  input_schema "qa_save_input"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "response" {
    uses "collect"
    requires [eid, wid]
    provides [response]
    config {
      status "updated"
      message "QA documentation updated"
    }
  }
}

intent "qa.verify" {
  description "Pre-submission QA verification check"
  response "response"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "valid"
    }
  }
}

intent "qa.verify_qa" {
  description "Final QA sign-off verification"
  response "response"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "verified"
    }
  }
}

intent "qa.request_qa" {
  description "Request QA review on an encounter"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [wid, eid]
    provides [updated]
    config {
      statement "UPDATE encounter_details SET encounter_status = 'IN_QA', qa_flag = 1, updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1 AND work_item_id = $2"
      args [eid, wid]
      require_affected true
      not_found_message "encounter not found"
    }
  }

  node "update_header" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [updated, eid]
    provides [header_updated]
    config {
      statement "UPDATE encounters SET status = 'IN_QA', updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1"
      args [eid]
    }
  }

  node "response" {
    uses "collect"
    requires [header_updated]
    provides [response]
    config {
      status "IN_QA"
      message "Encounter queued for QA review"
    }
  }
}

intent "qa.return_to_coding" {
  description "Return an encounter from QA review back to medical coding queue"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "eid" {
    uses "request.param"
    provides [eid]
    config {
      name "eid"
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [wid, eid]
    provides [updated]
    config {
      statement "UPDATE encounter_details SET encounter_status = 'IN_PROGRESS', qa_complete = 0, updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1 AND work_item_id = $2"
      args [eid, wid]
      require_affected true
      not_found_message "encounter not found"
    }
  }

  node "update_header" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [updated, eid]
    provides [header_updated]
    config {
      statement "UPDATE encounters SET status = 'IN_PROGRESS', updated_at = CURRENT_TIMESTAMP WHERE encounter_id = $1"
      args [eid]
    }
  }

  node "response" {
    uses "collect"
    requires [header_updated]
    provides [response]
    config {
      status "IN_PROGRESS"
      message "Encounter returned to coder"
    }
  }
}

