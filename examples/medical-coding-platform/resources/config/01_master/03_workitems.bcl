intent "workitems.list" {
  description "List all active work items across facilities"
  response "response"

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    provides [work_items]
    config {
      statement "SELECT wi.work_item_id, wi.facility_id, f.facility_name, wi.work_item_type, wi.name, wi.status FROM work_items wi JOIN facilities f ON wi.facility_id = f.facility_id WHERE wi.status = 'active' ORDER BY f.facility_name, wi.name"
    }
  }

  node "response" {
    uses "collect"
    requires [work_items]
    provides [response]
    config {
      data "work_items"
    }
  }
}

intent "workitems.types" {
  description "Get available work item types"
  response "response"

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    provides [types]
    config {
      statement "SELECT id, type_key, name, description FROM work_item_types ORDER BY id"
    }
  }

  node "response" {
    uses "collect"
    requires [types]
    provides [response]
    config {
      data "types"
    }
  }
}

intent "workitems.description_settings" {
  description "Fetch work item configuration settings and facility metadata"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "info" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [workitem_rows]
    config {
      statement "SELECT wi.work_item_id, wi.facility_id, f.facility_name, wi.work_item_type, wi.name, wi.status FROM work_items wi JOIN facilities f ON wi.facility_id = f.facility_id WHERE wi.work_item_id = $1"
      args [wid]
    }
  }

  node "settings" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [settings_rows]
    config {
      statement "SELECT setting_key, setting_value FROM work_item_settings WHERE work_item_id = $1"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [workitem_rows, settings_rows]
    provides [response]
    config {
      work_item "workitem_rows"
      settings "settings_rows"
    }
  }
}

intent "workitems.create" {
  description "Register a new work item queue"
  response "response"
  input_schema "workitem_input"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, input]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN (SELECT client_id FROM facilities WHERE facility_id = $3) IS NULL THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT client_id FROM facilities WHERE facility_id = $3) AND a.facility_id IN ('*', $3) AND a.work_item_id IN ('*', '*')) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, input.facility_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "id" {
    uses "expression"
    provides [work_item_id]
    config {
      expression "'wi_' + uuid()"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [work_item_id, input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO work_items (work_item_id, facility_id, work_item_type, name, status, created_at, updated_at) VALUES ($1, $2, $3, $4, 'active', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
      args [work_item_id, input.facility_id, input.work_item_type, input.name]
    }
  }

  node "response" {
    uses "collect"
    requires [work_item_id, saved]
    provides [response]
    config {
      work_item_id "work_item_id"
      status "created"
    }
  }
}

intent "workitems.types_create" {
  description "Create a new work item type"
  response "response"
  input_schema "workitem_type_input"

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input]
    provides [saved]
    config {
      statement "INSERT INTO work_item_types (type_key, name, description) VALUES (LOWER(REPLACE($1, ' ', '_')), $1, $1)"
      args [input.work_item_description]
    }
  }

  node "response" {
    uses "collect"
    requires [saved]
    provides [response]
    config {
      status "created"
      description "input.work_item_description"
    }
  }
}

intent "workitems.settings_update" {
  description "Update work item configuration settings"
  response "response"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, wid]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) IS NULL THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) AND a.facility_id IN ('*', (SELECT facility_id FROM work_items WHERE work_item_id = $3)) AND a.work_item_id IN ('*', $3)) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, wid]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "upsert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [wid, input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO work_item_settings (work_item_id, setting_key, setting_value, created_at) VALUES ($1, $2, $3, CURRENT_TIMESTAMP)"
      args [wid, input.key, input.value]
    }
  }

  node "response" {
    uses "collect"
    requires [saved]
    provides [response]
    config {
      message "Work item settings updated successfully"
    }
  }
}

