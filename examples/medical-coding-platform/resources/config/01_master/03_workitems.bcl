  description "Fetch work item description and basic details"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [details]
    config {
      statement "SELECT wi.work_item_id, wi.facility_id, f.facility_name, wi.work_item_type, wi.name, wi.status FROM work_items wi JOIN facilities f ON wi.facility_id = f.facility_id WHERE wi.work_item_id = $1"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [details]
