intent "workitems.by_company" {
  description "Get work items for a given company"
  response "response"

  node "cid" {
    uses "request.param"
    provides [cid]
    config {
      name "cid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [cid]
    provides [work_items]
    config {
      statement "SELECT wi.work_item_id, wi.facility_id, f.facility_name, wi.work_item_type, wi.name, wi.status FROM work_items wi JOIN facilities f ON wi.facility_id = f.facility_id WHERE f.client_id = $1 AND wi.status = 'active'"
      args [cid]
    }
  }

  node "response" {
    uses "collect"
    requires [work_items]
    provides [response]
    config {
      data "work_items"
