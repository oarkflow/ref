intent "facilities.list" {
  description "List all healthcare facilities"
  response "response"

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    provides [facilities]
    config {
      statement "SELECT facility_id, facility_name, client_id, status, created_at FROM facilities WHERE status = 'active' ORDER BY facility_name ASC"
    }
  }

  node "response" {
    uses "collect"
    requires [facilities]
    provides [response]
    config {
      data "facilities"
    }
  }
}

intent "facilities.create" {
  description "Register a new healthcare facility"
  response "response"
  input_schema "facility_input"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, input]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 OR EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = $3 AND a.facility_id IN ('*', '*') AND a.work_item_id IN ('*', '*')) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, input.client_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "id" {
    uses "expression"
    provides [facility_id]
    config {
      expression "'fac_' + uuid()"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [facility_id, input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO facilities (facility_id, facility_name, client_id, status, created_at, updated_at) VALUES ($1, $2, $3, 'active', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
      args [facility_id, input.facility_name, input.client_id]
    }
  }

  node "response" {
    uses "collect"
    requires [facility_id, saved]
    provides [response]
    config {
      facility_id "facility_id"
      status "created"
    }
  }
}
