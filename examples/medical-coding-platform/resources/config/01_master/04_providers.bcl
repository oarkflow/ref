intent "providers.list" {
  description "Get complete physician and midlevel provider directory"
  response "response"

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    provides [providers]
    config {
      statement "SELECT p.provider_id, p.first_name, p.last_name, p.npi, p.provider_type, p.email, p.status FROM providers p WHERE p.status = 'active' ORDER BY p.last_name, p.first_name"
    }
  }

  node "response" {
    uses "collect"
    requires [providers]
    provides [response]
    config {
      data "providers"
    }
  }
}

intent "providers.types" {
  description "Get physician/midlevel provider categories"
  response "response"

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    provides [types]
    config {
      statement "SELECT id, name, description FROM provider_types ORDER BY id"
    }
  }

  node "response" {
    uses "collect"
    requires [types]
    provides [response]
    config {
      data "types"
    }
  }
}

intent "providers.save" {
  description "Create or update provider record"
  response "response"
  input_schema "provider_input"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, input]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN $3 = '' THEN (CASE WHEN EXISTS (SELECT 1 FROM v_membership_scope WHERE user_id = $2 AND role = 'admin') THEN 1 ELSE 0 END) WHEN (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) IS NULL THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) AND a.facility_id IN ('*', (SELECT facility_id FROM work_items WHERE work_item_id = $3)) AND a.work_item_id IN ('*', $3)) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, input.work_item_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "id" {
    uses "expression"
    provides [provider_id]
    config {
      expression "'prv_' + uuid()"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [provider_id, input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO providers (provider_id, first_name, last_name, npi, provider_type, email, status, created_at) VALUES ($1, $2, $3, $4, $5, $6, 'active', CURRENT_TIMESTAMP)"
      args [provider_id, input.first_name, input.last_name, input.npi, input.provider_type, input.email]
    }
  }

  node "link" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [provider_id, saved, input]
    provides [linked]
    config {
      statement "INSERT INTO provider_wi (provider_id, work_item_id, client_ref) SELECT $1, $2, $3 WHERE $2 <> ''"
      args [provider_id, input.work_item_id, input.client_ref]
    }
  }

  node "response" {
    uses "collect"
    requires [provider_id, saved, linked]
    provides [response]
    config {
      provider_id "provider_id"
      status "saved"
    }
  }
}

intent "providers.by_workitem" {
  description "Get providers associated with a work item and their client references"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [providers]
    config {
      statement "SELECT p.provider_id, p.first_name, p.last_name, p.npi, p.provider_type, pw.client_ref FROM providers p JOIN provider_wi pw ON p.provider_id = pw.provider_id WHERE pw.work_item_id = $1 AND p.status = 'active'"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [providers]
    provides [response]
    config {
      data "providers"
    }
  }
}

intent "providers.review" {
  description "Review provider details prior to persistence"
  response "response"
  input_schema "provider_review_input"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "valid"
      provider "input"
    }
  }
}

intent "providers.details" {
  description "Get provider details by provider ID"
  response "response"

  node "pid" {
    uses "request.param"
    provides [pid]
    config {
      name "pid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [pid]
    provides [provider_rows]
    config {
      statement "SELECT p.provider_id, p.first_name, p.last_name, p.npi, p.provider_type, p.email, p.status, p.created_at FROM providers p WHERE p.provider_id = $1"
      args [pid]
      require_rows true
      not_found_message "provider not found"
    }
  }

  node "response" {
    uses "collect"
    requires [provider_rows]
    provides [response]
    config {
      data "provider_rows"
    }
  }
}

