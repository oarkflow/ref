intent "chargemaster.save" {
  description "Add or update chargemaster code entry"
  response "response"
  input_schema "charge_code_input"

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input]
    provides [saved]
    config {
      statement "INSERT INTO charge_master (work_item_id, cpt_hcpcs_code, description, charge_type, charge_amount, effective_date, profee_type, facility_type, status, created_at, updated_at) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'active', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
      args [input.work_item_id, input.cpt_hcpcs_code, input.description, input.charge_type, input.charge_amount, input.effective_date, input.profee_type, input.facility_type]
    }
  }

  node "response" {
    uses "collect"
    requires [saved]
    provides [response]
    config {
      status "saved"
    }
  }
}

intent "chargemaster.list" {
  description "Get chargemaster code list for review"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
      required false
      default ""
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [codes]
    config {
      statement "SELECT id, work_item_id, cpt_hcpcs_code, description, charge_type, charge_amount, effective_date, profee_type, facility_type, status FROM charge_master WHERE status = 'active' AND ($1 = '' OR work_item_id = $1) ORDER BY cpt_hcpcs_code ASC"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [codes]
    provides [response]
    config {
      data "codes"
    }
  }
}

intent "chargemaster.effective_dates" {
  description "Get unique chargemaster effective dates for a work item"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [dates]
    config {
      statement "SELECT DISTINCT effective_date FROM charge_master WHERE work_item_id = $1 AND effective_date IS NOT NULL ORDER BY effective_date DESC"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [dates]
    provides [response]
    config {
      data "dates"
    }
  }
}

intent "chargemaster.review" {
  description "Validate and preview chargemaster codes before storing"
  response "response"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "valid"
      preview "input"
    }
  }
}

intent "chargemaster.update" {
  description "Update an existing chargemaster code entry"
  response "response"

  node "cid" {
    uses "request.param"
    provides [cid]
    config {
      name "cid"
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [cid, input]
    provides [updated]
    config {
      statement "UPDATE charge_master SET description = $1, charge_amount = $2, effective_date = $3, profee_type = $4, facility_type = $5, updated_at = CURRENT_TIMESTAMP WHERE id = $6"
      args [input.description, input.charge_amount, input.effective_date, input.profee_type, input.facility_type, cid]
      require_affected true
      not_found_message "charge code not found"
    }
  }

  node "response" {
    uses "collect"
    requires [updated]
    provides [response]
    config {
      status "updated"
    }
  }
}

intent "chargemaster.bulk_delete" {
  description "Deactivate charge codes in bulk"
  response "response"
  input_schema "bulk_delete_input"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "deleted"
      message "Selected charge codes deactivated"
    }
  }
}

