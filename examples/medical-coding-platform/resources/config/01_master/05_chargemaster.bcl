intent "chargemaster.save" {
  description "Add or update chargemaster code entry"
  response "response"
  input_schema "charge_code_input"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, input]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) IS NULL THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = $3) AND a.facility_id IN ('*', (SELECT facility_id FROM work_items WHERE work_item_id = $3)) AND a.work_item_id IN ('*', $3)) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, input.work_item_id]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "insert" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input, authorized]
    provides [saved]
    config {
      statement "INSERT INTO charge_master (work_item_id, cpt_hcpcs_code, description, charge_type, charge_amount, effective_date, profee_type, facility_type, status, created_at, updated_at) VALUES ($1, $2, $3, COALESCE($4, 'PB'), COALESCE($5, 0), COALESCE($6, date('now')), $7, $8, 'active', CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)"
      args [input.work_item_id, input.cpt_hcpcs_code, input.description, input.charge_type, input.charge_amount, input.effective_date, input.profee_type, input.facility_type]
    }
  }

  node "response" {
    uses "collect"
    requires [saved]
    provides [response]
    config {
      status "saved"
    }
  }
}

intent "chargemaster.list" {
  description "Get chargemaster code list for review"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
      required false
      default ""
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [codes]
    config {
      statement "SELECT id, work_item_id, cpt_hcpcs_code, description, charge_type, charge_amount, effective_date, profee_type, facility_type, status FROM charge_master WHERE status = 'active' AND ($1 = '' OR work_item_id = $1) ORDER BY cpt_hcpcs_code ASC"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [codes]
    provides [response]
    config {
      data "codes"
    }
  }
}

intent "chargemaster.effective_dates" {
  description "Get unique chargemaster effective dates for a work item"
  response "response"

  node "wid" {
    uses "request.param"
    provides [wid]
    config {
      name "wid"
    }
  }

  node "query" {
    uses "database.query"
    resource "database"
    kind read
    requires [wid]
    provides [dates]
    config {
      statement "SELECT DISTINCT effective_date FROM charge_master WHERE work_item_id = $1 AND effective_date IS NOT NULL ORDER BY effective_date DESC"
      args [wid]
    }
  }

  node "response" {
    uses "collect"
    requires [dates]
    provides [response]
    config {
      data "dates"
    }
  }
}

intent "chargemaster.review" {
  description "Validate and preview chargemaster codes before storing"
  response "response"

  node "response" {
    uses "collect"
    requires [input]
    provides [response]
    config {
      status "valid"
      preview "input"
    }
  }
}

intent "chargemaster.update" {
  description "Update an existing chargemaster code entry"
  response "response"
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, cid]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = (SELECT work_item_id FROM charge_master WHERE id = $3)) IS NULL THEN 0 WHEN EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = (SELECT work_item_id FROM charge_master WHERE id = $3)) AND a.facility_id IN ('*', (SELECT facility_id FROM work_items WHERE work_item_id = (SELECT work_item_id FROM charge_master WHERE id = $3))) AND a.work_item_id IN ('*', (SELECT work_item_id FROM charge_master WHERE id = $3))) THEN 1 ELSE 0 END AS ok"
      args [is_global, caller_id, cid]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "cid" {
    uses "request.param"
    provides [cid]
    config {
      name "cid"
    }
  }

  node "update" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [cid, input, authorized]
    provides [updated]
    config {
      statement "UPDATE charge_master SET description = COALESCE($1, description), charge_amount = COALESCE($2, charge_amount), effective_date = COALESCE($3, effective_date), profee_type = COALESCE($4, profee_type), facility_type = COALESCE($5, facility_type), updated_at = CURRENT_TIMESTAMP WHERE id = $6"
      args [input.description, input.charge_amount, input.effective_date, input.profee_type, input.facility_type, cid]
      require_affected true
      not_found_message "charge code not found"
    }
  }

  node "response" {
    uses "collect"
    requires [updated]
    provides [response]
    config {
      status "updated"
    }
  }
}

intent "chargemaster.bulk_delete" {
  description "Deactivate charge codes in bulk"
  response "response"
  input_schema "bulk_delete_input"

  node "ids_json" {
    uses "expression"
    requires [input]
    provides [ids_json]
    config {
      expression "json(input.ids)"
    }
  }
  node "caller" {
    uses "expression"
    provides [caller_id]
    config {
      expression "principal.id"
    }
  }

  node "global_flag" {
    uses "expression"
    provides [is_global]
    config {
      expression "principal.roles has_any ['admin', 'super_admin'] ? 1 : 0"
    }
  }

  node "gate_query" {
    uses "database.query"
    resource "database"
    kind read
    requires [caller_id, is_global, ids_json]
    provides [gate_rows]
    config {
      statement "SELECT CASE WHEN $1 = 1 THEN 1 WHEN EXISTS (SELECT 1 FROM charge_master c WHERE c.id IN (SELECT value FROM json_each($3)) AND NOT ((SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = c.work_item_id) IS NOT NULL AND EXISTS (SELECT 1 FROM v_membership_scope a WHERE a.user_id = $2 AND a.role = 'admin' AND a.company_id = (SELECT f.client_id FROM work_items wi JOIN facilities f ON f.facility_id = wi.facility_id WHERE wi.work_item_id = c.work_item_id) AND a.facility_id IN ('*', (SELECT facility_id FROM work_items WHERE work_item_id = c.work_item_id)) AND a.work_item_id IN ('*', c.work_item_id)))) THEN 0 ELSE 1 END AS ok"
      args [is_global, caller_id, ids_json]
    }
  }

  node "gate_row" {
    uses "data.first"
    requires [gate_rows]
    provides [gate]
    config {
      source_fact "gate_rows"
    }
  }

  node "authorize" {
    uses "validate.expression"
    kind pure
    requires [gate]
    provides [authorized]
    config {
      expression "gate.ok == 1"
      code "FORBIDDEN"
      category "permission"
      message "you do not administer this workspace"
    }
  }

  node "deactivate" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [ids_json, authorized]
    provides [deactivated]
    config {
      statement "UPDATE charge_master SET status = 'inactive', updated_at = CURRENT_TIMESTAMP WHERE status = 'active' AND id IN (SELECT value FROM json_each($1))"
      args [ids_json]
    }
  }

  node "response" {
    uses "collect"
    requires [deactivated]
    provides [response]
    config {
      status "deleted"
      message "Selected charge codes deactivated"
    }
  }
}

