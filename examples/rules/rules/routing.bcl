bcl { version "1.0" }

# Routing policy.
#
# For one message, each provider in the catalog (a row of the providers table,
# with its live health) is a candidate. Routing is two halves, and they happen in
# this order and no other:
#
#   1. FILTER (route_eligibility) — per candidate: may this provider carry this
#      message? A deny names the reason. An allow says which tier the provider
#      belongs to — which the ranking then reads as a score — and whether the
#      message is RESERVED for this provider alone. The filter decides on identity
#      and state, never by comparing candidates, so nothing here drops a provider
#      for scoring badly.
#   2. RANK (the route_* rankings below) — score whatever survived, best first.
#      That order is the chain a message is sent down and fails over along.
#
# A score can move a candidate up or down the chain and never out of it. Keeping
# the two halves apart is what makes the outcome depend on whether a provider may
# carry a message rather than on how its tier happened to be numbered.
#
# What routing does NOT read: the request's dlr. A delivery receipt is a reporting
# question, not a carrier-selection one, so a provider that cannot report one is
# filtered and scored exactly like any other.
#
# Facts: message (to, country, text, from, sender_kind, type, template, unicode,
# segments), user (id, tenant, objective), and provider (the candidate):
# id, state, circuit_open, quality, delivery_rate, cost_per_segment, cost (this
# message), countries, message_types, owner, users, tenants, assigned_only,
# prefix_pattern, supports_unicode / _dlr / _alpha / _long, consecutive_failures.
# Lists are written |a|b| so a row can test membership. A routing rule that names
# the provider (overrides.bcl) also sets provider.granted, below.
#
# A tier's priority is a score, added by the ranking and far larger than anything
# else in one, so a tier always outranks the next. That is an ordering statement,
# made in the ranking — not a filter.

module "routing" {
  version "1"
  environment "production"

  decision_schema "route_eligibility" { effects [allow, deny] default deny strategy first_match }
  decision_table "route_eligibility" {
    default deny
    hit_policy first

    # ---- Reasons a provider cannot carry this message ------------------------
    row "provider-not-active" {
      priority 1000
      when { provider.state != "active" }
      then { outcome { decision deny reason "the provider is not active" attributes { code "PROVIDER_STATE" transient true } } }
    }
    row "circuit-open" {
      priority 990
      when { provider.circuit_open == 1 }
      then { outcome { decision deny reason "the provider is failing on this route and its circuit is open" attributes { code "CIRCUIT_OPEN" transient true } } }
    }
    row "no-unicode" {
      priority 980
      when {
        all {
          message.unicode == true
          provider.supports_unicode == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send unicode text" attributes { code "NO_UNICODE" } } }
    }
    row "granted-by-a-routing-rule" {
      priority 950
      when {
        all {
          provider.granted == true
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "rule" } } }
    }
    row "no-alpha-sender" {
      priority 940
      when {
        all {
          message.sender_kind == "alpha"
          provider.supports_alpha == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send from an alphanumeric sender id" attributes { code "NO_ALPHA_SENDER" } } }
    }
    row "no-long-messages" {
      priority 930
      when {
        all {
          message.segments > 1
          provider.supports_long == 0
        }
      }
      then { outcome { decision deny reason "the provider cannot send multi-segment messages" attributes { code "NO_LONG_SMS" } } }
    }
    row "message-type-not-carried" {
      priority 920
      when {
        all {
          provider.message_types != ""
          not {
            contains(provider.message_types, "|" + message.type + "|")
          }
        }
      }
      then { outcome { decision deny reason "the provider does not carry this message type" attributes { code "TYPE_NOT_CARRIED" } } }
    }
    # An OTP is not worth sending through a provider that drops messages.
    row "otp-quality-floor" {
      priority 910
      when {
        all {
          message.type == "otp"
          provider.quality < 85
        }
      }
      then { outcome { decision deny reason "an OTP needs a provider of quality 85 or better" attributes { code "QUALITY_FLOOR" } } }
    }
    # An operator's routing rule names this provider for this message: it is
    row "a-private-provider-of-someone-else" {
      priority 900
      when {
        all {
          provider.owner != ""
          provider.owner != user.id
        }
      }
      then { outcome { decision deny reason "the provider belongs to another account" attributes { code "NOT_YOURS" } } }
    }

    # ---- Tiers a usable provider can belong to, best first --------------------
    # A provider the account owns is the only one it uses.
    row "owned-by-the-account" {
      priority 800
      when { provider.owner == user.id }
      then { outcome { decision allow attributes { tier "user" priority 100000 reserves true } } }
    }
    # Assigned to this account, for the destination.
    row "assigned-to-the-account" {
      priority 790
      when {
        all {
          contains(provider.users, "|" + user.id + "|")
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "user" priority 90000 } } }
    }
    # Assigned to the account's tenant, for the destination.
    row "assigned-to-the-tenant" {
      priority 780
      when {
        all {
          contains(provider.tenants, "|" + user.tenant + "|")
          any {
            provider.countries == ""
            contains(provider.countries, "|" + message.country + "|")
          }
        }
      }
      then { outcome { decision allow attributes { tier "tenant" priority 70000 } } }
    }
    # A route bought for one operator's number range.
    row "operator-range" {
      priority 770
      when {
        all {
          provider.assigned_only == 0
          provider.prefix_pattern != ""
          message.to matches provider.prefix_pattern
        }
      }
      then { outcome { decision allow attributes { tier "operator" priority 60000 } } }
    }
    row "serves-the-country" {
      priority 760
      when {
        all {
          provider.assigned_only == 0
          provider.prefix_pattern == ""
          provider.countries != ""
          contains(provider.countries, "|" + message.country + "|")
        }
      }
      then { outcome { decision allow attributes { tier "country" priority 50000 } } }
    }
    # Last resort for any destination.
    row "catch-all" {
      priority 750
      when {
        all {
          provider.assigned_only == 0
          provider.countries == ""
        }
      }
      then { outcome { decision allow attributes { tier "platform" priority 10000 } } }
    }
    # Nothing above makes the provider usable for this account and destination.
    row "not-available-here" {
      priority 1
      when { provider.id != "" }
      then { outcome { decision deny reason "no routing rule makes this provider available to this account for this destination" attributes { code "NOT_AVAILABLE" } } }
    }
  }

  # What a message is routed for.
  decision_schema "route_objective" { effects [allow] default allow strategy first_match }
  decision_table "route_objective" {
    default allow
    hit_policy first

    row "account-prefers-cost" {
      priority 100
      when { user.objective == "lowest_cost" }
      then { outcome { decision allow attributes { ranking "route_cost" } } }
    }
    row "account-prefers-delivery" {
      priority 90
      when { user.objective == "highest_delivery" }
      then { outcome { decision allow attributes { ranking "route_delivery" } } }
    }
    row "otp-wants-delivery" {
      priority 80
      when { message.type == "otp" }
      then { outcome { decision allow attributes { ranking "route_delivery" } } }
    }
    row "promotion-wants-price" {
      priority 70
      when { message.type == "promotional" }
      then { outcome { decision allow attributes { ranking "route_cost" } } }
    }
    row "everything-else" {
      priority 10
      when { message.type != "" }
      then { outcome { decision allow attributes { ranking "route_balanced" } } }
    }
  }

  # ---- Rankings: how eligible candidates are ordered ---------------------------
  # A candidate's score is its tier's priority (priority_path) plus, for each
  # score block, weight * clamp((metric - min) / (max - min), 0, 1): the weight is
  # what the metric is worth at its best, in the same units for every metric. The
  # tier priorities are 10000 apart, so the metrics only order candidates within
  # a tier: 400 + 100 + 150 + 50 can never lift one over the next tier. Observed
  # failures cost points.

  decision_schema "route_delivery" { effects [allow] default allow strategy first_match }
  ranking "route_delivery" {
    selection best
    priority_path "provider.priority"
    score "delivery-rate" { metric "provider.delivery_rate" weight 400 normalize [0.8, 1] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "recent-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
    score "cost" { metric "provider.cost_per_segment" weight -50 normalize [0, 0.2] }
  }

  decision_schema "route_cost" { effects [allow] default allow strategy first_match }
  ranking "route_cost" {
    selection best
    priority_path "provider.priority"
    score "cost" { metric "provider.cost_per_segment" weight -2000 normalize [0, 0.2] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "recent-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
  }

  decision_schema "route_balanced" { effects [allow] default allow strategy first_match }
  ranking "route_balanced" {
    selection best
    priority_path "provider.priority"
    score "delivery-rate" { metric "provider.delivery_rate" weight 200 normalize [0.8, 1] }
    score "quality" { metric "provider.quality" weight 100 normalize [0, 100] }
    score "cost" { metric "provider.cost_per_segment" weight -150 normalize [0, 0.2] }
    score "recent-failures" { metric "provider.consecutive_failures" weight -150 normalize [0, 10] }
  }
}
