name "respond-demo"
version "1.0.0"
environment "production"

intent "hello" {
  response "result"
  node "resp" {
    uses "data.transform"
    kind pure
    provides [result]
    config {
      data {
        extract {
          message "'hello from a sealed app'"
        }
      }
    }
  }
}

route "get_hello" {
  method "GET"
  path "/hello"
  intent "hello"
}

route "post_hello" {
  method "POST"
  path "/hello"
  intent "hello"
}
