# =============================================================================
# Direct Carrier SMPP Connections
# =============================================================================

resource "carrier_ntc_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.ntc.np:2775"
    system_id   "ref_ntc_client"
    password    "secret_ntc_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "carrier_ncell_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.ncell.com.np:2775"
    system_id   "ref_ncell_client"
    password    "secret_ncell_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "airtel_direct_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.airtel.in:2775"
    system_id   "ref_airtel_client"
    password    "secret_airtel_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "jio_direct_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.jio.com:2775"
    system_id   "ref_jio_client"
    password    "secret_jio_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "bt_direct_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.bt.com:2775"
    system_id   "ref_bt_client"
    password    "secret_bt_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "singtel_apac_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.singtel.com:2775"
    system_id   "ref_singtel_client"
    password    "secret_singtel_123"
    queue       "bus"
    receipt_job "sms.dlr"
  }
}

resource "etisalat_mena_smpp" {
  kind "service.smpp"
  config {
    addr        "smsc.etisalat.ae:2775"
    system_id   "ref_etisalat_client"
