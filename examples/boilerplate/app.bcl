  method GET
  path "/api/v1/gov/scope"
  intent "gov.caller_scope"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    permissions ["gov:read"]
    authorizer "authorization"
  }
}

route "api.gov.tree" {
  method GET
  path "/api/v1/gov/tree"
  intent "gov.tree"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    permissions ["gov:read"]
    authorizer "authorization"
  }
}

route "api.gov.budget_heads" {
