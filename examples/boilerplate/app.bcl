# ===========================================================================
# Application Identity & Environment
#
# This single key-value layer names the deployment and resolves the runtime
# environment from the host. Every other file in this directory is loaded
# automatically by platform.LoadDir and merged into one Document.
# ===========================================================================

name "ref-auth-boilerplate"
environment env("APP_ENV", "development")
version env("APP_VERSION", "1.0.0")

# ===========================================================================
# Secrets — Resolved at Load Time, Never Logged
#
# Every secret is validated before the application starts. A missing required
# secret fails compilation, so a misconfigured deployment never serves traffic.
# Values are redacted from the Document that Platform.Document() exposes.
# ===========================================================================

secret "database_url" {
  env "DATABASE_URL"
  value "file:.data/boilerplate.db?cache=shared&mode=rwc"
}

secret "session_secret" {
  env "SESSION_SECRET"
  value "super-secure-argon2id-boilerplate-secret-32-bytes"
  required true
}

secret "jwt_secret" {
  env "JWT_SECRET"
  value "jwt-fallback-secret-change-in-production-48chars"
}

secret "webhook_api_key" {
  env "WEBHOOK_API_KEY"
  value "dev-webhook-key-for-local-testing-only"
}

# ===========================================================================
# Enterprise RBAC Roles & Hierarchy Matrix
#
# Roles form an inheritance DAG. The platform's authz.rbac resource resolves
# the transitive closure once at load time, so a permission check at request
# time is a map lookup — never a graph walk. Cycles are rejected at compile
# time.
#
# Permissions ending in ":*" grant the whole namespace (e.g. "users:*"
# implies users:read, users:write, users:delete). The wildcard "*" grants
# everything — only super_admin should carry it.
# ===========================================================================

role "super_admin" {
  description "Unrestricted root administrator — bypasses all authorization checks"
  permissions ["*"]
}

role "admin" {
  description "System governance, user administration, and security audit"
  permissions [
    "admin:dashboard",
    "users:*",
    "roles:manage",
    "audit:read",
    "settings:read",
    "settings:write",
    "gov:*",
    "coding:*",
    "activity:*",
    "tasks:admin"
  ]
  inherits ["manager"]
}

role "manager" {
  description "Operations, metrics, reporting, and team oversight"
  permissions [
    "reports:read",
    "reports:write",
    "reports:export",
    "users:read",
    "teams:read",
    "teams:write",
    "tasks:approve",
    "activity:read",
    "gov:read",
    "coding:read"
  ]
  inherits ["user"]
}

role "user" {
  description "Standard authenticated platform member"
  permissions [
    "dashboard:view",
    "profile:view",
    "profile:update",
    "notifications:read",
    "projects:read",
    "projects:write",
    "tasks:read",
    "tasks:write",
    "activity:self"
  ]
  inherits ["guest"]
}

# --- Module roles (bcl/13_gov_projects.bcl, bcl/14_medical_coding.bcl) -----
# Both inherit "user", so an officer or a coder also manages projects and
# tasks. Their organisational reach (officers) is not a role: it is the
# user_org_units row that bcl/13_gov_projects.bcl resolves per request.

role "officer" {
  description "Government project officer, scoped to an organisational unit subtree"
  permissions [
    "gov:read",
    "gov:write"
  ]
  inherits ["user"]
}

role "coder" {
  description "Medical coder working the encounter coding queue"
  permissions [
    "coding:read",
    "coding:write"
  ]
  inherits ["user"]
}

role "guest" {
  description "Public unauthenticated visitor — can only access public resources"
  permissions []
}

# ===========================================================================
# Reusable Structural Contracts (Shapes)
#
# A shape is a reusable validation schema. validate.schema nodes, CRUD
# resources, human-task forms, and route bodies all reference the same shape
# name, so the structure is validated identically at every boundary.
#
# The block is "shape" because BCL reserves "schema" for its own schema
# support. Properties are "prop" because BCL reserves "field".
# ===========================================================================

shape "user" {
  kind object
  description "A user account in the system"

  prop "email" {
    kind string
    required true
    format email
    description "User's email address — used as the login identifier"
  }

  prop "name" {
    kind string
    required true
    min_length 1
    max_length 255
    description "Display name"
  }

  prop "password" {
    kind string
    required true
    min_length 8
    max_length 128
    sensitive true
    description "Plaintext password — hashed with Argon2id before storage"
  }

  prop "roles" {
    kind array
    items "string"
    description "Assigned role names"
    default ["user"]
  }

  prop "status" {
    kind string
    enum ["active", "suspended", "pending"]
    default "active"
  }
}

shape "login_input" {
  kind object
  description "Credentials for user login"

  prop "email" {
    kind string
    required true
    format email
  }

  prop "password" {
    kind string
    required true
    sensitive true
  }
}

shape "password_reset_input" {
  kind object
  description "Token and new password for password reset"

  prop "token" {
    kind string
    required true
    sensitive true
  }

  prop "new_password" {
    kind string
    required true
    min_length 8
    sensitive true
  }
}

shape "change_password_input" {
  kind object
  description "Current and new password for authenticated password change"

  prop "current_password" {
    kind string
    required true
    sensitive true
  }

  prop "new_password" {
    kind string
    required true
    min_length 8
    sensitive true
  }
}

shape "role_update_input" {
  kind object
  description "Admin role assignment payload"

  prop "user_id" {
    kind string
    required true
  }

  prop "role" {
    kind string
    required true
    enum ["guest", "user", "officer", "coder", "manager", "admin", "super_admin"]
  }
}

shape "pagination" {
  kind object
  description "Standard pagination parameters"

  prop "page" {
    kind int
    min 1
    default 1
  }

  prop "per_page" {
    kind int
    min 1
    max 100
    default 20
  }

  prop "sort_by" {
    kind string
    default "created_at"
  }

  prop "sort_order" {
    kind string
    enum ["asc", "desc"]
    default "desc"
  }
}

# ===========================================================================
# Platform Infrastructure Resources
#
# A resource is opened once per immutable generation and shared by every node
# that names it. Connection pools, caches, and queue consumers live for the
# generation's lifetime — never per-request.
#
# Resource dependencies are inferred from well-known config keys (database,
# cache, queue, session).
# ===========================================================================

# --- Primary Database (SQL) ------------------------------------------------
resource "database" {
  kind "database.sql"
  description "Primary SQL database — schema migrations run at boot"
  config {
    driver "sqlite"
    dsn env("DATABASE_URL", "file:.data/boilerplate.db?cache=shared&mode=rwc")
    max_open_connections 10
    max_idle_connections 2
    connection_max_lifetime 30m
    migrations [
      "CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, password_hash TEXT NOT NULL, roles TEXT NOT NULL DEFAULT 'user', status TEXT NOT NULL DEFAULT 'active', created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE TABLE IF NOT EXISTS password_resets (token_hash TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE, expires_at TIMESTAMPTZ NOT NULL, used_at TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_resets_user ON password_resets(user_id);",
      "CREATE TABLE IF NOT EXISTS audit_log (id INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT NOT NULL, actor_id TEXT, target_id TEXT, detail TEXT, ip_address TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_audit_actor ON audit_log(actor_id);",
      "CREATE INDEX IF NOT EXISTS idx_audit_action ON audit_log(action);",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_admin_01', 'admin@example.com', 'Alice Admin', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'admin', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_manager_01', 'manager@example.com', 'Bob Manager', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'manager', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_user_01', 'user@example.com', 'Charlie User', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'user', 'active');",
      "CREATE INDEX IF NOT EXISTS idx_audit_created ON audit_log(created_at);",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_officer_bagmati', 'officer.bagmati@example.com', 'Dina Officer (Bagmati)', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'officer', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_officer_koshi', 'officer.koshi@example.com', 'Eli Officer (Koshi)', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'officer', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_officer_ktm', 'officer.ktm@example.com', 'Farah Officer (Kathmandu)', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'officer', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_coder_01', 'coder@example.com', 'Gita Coder', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'coder', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_coder_02', 'coder2@example.com', 'Hari Coder', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'coder', 'active');",

      # --- Projects & tasks (bcl/12_projects.bcl) ---------------------------
      "CREATE TABLE IF NOT EXISTS projects (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', owner_id TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'active', due_date TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_projects_owner ON projects(owner_id);",
      "CREATE TABLE IF NOT EXISTS project_members (project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE, user_id TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'member', added_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (project_id, user_id));",
      "CREATE INDEX IF NOT EXISTS idx_project_members_user ON project_members(user_id);",
      "CREATE TABLE IF NOT EXISTS tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE, title TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', assignee_id TEXT NOT NULL, reporter_id TEXT NOT NULL, priority TEXT NOT NULL DEFAULT 'medium', status TEXT NOT NULL DEFAULT 'todo', due_date TEXT, overdue INTEGER NOT NULL DEFAULT 0, approval_run_id TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, completed_at TIMESTAMPTZ);",
      "CREATE INDEX IF NOT EXISTS idx_tasks_project ON tasks(project_id, status);",
      "CREATE INDEX IF NOT EXISTS idx_tasks_assignee ON tasks(assignee_id, status);",
      "CREATE INDEX IF NOT EXISTS idx_tasks_due ON tasks(due_date, status);",
      "CREATE TABLE IF NOT EXISTS task_comments (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE, author_id TEXT NOT NULL, body TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_task_comments_task ON task_comments(task_id);",

      # --- Government projects (bcl/13_gov_projects.bcl) ---------------------
      "CREATE TABLE IF NOT EXISTS user_org_units (user_id TEXT PRIMARY KEY, org_unit_id TEXT NOT NULL, assigned_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "INSERT OR IGNORE INTO user_org_units (user_id, org_unit_id) VALUES ('usr_manager_01', 'bagmati');",
      "INSERT OR IGNORE INTO user_org_units (user_id, org_unit_id) VALUES ('usr_officer_bagmati', 'bagmati');",
      "INSERT OR IGNORE INTO user_org_units (user_id, org_unit_id) VALUES ('usr_officer_koshi', 'koshi');",
      "INSERT OR IGNORE INTO user_org_units (user_id, org_unit_id) VALUES ('usr_officer_ktm', 'ktm');",
      "CREATE TABLE IF NOT EXISTS gov_projects (id INTEGER PRIMARY KEY AUTOINCREMENT, org_unit_id TEXT NOT NULL, org_path TEXT NOT NULL, title TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', budget_total REAL NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'proposed', start_date TEXT, end_date TEXT, created_by TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_gov_projects_path ON gov_projects(org_path);",
      "CREATE TABLE IF NOT EXISTS gov_budget_lines (id INTEGER PRIMARY KEY AUTOINCREMENT, project_id INTEGER NOT NULL REFERENCES gov_projects(id) ON DELETE CASCADE, code TEXT NOT NULL, amount REAL NOT NULL, note TEXT NOT NULL DEFAULT '', created_by TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_gov_budget_lines_project ON gov_budget_lines(project_id);",

      # --- Medical coding (bcl/14_medical_coding.bcl) ------------------------
      "CREATE TABLE IF NOT EXISTS encounters (id INTEGER PRIMARY KEY AUTOINCREMENT, patient_id TEXT NOT NULL, provider_id TEXT NOT NULL, dos_from TEXT NOT NULL, dos_to TEXT NOT NULL, dos_kind TEXT NOT NULL, days INTEGER NOT NULL, place_of_service TEXT, status TEXT NOT NULL DEFAULT 'pending', assigned_coder TEXT, created_by TEXT NOT NULL, coded_by TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_encounters_patient ON encounters(patient_id, provider_id, dos_from);",
      "CREATE INDEX IF NOT EXISTS idx_encounters_queue ON encounters(status, assigned_coder);",
      "CREATE TABLE IF NOT EXISTS encounter_lines (id INTEGER PRIMARY KEY AUTOINCREMENT, encounter_id INTEGER NOT NULL REFERENCES encounters(id) ON DELETE CASCADE, line_no INTEGER NOT NULL, dos TEXT NOT NULL, cpt TEXT NOT NULL, modifier TEXT, icd TEXT NOT NULL, units REAL NOT NULL);",
      "CREATE INDEX IF NOT EXISTS idx_encounter_lines_encounter ON encounter_lines(encounter_id, dos);"
    ]
  }
}

# --- Cache (SQL-backed, supports prefix invalidation) ----------------------
resource "cache" {
  kind "cache.sql"
  description "SQL-backed cache with prefix invalidation support"
  config {
    database "database"
    table "boilerplate_cache"
    gc_interval 5m
  }
}

# --- Session Store (File-backed) -------------------------------------------
resource "sessions" {
  kind "session.file"
  description "Signed session cookies backed by local file storage"
  config {
    dir env("SESSION_DIR", ".data/sessions")
    secret env("SESSION_SECRET", "super-secure-argon2id-boilerplate-secret-32-bytes")
    cookie "ref_boilerplate_sid"
    max_age 24h
    secure false
  }
}

# --- Authentication Provider -----------------------------------------------
resource "session_auth" {
  kind "auth.session"
  description "Resolves caller identity from the signed session cookie"
  config {
    session "sessions"
    roles_claim "roles"
  }
}

# --- Authorization Engine --------------------------------------------------
resource "authorization" {
  kind "authz.rbac"
  description "Role-based authorization engine with transitive inheritance"
  config {
    superuser_roles ["super_admin"]
    default_roles ["user"]
  }
}

# --- Coordination: Distributed Locks (SQL-backed) --------------------------
resource "locks" {
  kind "lock.store"
  description "Distributed advisory locks for coordination primitives"
  config {
    cache "cache"
    prefix "lock:"
    ttl 30s
  }
}

# --- Coordination: Rate Limiting (SQL-backed) ------------------------------
resource "limits" {
  kind "ratelimit.store"
  description "Token-bucket rate limiter backed by SQL"
  config {
    cache "cache"
    prefix "rate:"
  }
}

# --- Durable Queue (SQL-backed) --------------------------------------------
resource "jobs" {
  kind "queue.sql"
  description "Durable job queue for background work and scheduled tasks"
  config {
    database "database"
    table "boilerplate_jobs"
    workers 2
    poll_interval 500ms
  }
}

# --- Object Storage (Local Filesystem) ------------------------------------
resource "uploads" {
  kind "storage.fs"
  description "Local filesystem object storage for uploads"
  config {
    dir env("UPLOAD_DIR", ".data/uploads")
    max_object_bytes 10485760
  }
}

# --- Business Rules Engine ------------------------------------------------
resource "policy_engine" {
  kind "rules.engine"
  description "Compiled business logic policy decision engine"
  config {
    environment "development"
    default_tenant "default"
    strict_validation true
    request_timeout 5s
  }
}

# ===========================================================================
# Authentication Intents (Argon2id + Session Management)
#
# Every intent is a directed acyclic graph of nodes. The platform compiles
# each intent into an execution plan where nodes with satisfied dependencies
# run concurrently. The critical path determines latency — not the sum of
# every step.
#
# Node kinds: pure (no side effects), read (database reads), effect (writes),
# decision (can deny the request). Speculation levels control which nodes may
# run before identity is confirmed.
# ===========================================================================

# --- Registration -----------------------------------------------------------
intent "auth.register" {
  description "Register a new user account with Argon2id password hashing"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config {
      source_fact "input"
      shape "user"
    }
  }

  node "check-duplicate" {
    uses "database.query"
    resource "database"
    kind read
    speculation pre_auth_safe
    requires [input, validated]
    provides [existing_users]
    config {
      statement "SELECT id FROM users WHERE email = LOWER($1) LIMIT 1"
      args [input.email]
    }
  }

  # validate.expression rather than decision.expression: a decision action
  # records allow/deny but never publishes its provides fact, so a node that
  # required it never ran and every registration ended as a 403. "< 1"
  # rather than "== 0": the expression engine's == does not match len()'s
  # integer against a numeric literal.
  node "guard-duplicate" {
    uses "validate.expression"
    requires [existing_users]
    provides [not_duplicate]
    config {
      expression "len(existing_users) < 1"
      message "An account with this email already exists"
    }
  }

  node "hash-password" {
    uses "auth.password_hash"
    requires [input, not_duplicate]
    provides [password_hash]
    config {
      value_fact "input.password"
      algorithm "argon2id"
      memory 65536
      iterations 3
      parallelism 4
      min_length 8
    }
  }

  node "insert-user" {
    family database
    uses "database.query"
    resource "database"
    kind effect
    requires [input, password_hash]
    provides [users]
    config {
      statement "INSERT INTO users (id, email, name, password_hash, roles, status) VALUES (LOWER($1), LOWER($1), $2, $3, 'user', 'active') RETURNING id, email, name, password_hash, roles, status, created_at"
      args [input.email, input.name, password_hash]
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id, detail) VALUES ('user.registered', $1, $2)"
      args [input.email, input.email]
    }
  }

  # auth.login verifies the password against the row's password_hash (which
  # is why the INSERT returns it) and never copies the hash into the principal.
  node "login" {
    family auth
    uses "auth.login"
    resource "sessions"
    kind pure
    requires [input, users]
    provides [principal]
    config {
      user_fact "users"
      password_fact "input.password"
      roles_field "roles"
    }
  }

  node "response" {
    uses "collect"
    requires [principal, audit_logged]
    provides [response]
  }
}

# --- Login ------------------------------------------------------------------
# The response requires audit_logged: the plan only runs nodes the response
# (transitively) depends on, so an audit node nothing requires is pruned and
# the login never reaches the activity feed (bcl/15_activity.bcl).
intent "auth.login" {
  description "Verify credentials with Argon2id and create session"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config {
      source_fact "input"
      shape "login_input"
    }
  }

  node "find-user" {
    uses "database.query"
    resource "database"
    kind read
    speculation pre_auth_safe
    requires [input, validated]
    provides [users]
    config {
      statement "SELECT id, email, name, password_hash, roles, status FROM users WHERE email = LOWER($1) LIMIT 1"
      args [input.email]
    }
  }

  node "login" {
    uses "auth.login"
    resource "sessions"
    kind pure
    requires [input, users]
    provides [principal]
    config {
      user_fact "users"
      password_fact "input.password"
      roles_field "roles"
      disabled_field "status != 'active'"
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [principal]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id, detail, ip_address) VALUES ('auth.login', $1, 'Login successful', $2)"
      args [principal.id, input.ip]
    }
  }

  node "response" {
    uses "collect"
    requires [principal, audit_logged]
    provides [response]
  }
}

# --- Logout -----------------------------------------------------------------
intent "auth.logout" {
  description "Destroy session and clear cookie"
  response "response"

  node "require-user" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "logout" {
    uses "auth.logout"
    resource "sessions"
    kind effect
    requires [user_id]
    provides [logged_out]
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, logged_out]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id) VALUES ('auth.logout', $1)"
      args [user_id]
    }
  }

  node "response" {
    uses "collect"
    requires [logged_out, audit_logged]
    provides [response]
  }
}

# --- Forgot Password --------------------------------------------------------
intent "auth.forgot_password" {
  description "Create single-use password reset token"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.required"
    requires [input]
    provides [validated]
    config { fields [input.email] }
  }

  node "token" {
    uses "auth.reset_token"
    requires [validated]
    provides [reset_token]
    config { ttl 15m }
  }

  node "store-token" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input, reset_token]
    provides [token_stored]
    config {
      statement "INSERT INTO password_resets (token_hash, user_id, expires_at) SELECT $1, id, $2 FROM users WHERE email = LOWER($3)"
      args [reset_token.hash, reset_token.expires_at, input.email]
    }
  }

  node "response" {
    uses "collect"
    requires [reset_token, token_stored]
    provides [response]
  }
}

# --- Reset Password ---------------------------------------------------------
intent "auth.reset_password" {
  description "Consume reset token and update password with Argon2id"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config {
      source_fact "input"
      shape "password_reset_input"
    }
  }

  node "token-hash" {
    uses "auth.token_hash"
    requires [input, validated]
    provides [token_hash]
    config { value_fact "input.token" }
  }

  node "password-hash" {
    uses "auth.password_hash"
    requires [input, validated]
    provides [new_password_hash]
    config {
      value_fact "input.new_password"
      algorithm "argon2id"
      memory 65536
      iterations 3
      parallelism 4
      min_length 8
    }
  }

  node "consume-token" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [token_hash, new_password_hash]
    provides [password_reset]
    config {
      statement "UPDATE users SET password_hash = $1, updated_at = CURRENT_TIMESTAMP WHERE id = (SELECT user_id FROM password_resets WHERE token_hash = $2 AND expires_at > CURRENT_TIMESTAMP AND used_at IS NULL LIMIT 1)"
      args [new_password_hash, token_hash]
      require_affected true
      not_found_message "reset token is invalid or expired"
    }
  }

  node "mark-token-used" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [token_hash, password_reset]
    provides [token_consumed]
    config {
      statement "UPDATE password_resets SET used_at = CURRENT_TIMESTAMP WHERE token_hash = $1"
      args [token_hash]
    }
  }

  node "response" {
    uses "collect"
    requires [password_reset, token_consumed]
    provides [response]
  }
}

# --- Change Password (Authenticated) ----------------------------------------
intent "auth.change_password" {
  description "Verify current password and update to new Argon2id hash"
  response "response"
  timeout 5s

  node "user" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config {
      source_fact "input"
      shape "change_password_input"
    }
  }

  node "load-user" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id, validated]
    provides [user_rows]
    config {
      statement "SELECT password_hash FROM users WHERE id = $1 LIMIT 1"
      args [user_id]
    }
  }

  node "verify-current" {
    uses "auth.password_verify"
    kind pure
    requires [input, user_rows]
    provides [verified]
    config {
      password_fact "input.current_password"
      hash_fact "user_rows.0.password_hash"
    }
  }

  node "hash-new" {
    uses "auth.password_hash"
    requires [input, verified]
    provides [new_password_hash]
    config {
      value_fact "input.new_password"
      algorithm "argon2id"
      memory 65536
      iterations 3
      parallelism 4
      min_length 8
    }
  }

  node "update-password" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, new_password_hash]
    provides [password_updated]
    config {
      statement "UPDATE users SET password_hash = $1, updated_at = CURRENT_TIMESTAMP WHERE id = $2"
      args [new_password_hash, user_id]
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, password_updated]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id) VALUES ('auth.password_changed', $1)"
      args [user_id]
    }
  }

  node "response" {
    uses "collect"
    requires [password_updated, audit_logged]
    provides [response]
  }
}

# ===========================================================================
# Dashboard & Governance Intents
#
# These intents drive the dashboard views and admin operations. Each intent
# fetches data from the database and composes it for the template.
# ===========================================================================

# --- User Dashboard ---------------------------------------------------------
intent "dashboard.index" {
  description "Fetch dashboard overview for authenticated user"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "load-profile" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [profile_rows]
    config {
      statement "SELECT id, email, name, roles, status, created_at FROM users WHERE id = $1 LIMIT 1"
      args [user_id]
    }
  }

  node "profile" {
    uses "data.first"
    requires [profile_rows]
    provides [user]
    config { source_fact "profile_rows" }
  }

  node "user-count" {
    uses "database.query"
    resource "database"
    kind read
    requires [user]
    provides [count_rows]
    config {
      statement "SELECT COUNT(*) as count FROM users"
    }
  }

  node "payload" {
    uses "collect"
    requires [user, count_rows]
    provides [dashboard_data]
  }

  node "response" {
    uses "collect"
    requires [dashboard_data]
    provides [response]
  }
}

# --- Admin Portal -----------------------------------------------------------
intent "dashboard.admin" {
  description "Fetch user management table and system roles for admin portal"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "load-admin" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [admin_rows]
    config {
      statement "SELECT id, email, name, roles FROM users WHERE id = $1 LIMIT 1"
      args [user_id]
    }
  }

  node "admin-user" {
    uses "data.first"
    requires [admin_rows]
    provides [user]
    config { source_fact "admin_rows" }
  }

  node "load-all-users" {
    uses "database.query"
    resource "database"
    kind read
    requires [user]
    provides [users]
    config {
      statement "SELECT id, email, name, roles, status, created_at FROM users ORDER BY created_at DESC LIMIT 50"
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, users]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id, detail) VALUES ('admin.dashboard.viewed', $1, 'Admin portal accessed')"
      args [user_id]
    }
  }

  node "response" {
    uses "collect"
    requires [user, users, audit_logged]
    provides [response]
  }
}

# --- Admin Role Update (with Policy Guard) ----------------------------------
intent "dashboard.admin_update_role" {
  description "Update a user's role from admin portal with privilege escalation guard"
  response "response"
  timeout 5s

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [admin_id]
  }

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config {
      source_fact "input"
      shape "role_update_input"
    }
  }

  # The privilege-escalation guard is a node-level authz condition on the
  # write itself: it is evaluated before the statement runs and answers 403
  # with its message. (A decision.expression node publishes no fact, so a
  # node that required it never ran; and "&&"/"||" are not boolean operators
  # in the expression language — "and"/"or" are.)
  node "update-role" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [admin_id, input, validated]
    authz {
      condition "input.role != 'super_admin' and (input.user_id != 'admin@example.com' or input.role == 'admin')"
      message "Unauthorized privilege escalation: only super_admin can assign super_admin and primary admin cannot be demoted"
    }
    provides [role_updated]
    config {
      statement "UPDATE users SET roles = $1, updated_at = CURRENT_TIMESTAMP WHERE id = $2"
      args [input.role, input.user_id]
      require_affected true
      not_found_message "user not found"
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [admin_id, input, role_updated]
    provides [audit_logged]
    config {
      statement "INSERT INTO audit_log (action, actor_id, target_id, detail) VALUES ('admin.role.updated', $1, $2, $3)"
      args [admin_id, input.user_id, input.role]
    }
  }

  node "response" {
    uses "collect"
    requires [role_updated, audit_logged]
    provides [response]
  }
}

# --- Manager View -----------------------------------------------------------
intent "dashboard.manager" {
  description "Fetch operational reports for manager view"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "load-user" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [user_rows]
    config {
      statement "SELECT id, email, name, roles FROM users WHERE id = $1 LIMIT 1"
      args [user_id]
    }
  }

  node "user" {
    uses "data.first"
    requires [user_rows]
    provides [user]
    config { source_fact "user_rows" }
  }

  node "recent-audit" {
    uses "database.query"
    resource "database"
    kind read
    requires [user]
    provides [audit_events]
    config {
      statement "SELECT action, actor_id, target_id, detail, created_at FROM audit_log ORDER BY created_at DESC LIMIT 20"
    }
  }

  node "response" {
    uses "collect"
    requires [user, audit_events]
    provides [response]
  }
}

# --- User Profile -----------------------------------------------------------
intent "dashboard.profile" {
  description "Fetch user profile information"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "load-profile" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [profile_rows]
    config {
      statement "SELECT id, email, name, roles, status, created_at FROM users WHERE id = $1 LIMIT 1"
      args [user_id]
    }
  }

  node "profile" {
    uses "data.first"
    requires [profile_rows]
    provides [user]
    config { source_fact "profile_rows" }
  }

  node "response" {
    uses "collect"
    requires [user]
    provides [response]
  }
}

# --- CRUD: List Users with Pagination --------------------------------------
intent "dashboard.users_list" {
  description "Paginated user listing with search"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "list-users" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id, input]
    provides [users]
    config {
      statement "SELECT id, email, name, roles, status, created_at FROM users ORDER BY created_at DESC LIMIT $1 OFFSET $2"
      args [input.per_page, input.offset]
    }
  }

  node "total" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [count_rows]
    config {
      statement "SELECT COUNT(*) as total FROM users"
    }
  }

  node "response" {
    uses "collect"
    requires [users, count_rows]
    provides [response]
  }
}

# --- Audit Log Viewer -------------------------------------------------------
intent "dashboard.audit_log" {
  description "View recent audit log entries"
  response "response"

  node "user-id" {
    uses "auth.require_session"
    resource "sessions"
    kind decision
    provides [user_id]
  }

  node "load-audit" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id, input]
    provides [audit_entries]
    config {
      statement "SELECT id, action, actor_id, target_id, detail, ip_address, created_at FROM audit_log ORDER BY created_at DESC LIMIT $1"
      args [input.limit]
    }
  }

  node "response" {
    uses "collect"
    requires [audit_entries]
    provides [response]
  }
}

# ===========================================================================
# Web HTML Routes (Declarative Mapping to SPL Templates)
#
# Route-level declarations:
# - auth & session binding
# - role & permission authorization gates (fails closed)
# - rate limiting with token buckets
# - route audit logging with field redactions
# ===========================================================================

# --- Public Authentication Views -------------------------------------------
route "web.index" {
  method GET
  path "/"
  template "pages/auth/login"
  layout "layouts/auth"
  allow_anonymous true
}

route "web.login_page" {
  method GET
  path "/login"
  template "pages/auth/login"
  layout "layouts/auth"
  allow_anonymous true
}

route "web.login_action" {
  method POST
  path "/login"
  intent "auth.login"
  session "sessions"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 10
    window 1m
    message "Too many login attempts. Please wait a minute."
  }
  route_audit {
    action "auth.login.web"
    redact ["password"]
  }
}

route "web.register_page" {
  method GET
  path "/register"
  template "pages/auth/register"
  layout "layouts/auth"
  allow_anonymous true
}

route "web.register_action" {
  method POST
  path "/register"
  intent "auth.register"
  session "sessions"
  status 201
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 5
    window 1h
    message "Registration rate limit reached."
  }
  route_audit {
    action "auth.register.web"
    redact ["password"]
  }
}

route "web.forgot_password_page" {
  method GET
  path "/forgot-password"
  template "pages/auth/forgot_password"
  layout "layouts/auth"
  allow_anonymous true
}

route "web.forgot_password_action" {
  method POST
  path "/forgot-password"
  intent "auth.forgot_password"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 5
    window 15m
  }
}

route "web.reset_password_page" {
  method GET
  path "/reset-password"
  template "pages/auth/reset_password"
  layout "layouts/auth"
  allow_anonymous true
}

route "web.reset_password_action" {
  method POST
  path "/reset-password"
  intent "auth.reset_password"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 5
    window 15m
  }
  route_audit {
    action "auth.reset_password.web"
    redact ["new_password"]
  }
}

route "web.logout_action" {
  method POST
  path "/logout"
  intent "auth.logout"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
}

# --- Protected Views (Role & Permission Gates) -----------------------------
route "web.dashboard" {
  method GET
  path "/dashboard"
  intent "dashboard.index"
  template "pages/dashboard/index"
  layout "layouts/base"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["user", "manager", "admin", "super_admin"]
    authorizer "authorization"
  }
}

route "web.admin" {
  method GET
  path "/dashboard/admin"
  intent "dashboard.admin"
  template "pages/dashboard/admin"
  layout "layouts/base"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["admin", "super_admin"]
    authorizer "authorization"
  }
  route_audit {
    action "admin.portal.access"
  }
}

route "web.admin_role" {
  method POST
  path "/dashboard/admin/role"
  intent "dashboard.admin_update_role"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
  authz {
    roles ["admin", "super_admin"]
    authorizer "authorization"
  }
  route_audit {
    action "admin.role.update"
    include_request true
  }
}

route "web.manager" {
  method GET
  path "/dashboard/manager"
  intent "dashboard.manager"
  template "pages/dashboard/manager"
  layout "layouts/base"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["manager", "admin", "super_admin"]
    authorizer "authorization"
  }
}

route "web.profile" {
  method GET
  path "/profile"
  intent "dashboard.profile"
  template "pages/dashboard/profile"
  layout "layouts/base"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["user", "manager", "admin", "super_admin"]
    authorizer "authorization"
  }
}

route "web.change_password" {
  method POST
  path "/profile/password"
  intent "auth.change_password"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
  authz {
    roles ["user", "manager", "admin", "super_admin"]
    authorizer "authorization"
  }
  rate_limit {
    limiter "limits"
    limit 5
    window 15m
  }
  route_audit {
    action "auth.change_password.web"
    redact ["current_password", "new_password"]
  }
}

# ===========================================================================
