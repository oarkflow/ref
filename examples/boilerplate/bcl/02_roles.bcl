# ===========================================================================
# Enterprise RBAC Roles & Hierarchy Matrix
#
# Roles form an inheritance DAG. The platform's authz.rbac resource resolves
# the transitive closure once at load time, so a permission check at request
# time is a map lookup — never a graph walk. Cycles are rejected at compile
# time.
#
# Permissions ending in ":*" grant the whole namespace (e.g. "users:*"
# implies users:read, users:write, users:delete). The wildcard "*" grants
# everything — only super_admin should carry it.
# ===========================================================================

role "super_admin" {
  description "Unrestricted root administrator — bypasses all authorization checks"
  permissions ["*"]
}

role "admin" {
  description "System governance, user administration, and security audit"
  permissions [
    "admin:dashboard",
    "users:*",
    "roles:manage",
    "audit:read",
    "settings:read",
    "settings:write"
  ]
  inherits ["manager"]
}

role "manager" {
  description "Operations, metrics, reporting, and team oversight"
  permissions [
    "reports:read",
    "reports:write",
    "reports:export",
    "users:read",
    "teams:read",
    "teams:write"
  ]
  inherits ["user"]
}

role "user" {
  description "Standard authenticated platform member"
  permissions [
    "dashboard:view",
    "profile:view",
    "profile:update",
    "notifications:read"
  ]
  inherits ["guest"]
}

role "guest" {
  description "Public unauthenticated visitor — can only access public resources"
  permissions []
}
