  cache_control "private, no-store"
  authz {
    permissions ["tasks:approve"]
    authorizer "authorization"
  }
}

route "api.approvals.decide" {
  method POST
  path "/api/v1/approvals/:id/decide"
  intent "approvals.decide"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
  authz {
    permissions ["tasks:approve"]
    authorizer "authorization"
  }
  route_audit {
    action "api.tasks.approval"
    include_request true
  }
}

route "api.admin.tasks.flag_overdue" {
  method POST
  path "/api/v1/admin/tasks/flag-overdue"
  intent "tasks.flag_overdue"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
  authz {
    permissions ["tasks:admin"]
    authorizer "authorization"
  }
}

# --- Schedule -----------------------------------------------------------------
schedule "flag_overdue_tasks" {
  description "Hourly: stamp overdue on open tasks past their due date"
  cron "5 * * * *"
  timezone "UTC"
  queue "jobs"
  intent "tasks.flag_overdue"
  jitter 2m
}
