# ===========================================================================
# REST API Endpoints (JSON Responses)
#
# Production REST APIs declaring:
# - Parameter extraction & validation schemas
# - Rate limiting & idempotency
# - Role-based authorization gates
# - Structured audit trails
# ===========================================================================

route "api.auth.register" {
  method POST
  path "/api/v1/auth/register"
  intent "auth.register"
  session "sessions"
  status 201
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 10
    window 1h
  }
  route_audit {
    action "api.auth.register"
    redact ["password"]
  }
}

route "api.auth.login" {
  method POST
  path "/api/v1/auth/login"
  intent "auth.login"
  session "sessions"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 20
    window 15m
  }
  route_audit {
    action "api.auth.login"
    redact ["password"]
  }
}

route "api.auth.logout" {
  method POST
  path "/api/v1/auth/logout"
  intent "auth.logout"
  session "sessions"
  auth "session_auth"
  cache_control "no-store"
}

route "api.auth.forgot_password" {
  method POST
  path "/api/v1/auth/forgot-password"
  intent "auth.forgot_password"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 5
    window 15m
  }
}

route "api.auth.reset_password" {
  method POST
  path "/api/v1/auth/reset-password"
  intent "auth.reset_password"
  allow_anonymous true
  cache_control "no-store"
  rate_limit {
    limiter "limits"
    limit 5
    window 15m
  }
  route_audit {
    action "api.auth.reset_password"
    redact ["new_password"]
  }
}

route "api.me" {
  method GET
  path "/api/v1/me"
  intent "dashboard.profile"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["user", "manager", "admin", "super_admin"]
    authorizer "authorization"
  }
}

route "api.admin.users" {
  method GET
  path "/api/v1/admin/users"
  intent "dashboard.admin"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["admin", "super_admin"]
    authorizer "authorization"
  }
  route_audit {
    action "api.admin.users.list"
  }
}

route "api.admin.audit" {
  method GET
  path "/api/v1/admin/audit"
  intent "dashboard.audit_log"
  session "sessions"
  auth "session_auth"
  cache_control "private, no-store"
  authz {
    roles ["admin", "super_admin"]
    authorizer "authorization"
  }
}
