# ===========================================================================
# Platform Infrastructure Resources
# ===========================================================================

resource "database" {
  kind "database.sql"
  config {
    driver "sqlite"
    dsn env("DATABASE_URL", "file:.data/boilerplate.db?cache=shared&mode=rwc")
    max_open_connections 10
    max_idle_connections 2
    migrations [
      "CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, name TEXT NOT NULL, password_hash TEXT NOT NULL, roles TEXT NOT NULL DEFAULT 'user', status TEXT NOT NULL DEFAULT 'active', created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE TABLE IF NOT EXISTS password_resets (token_hash TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE, expires_at TIMESTAMPTZ NOT NULL, used_at TIMESTAMPTZ, created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP);",
      "CREATE INDEX IF NOT EXISTS idx_resets_user ON password_resets(user_id);",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_admin_01', 'admin@example.com', 'Alice Admin', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'admin', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_manager_01', 'manager@example.com', 'Bob Manager', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'manager', 'active');",
      "INSERT OR IGNORE INTO users (id, email, name, password_hash, roles, status) VALUES ('usr_user_01', 'user@example.com', 'Charlie User', '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg', 'user', 'active');",
      "UPDATE users SET password_hash = '$argon2id$v=19$m=65536,t=3,p=4$/eQZGdn1LlBDaLJJF7Q+Hw$f8boI7+C7bkL59d67yZoojy0/RVEW/ULcNOAP0f4RTg' WHERE email IN ('admin@example.com', 'manager@example.com', 'user@example.com');"
    ]
  }
}

resource "sessions" {
  kind "session.file"
  config {
    dir env("SESSION_DIR", ".data/sessions")
    secret env("SESSION_SECRET", "super-secure-argon2id-boilerplate-secret-32-bytes")
    cookie "ref_boilerplate_sid"
    max_age 24h
    secure false
  }
}

resource "session_auth" {
  kind "auth.session"
  description "Resolves caller identity from the signed session cookie"
  config {
    session "sessions"
    roles_claim "roles"
  }
}

resource "authorization" {
  kind "authz.rbac"
  description "Role-based authorization engine with inheritance"
  config {
    superuser_roles ["super_admin"]
    default_roles ["user"]
  }
}

resource "policy_engine" {
  kind "rules.engine"
  description "Compiled business logic policy decision engine via oarkflow/rules"
  config {
    environment "development"
    default_tenant "default"
    strict_validation true
    request_timeout 5s
  }
}
