####################################################################
# Casekit: a solution-agnostic case runner.
#
# One pipeline.cases resource serves every pipeline in this document. The
# routes and the browser UI know nothing about any particular solution: they
# read the catalog and render each pipeline's forms, stages, nodes and
# actions from the server's view model. Add a `pipeline` block and it
# appears in the UI; remove one and it is gone.
#
# Included pipelines:
#   onboarding  identity (KYC) onboarding: details, webcam liveness, officer
#               review. Returning customers are routed past liveness.
#   expense     expense approval: tiny claims auto-approve, mid-size claims
#               go to a manager, big ones to a director (stage routes).
####################################################################

name "casekit"
version "1"

resource "db" {
  kind "database.sql"
  config {
    driver env("CASEKIT_DB_DRIVER", "sqlite")
    dsn env("CASEKIT_DSN", "file:.data/casekit.db?_pragma=busy_timeout(5000)")
    # Reference data (providers, nurses, locations, CPT codes...) lives in these tables, not in this file.
    migration_files ["seed/reference.sql"]
    migrations [
      "CREATE TABLE IF NOT EXISTS inbox (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id TEXT NOT NULL, subject TEXT NOT NULL, body TEXT NOT NULL DEFAULT '', case_id TEXT NOT NULL DEFAULT '', case_number TEXT NOT NULL DEFAULT '', event TEXT NOT NULL DEFAULT '', severity TEXT NOT NULL DEFAULT 'info', at TEXT NOT NULL DEFAULT '', read INTEGER NOT NULL DEFAULT 0)",
      "CREATE INDEX IF NOT EXISTS inbox_user ON inbox (user_id, read, id)",
      "CREATE TABLE IF NOT EXISTS notifications (id INTEGER PRIMARY KEY AUTOINCREMENT, event TEXT NOT NULL, case_number TEXT NOT NULL, stage TEXT NOT NULL DEFAULT '', actor TEXT NOT NULL DEFAULT '', reason TEXT NOT NULL DEFAULT '', at TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)"
    ]
  }
}

# Durable queue: fires the SLA sweep on exactly one replica.
resource "jobs" {
  kind "queue.sql"
  config {
    database "db"
    table "casekit_jobs"
    workers 1
    poll_interval 1s
  }
}

resource "limits" {
  kind "ratelimit.store"
  config { cache "shared_cache" }
}

resource "shared_cache" {
  kind "cache.sql"
  config { database "db" table "casekit_cache" }
}

resource "jwt" {
  kind "auth.jwt"
  config {
    secret env.required("CASEKIT_JWT_SECRET")
    issuer "casekit"
    audience "casekit"
    ttl "15m"
  }
}

# Browser sign-in uses an opaque HttpOnly session cookie. Bearer JWTs remain
# available for service clients, but the browser never stores them in JS.
resource "sessions" {
  kind "session.sql"
  config {
    database "db"
    table "casekit_sessions"
    secret env.required("CASEKIT_SESSION_SECRET")
    cookie env("CASEKIT_SESSION_COOKIE", "__Host-casekit")
    max_age 1h
    secure env("CASEKIT_COOKIE_SECURE", "true")
  }
}

resource "session_auth" {
  kind "auth.session"
  config {
    session "sessions"
    subject_claim "user_id"
    roles_claim "roles"
    tenant_claim "tenant_id"
    scopes_claim "scopes"
    username_claim "username"
    email_claim "email"
    claims ["name", "org_units", "workspace_roles"]
  }
}

resource "web_auth" {
  kind "auth.chain"
  config { authenticators ["session_auth", "jwt"] }
}

# Workspaces: a health group, its facilities, and their departments. Their
# reference data (providers, nurses, CPT codes, locations, claim types) is not
# here: it comes from database tables through the "catalog" data source below.
resource "org" {
  kind "org.hierarchy"
  description "Health group > facility > department workspaces, with inherited reference data"
  config {
    levels ["organization", "facility", "department"]
    database "db"
    refresh_interval 5s
    # Units a person works in (and, with the admin role, administers) come from their token.
    assignment_claim "org_units"
    global_roles ["super_admin"]

    nodes [
      { id "himal" level "organization" name "Himal Health Group" },
      { id "city" parent "himal" level "facility" name "City General Hospital" },
      { id "city_er" parent "city" level "department" name "Emergency" },
      { id "city_card" parent "city" level "department" name "Cardiology" },
      { id "river" parent "himal" level "facility" name "Riverside Clinic" },
      { id "river_opd" parent "river" level "department" name "Outpatient" }
    ]

  }
}

# Reference data from data sources, mapped and filtered per workspace. Every
# set is a table in `db` (seed/reference.sql); point `db` at MySQL or Postgres, or
# a set at an HTTP API, and nothing else changes. A row's facility_id says which
# workspace owns it: the group's rows reach every facility, a facility's rows only
# that facility. In a filter {organization}, {facility} and {workspace} are the
# units of the case being filled in ({x?} may be missing), and any depends_on
# field is {its_name}. `attrs` exposes a column to depends_on/lookup_where,
# `upsert`/`remove` let a workspace admin change rows from the Workspace page.
resource "catalog" {
  kind "lookup.sources"
  config {
    database "db"
    sets [
      { name "specialties" type "sql"
        query "SELECT facility_id, code, label, sort FROM tbl_specialties"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_specialties (facility_id, code, label, sort) VALUES (?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort"]
        remove "DELETE FROM tbl_specialties WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "provider_types" type "sql"
        query "SELECT facility_id, code, label, sort FROM tbl_provider_types"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_provider_types (facility_id, code, label, sort) VALUES (?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort"]
        remove "DELETE FROM tbl_provider_types WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "facility_types" type "sql"
        query "SELECT facility_id, code, label, sort FROM tbl_facility_types"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_facility_types (facility_id, code, label, sort) VALUES (?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort"]
        remove "DELETE FROM tbl_facility_types WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "cpt_codes" type "sql"
        query "SELECT facility_id, code, label, sort, specialties FROM tbl_cpt_codes"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        attrs { specialty "specialties" }
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_cpt_codes (facility_id, code, label, sort, specialties) VALUES (?, ?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort", "attrs.specialty"]
        remove "DELETE FROM tbl_cpt_codes WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "providers" type "sql"
        query "SELECT facility_id, code, label, sort, specialties, provider_type FROM tbl_providers"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        attrs { specialty "specialties" provider_type "provider_type" }
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_providers (facility_id, code, label, sort, specialties, provider_type) VALUES (?, ?, ?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort", "attrs.specialty", "attrs.provider_type"]
        remove "DELETE FROM tbl_providers WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "nurses" type "sql"
        query "SELECT facility_id, code, label, sort FROM tbl_nurses"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_nurses (facility_id, code, label, sort) VALUES (?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort"]
        remove "DELETE FROM tbl_nurses WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] },

      { name "locations" type "sql"
        query "SELECT facility_id, code, label, sort FROM tbl_locations"
        value_field "code" label_field "label" owner_field "facility_id" sort "sort"
        filters [ { on "facility_id" op "in" value "{organization?},{facility?},{workspace}" } ]
        upsert "INSERT OR REPLACE INTO tbl_locations (facility_id, code, label, sort) VALUES (?, ?, ?, ?)"
        upsert_args ["workspace", "code", "label", "sort"]
        remove "DELETE FROM tbl_locations WHERE facility_id = ? AND code = ?"
        remove_args ["workspace", "code"] }
    ]
  }
}

# People who sign in with an email and password. An administrator invites each
# person into a workspace with the roles they play (nurse, coder, supervisor...);
# the invitation link lets them choose their password. The first administrator is
# created on an empty directory (CASEKIT_ADMIN_EMAIL / CASEKIT_ADMIN_PASSWORD).
resource "people" {
  kind "identity.users"
  config {
    database "db"
    token_issuer "jwt"
    admin_roles ["admin"]
    global_roles ["super_admin"]
    password_min_length 12
    max_failed_logins 5
    lockout "30m"
    bootstrap {
      email env("CASEKIT_ADMIN_EMAIL", "admin@casekit.local")
      password env("CASEKIT_ADMIN_PASSWORD", "")
      tenant "casekit"
      name "Group administrator"
      roles ["admin", "super_admin"]
      org_unit "himal"
    }
  }
}

resource "cases" {
  kind "pipeline.cases"
  config {
    lookup_resource "catalog"
    directory_resource "people"
    # Notifications land in each person's inbox (the bell in the sidebar).
    notify_channels {
      inbox "casekit.deliver"
    }
    org_resource "org"
    workspace_roles_claim "workspace_roles"
    database "db"
    allow_anonymous true
    signing_secret env.required("CASEKIT_SIGNING_SECRET")
    liveness_url env("CASEKIT_LIVENESS_URL", "")
    liveness_token env("CASEKIT_LIVENESS_TOKEN", "")
  }
}

pipeline "onboarding" {
  title "Identity onboarding"
  description "Verify who a customer is: details, a webcam liveness check, then officer review."
  number_format "KYC-{year}-{seq:5}"
  subject ["identity.email"]

  # Every stage inherits these unless it sets its own.
  suspend_roles ["officer", "manager", "director"]
  resume_roles  ["manager", "director"]
  info_roles    ["officer", "manager", "director"]
  # Admins take a stand when a deadline is missed: reset, reassign, extend, waive.
  admin_roles   ["admin"]

  worker "demo-officer"  { roles ["officer"] }
  worker "demo-officer2" { roles ["officer"] }
  worker "demo-admin"    { roles ["admin"] }

  # Every event of interest is recorded and could be forwarded (email, chat...).
  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }

  # The page shown before anyone starts.
  intro {
    title "Verify your identity"
    image "/static/img/onboarding.svg"
    image_alt "A person holding an ID card"
    content "<h3>What you need</h3><ul><li>Your name and email</li><li>A device with a camera</li><li>About 3 minutes</li></ul><p>We check you are a real person, then an officer reviews your details.</p>"
    button "Start verification"
    document "privacy" {
      title "Privacy notice"
      url "/static/docs/privacy.html"
    }
  }

  form "identity" {
    input "full_name" {
      label "Full name"
      kind text
      required true
      min_length 3
      max_length 200
      pii true
    }
    input "email" {
      label "Email"
      kind email
      required true
      pii true
      max_length 254
    }
    input "country" {
      label "Country"
      kind select
      options ["Nepal", "India", "Other"]
      required true
    }
  }
  form "officer" {
    input "notes" {
      label "Officer notes"
      kind textarea
      max_length 2000
      pii true
    }
  }

  stage "details" {
    title "Your details"
    public true
    page {
      group "who" {
        title "About you"
        forms ["identity"]
      }
    }
    summary {
      title "Check your details"
      description "Make sure everything is right before we continue. You cannot change it afterwards."
      button "Yes, continue"
    }
    action "submit" {
      label "Continue"
      outcome advance
    }
  }

  stage "liveness" {
    title "Liveness check"
    public true
    auto_advance true
    node "live" {
      title "Prove you are live"
      description "Follow the prompts in front of your camera."
      kind liveness
      challenges 2
      max_attempts 3
      challenge_ttl "2m"
    }
  }

  stage "review" {
    title "Officer review"
    roles ["officer"]
    claimable true
    require_start true
    sla {
      duration "4h"
      warn_before "1h"
      # notify: record why it was missed and tell the admins; they take the stand.
      on_breach "notify"
      notify ["role:admin"]
    }
    page {
      group "submitted" {
        title "Submitted"
        mode readonly
        forms ["identity"]
      }
      group "notes" {
        title "Notes"
        forms ["officer"]
      }
    }
    node "identity_ok" {
      title "Identity details look right"
      kind review
      forms ["identity"]
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }
}

pipeline "certificate" {
  title "Residence certificate"
  description "Request a certificate. An outside agent verifies your identity, an officer reviews, and you may be asked for more information before it is issued."
  number_format "CERT-{year}-{seq:5}"

  # How this workflow looks. Everything here is optional: leave `ui` out and
  # the host's basic layout is used. One flat brand colour, never a gradient.
  ui {
    brand "Civil Registry"
    accent "#0f766e"
    overview {
      mode console
      # three columns, left to right; a panel left out of every column is not shown
      column "facts" {
        width "280px"
        panels ["case", "stage", "actions"]
      }
      column "work" {
        width "1fr"
        panels ["stand", "next", "party", "certificate", "entries", "summary"]
      }
      column "record" {
        width "340px"
        panels ["log", "missed"]
      }
      panel "log" {
        title "Who did what, and how long it took"
      }
    }
    task {
      mode split
    }
  }

  suspend_roles ["officer", "manager"]
  resume_roles  ["manager"]
  info_roles    ["officer", "manager"]
  admin_roles   ["admin"]

  worker "demo-officer"  { roles ["officer"] }
  worker "demo-officer2" { roles ["officer"] }
  worker "demo-manager"  { roles ["manager"] }
  worker "demo-admin"    { roles ["admin"] }

  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }
  on "link.*"        { hook "casekit.record" }
  on "entry.*"       { hook "casekit.record" }

  intro {
    title "Request a residence certificate"
    image "/static/img/certificate.svg"
    image_alt "A certificate with a seal"
    content "<h3>How it works</h3><ol><li>You fill in your details and name who can verify you.</li><li>That person verifies your identity through a private link, with no account needed.</li><li>An officer reviews. If something is missing you will be asked, and you answer on this site.</li><li>A manager approves and your certificate is issued.</li></ol>"
    button "Request a certificate"
    document "privacy" {
      title "Privacy notice"
      url "/static/docs/privacy.html"
    }
  }

  form "request" {
    input "full_name" {
      label "Full name"
      kind text
      required true
      max_length 200
      pii true
    }
    input "email" {
      label "Email"
      kind email
      required true
      max_length 254
      pii true
    }
    input "address" {
      label "Address to certify"
      kind textarea
      required true
      max_length 1000
      pii true
    }
    input "purpose" {
      label "What is it for?"
      kind select
      options ["Bank", "Embassy", "Employment", "Other"]
      required true
    }
    input "kyc_agent" {
      label "Who will verify your identity?"
      kind text
      required true
      help "Name or email of the person (a ward officer, a notary) who knows you."
      max_length 200
      pii true
    }
  }
  form "kyc" {
    input "verified" {
      label "Is the applicant who they say they are?"
      kind select
      options ["Yes", "No"]
      required true
    }
    input "id_seen" {
      label "ID document seen"
      kind select
      options ["Citizenship card", "Passport", "Driving licence"]
      required true
    }
    input "agent_notes" {
      label "Notes"
      kind textarea
      max_length 4000
      pii true
    }
  }
  form "review" {
    input "needs_info" {
      label "More information is needed from the applicant"
      kind boolean
    }
    input "question" {
      label "What do you need from the applicant?"
      kind textarea
      visible_if "review.needs_info == true"
      required_if "review.needs_info == true"
      max_length 2000
    }
  }
  form "more" {
    input "answer" {
      label "Your answer"
      kind textarea
      required true
      max_length 4000
    }
    input "reference" {
      label "Supporting reference (document number, link)"
      kind text
      max_length 200
    }
  }

  # 1. The applicant (public) enters their request: one entry, editable, may be kept as a draft.
  stage "request" {
    title "Your request"
    public true
    page {
      group "request" {
        title "About you"
        forms ["request"]
      }
    }
    entries {
      per_user 1
      allow_edit true
      allow_draft true
    }
    summary {
      title "Check your request"
      description "Your verifier will be contacted next."
      button "Send request"
    }
    sla {
      duration "7d"
      warn_before "1d"
      # nobody finished it: the request is closed
      on_breach "expire"
    }
    action "submit" {
      label "Send request"
      outcome advance
    }
  }

  # 2. Someone outside the workflow (not a workflow user) verifies identity through a private link.
  stage "kyc" {
    title "Identity verification"
    view_roles ["officer", "manager"]
    page {
      group "kyc" {
        title "Verification"
        forms ["kyc"]
      }
    }
    external {
      party "KYC verifier"
      assignee_from "request.kyc_agent"
      ttl "5d"
    }
    sla {
      duration "3d"
      warn_before "1d"
      on_breach "notify"
      notify ["role:admin"]
    }
  }

  # 3. An officer reviews and may ask the applicant for more.
  stage "review" {
    title "Officer review"
    roles ["officer"]
    claimable true
    require_start true
    page {
      group "request" {
        title "Request"
        mode readonly
        forms ["request"]
        # the same form, rules for this stage: officers may correct the address,
        # the email is only shown to staff, and the label is reworded here
        access "request.address" {
          mode editable
          edit_roles ["officer"]
          label "Address to certify (officers may correct it)"
        }
        access "request.email" {
          roles ["officer", "manager", "admin"]
        }
      }
      group "kyc" {
        title "Verification result"
        mode readonly
        forms ["kyc"]
      }
      group "review" {
        title "Decision"
        forms ["review"]
      }
    }
    # this stage's task screen: decision form with checks, and a narrow rail on the right
    ui {
      column "main" {
        width "1fr"
        panels ["form", "checks"]
      }
      column "rail" {
        width "300px"
        panels ["stage"]
      }
    }
    route "needs_info" {
      when "review.needs_info == true"
      to "more_info"
    }
    route "clear" {
      to "approval"
    }
    sla {
      duration "4h"
      warn_before "1h"
      on_breach "notify"
      notify ["role:admin"]
    }
    action "submit" {
      label "Submit review"
      outcome advance
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  # 4. Only when the officer asked: the applicant answers, then the case moves on to approval.
  stage "more_info" {
    title "More information needed"
    public true
    page {
      group "ask" {
        title "What we need"
        mode readonly
        forms ["review"]
        # the applicant sees the question, not the officer's tick box
        access "review.needs_info" {
          mode hidden
        }
      }
      group "more" {
        title "Your answer"
        forms ["more"]
      }
    }
    entries {
      per_user 3
      min 1
      allow_edit true
      allow_draft true
    }
    sla {
      duration "3d"
      warn_before "1d"
      on_breach "expire"
    }
    action "submit" {
      label "Send my answer"
      outcome advance
    }
  }

  stage "approval" {
    title "Manager approval"
    roles ["manager"]
    claimable true
    require_start true
    page {
      group "request" {
        title "Request"
        mode readonly
        forms ["request"]
      }
      group "kyc" {
        title "Verification result"
        mode readonly
        forms ["kyc"]
        # the verifier's private notes are for managers and admins only
        access "kyc.agent_notes" {
          roles ["manager", "admin"]
        }
      }
    }
    sla {
      duration "8h"
      warn_before "2h"
      on_breach "reassign"
      reassign_roles ["manager"]
      notify ["role:admin"]
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  stage "issue" {
    title "Certificate issued"
    roles ["manager"]
    auto_advance true
    node "issue" {
      title "Issue the certificate"
      kind certificate
      certificate "residence"
      auto true
    }
  }

  certificate "residence" {
    title "Residence certificate"
    number_format "RC-{year}-{seq:4}"
    fields ["request.full_name", "request.address", "request.purpose"]
    validity "8760h"
  }
}

pipeline "encounter" {
  title "Encounter coding"
  description "A hospital or clinic records an encounter with its own providers, nurses and locations, then a coder picks the CPT codes that workspace allows."
  number_format "ENC-{year}-{seq:5}"

  # Runs inside a workspace: the facility the encounter belongs to decides which
  # providers, nurses, locations and CPT codes every form and field offers.
  workspace {
    level "facility"
    required true
    label "Facility"
  }

  suspend_roles ["coder", "supervisor"]
  resume_roles  ["supervisor"]
  info_roles    ["coder", "supervisor"]
  admin_roles   ["admin"]

  # How much data one person may create: at most 50 unfinished encounters at a time.
  limits {
    per_user 50
    count "open"
  }

  # Questions: a coder or supervisor may ask the nurse who recorded it, or anyone holding the
  # earlier step's role. The deadline clock stops until it is answered, which is due within a day.
  information {
    to ["creator", "previous"]
    sla "pause"
    due "24h"
    on_timeout "notify"
    fields true      # a question may ask for specific inputs, which are filled in and written into the case
  }

  # Releasing a hold: carry on, or send it back to the earlier step as new work, optionally to a named person.
  release {
    targets ["same", "previous"]
    assignee "optional"
    restore_data false
  }

  # Whoever records an encounter has started it; a step it returns to stays started.
  start {
    on_create "auto"
    on_return "keep"
  }

  # Tell people what is waiting for them, in their inbox.
  notify "case.information_requested" {
    to ["asked"]
    channels ["inbox"]
    severity warning
    subject "{case.number}: a question for you"
    message "Question: {info.reason}"
  }
  notify "case.information_submitted" {
    to ["asker"]
    channels ["inbox"]
    subject "{case.number}: your question was answered"
  }
  notify "case.information_overdue" {
    to ["asker", "asked"]
    channels ["inbox"]
    severity urgent
    subject "{case.number}: the answer is overdue"
    message "Still waiting on: {info.reason}"
  }
  notify "assigned" {
    to ["assignee"]
    channels ["inbox"]
    subject "{case.number}: assigned to you"
  }

  intro {
    title "Record an encounter"
    image "/static/img/encounter.svg"
    image_alt "A clinical record"
    content "<h3>Pick your facility first</h3><p>The providers, nurses, locations and billing codes you can choose are your own facility's. A coder then assigns CPT codes from the list that facility uses, and a supervisor signs off.</p>"
    button "Record an encounter"
  }

  on "stage.*" { hook "casekit.record" }
  on "case.*"  { hook "casekit.record" }
  on "sla.breached" { hook "casekit.record_why" }

  form "encounter" {
    input "patient_name" {
      label "Patient name"
      kind text
      required true
      max_length 200
      pii true
    }
    input "mrn" {
      label "Medical record number"
      kind text
      required true
      max_length 64
      pii true
    }
    input "service_date" {
      label "Date of service"
      kind date
      required true
      pii true
    }
    input "facility_type" {
      label "Claim type"
      kind select
      lookup "facility_types"
      required true
      help "The kinds of claim this facility codes."
    }
    input "specialty" {
      label "Specialty"
      kind select
      lookup "specialties"
      required true
    }
    input "provider" {
      label "Attending physician"
      kind select
      lookup "providers"
      lookup_where ["provider_type=physician"]
      depends_on ["specialty"]
      required true
      help "This facility's physicians for the chosen specialty."
    }
    input "resident" {
      label "Resident"
      kind select
      lookup "providers"
      lookup_where ["provider_type=resident"]
      depends_on ["specialty"]
    }
    input "secondary_provider" {
      label "Secondary provider"
      kind select
      lookup "providers"
      lookup_where ["provider_type=secondary"]
      depends_on ["specialty"]
    }
    input "billing_provider" {
      label "Billing provider"
      kind select
      lookup "providers"
      lookup_where ["provider_type=billing"]
      required true
    }
    input "nurse" {
      label "Nurse"
      kind select
      lookup "nurses"
      required true
    }
    input "location" {
      label "Location"
      kind select
      lookup "locations"
      required true
    }
  }
  form "coding" {
    input "cpt_codes" {
      label "CPT codes"
      kind multiselect
      lookup "cpt_codes"
      depends_on ["encounter.specialty"]
      required true
      help "The codes this facility bills for the encounter's specialty."
    }
    input "diagnosis" {
      label "Diagnosis"
      kind textarea
      required true
      max_length 4000
      pii true
    }
    input "tags" {
      label "Tags"
      kind multiselect
      options ["urgent", "needs review", "audit", "denial risk"]
      taggable true
      help "Pick a tag or type your own and press Enter."
    }
    input "coder_notes" {
      label "Notes"
      kind textarea
      max_length 4000
      pii true
    }
  }

  stage "intake" {
    title "Encounter intake"
    roles ["nurse"]
    require_start true
    page {
      group "encounter" {
        title "Encounter"
        forms ["encounter"]
      }
    }
    sla {
      duration "2h"
      warn_before "30m"
      on_breach "notify"
      notify ["role:admin"]
    }
    action "submit" {
      label "Send to coding"
      outcome advance
    }
  }

  stage "coding" {
    title "Coding"
    roles ["coder"]
    claimable true
    require_start true
    page {
      group "encounter" {
        title "Encounter"
        mode readonly
        forms ["encounter"]
      }
      group "coding" {
        title "Codes"
        forms ["coding"]
      }
    }
    sla {
      duration "8h"
      warn_before "2h"
      on_breach "notify"
      notify ["role:admin"]
    }
    action "submit" {
      label "Send for review"
      outcome advance
    }
  }

  stage "review" {
    title "Supervisor review"
    roles ["supervisor"]
    claimable true
    require_start true
    page {
      group "encounter" {
        title "Encounter"
        mode readonly
        forms ["encounter"]
      }
      group "coding" {
        title "Codes"
        mode readonly
        forms ["coding"]
      }
    }
    sla {
      duration "4h"
      warn_before "1h"
      on_breach "notify"
      notify ["role:admin"]
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Return to coder"
      outcome return
      return_to "coding"
      comment_required true
    }
  }
}

pipeline "expense" {
  title "Expense approval"
  description "Small claims are approved automatically; larger ones need a manager or a director."
  number_format "EXP-{year}-{seq:5}"

  # A tighter workflow: compact density, a main column with a rail, no stage strip,
  # and the history folded away until someone opens it.
  ui {
    density compact
    accent "#8a4b00"
    overview {
      mode split
      flow hide
      panel "log" {
        collapsed true
      }
    }
  }

  suspend_roles ["manager", "director"]
  resume_roles  ["director"]
  info_roles    ["manager", "director"]
  admin_roles   ["admin"]

  worker "demo-manager"  { roles ["manager"] }
  worker "demo-manager2" { roles ["manager"] }
  worker "demo-director" { roles ["director"] }
  worker "demo-admin"    { roles ["admin"] }

  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }

  intro {
    title "Submit an expense claim"
    image "/static/img/expense.svg"
    image_alt "A receipt"
    content "<p>Claims under 100 are approved automatically. Larger claims go to a manager, and claims of 5000 or more go to a director.</p><p>Keep your receipt number ready for anything of 100 or more.</p>"
    button "Start a claim"
  }

  form "claim" {
    input "title" {
      label "What is it for?"
      kind text
      required true
      max_length 200
    }
    input "amount" {
      label "Amount"
      kind integer
      required true
      min "1"
      max "1000000000"
    }
    input "category" {
      label "Category"
      kind select
      options ["Travel", "Equipment", "Training", "Other"]
      required true
    }
    input "receipt_no" {
      label "Receipt number"
      kind text
      required_if "claim.amount >= 100"
      visible_if "claim.amount >= 100"
      max_length 128
    }
  }

  stage "submit" {
    title "Submit claim"
    public true
    page {
      group "claim" {
        title "Claim"
        forms ["claim"]
      }
    }
    route "tiny" {
      when "claim.amount < 100"
      to "end"
    }
    route "big" {
      when "claim.amount >= 5000"
      to "director"
    }
    next "manager"
    summary {
      title "Review your claim"
      description "Check the amount and category. This is what the approver will see."
      button "Send claim"
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }

  stage "manager" {
    title "Manager approval"
    roles ["manager"]
    claimable true
    require_start true
    sla {
      duration "8h"
      warn_before "2h"
      # reassign: hand it to another manager automatically.
      on_breach "reassign"
      reassign_roles ["manager"]
      notify ["role:admin"]
    }
    page {
      group "claim" {
        title "Claim"
        mode readonly
        forms ["claim"]
      }
    }
    route "done" {
      to "end"
    }
    node "sign_off" {
      title "Manager sign-off"
      kind approval
      approvals 1
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  stage "director" {
    title "Director approval"
    roles ["director"]
    claimable true
    require_start true
    sla {
      duration "24h"
      warn_before "4h"
      on_breach "notify"
      notify ["role:admin"]
    }
    page {
      group "claim" {
        title "Claim"
        mode readonly
        forms ["claim"]
      }
    }
    node "sign_off" {
      title "Director sign-off"
      kind approval
      approvals 1
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }
}

