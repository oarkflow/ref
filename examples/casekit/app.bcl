# The workspaces of a level the caller may open cases in (their scope).
intent "casekit.workspaces" {
  response "r"
  node "r" {
    uses "org.query"
    resource "org"
    requires [input]
    provides [r]
    config {
      operation "level"
      level_fact "input.level"
    }
  }
}

# Add or change a facility (or department): admins only, inside their scope.
intent "casekit.org_save" {
  response "r"
  node "r" {
    uses "org.write"
    resource "org"
    kind effect
    requires [input]
    provides [r]
    config {
      operation "upsert"
      roles ["admin", "super_admin"]
    }
  }
}

intent "casekit.org_delete" {
  response "r"
  node "r" {
    uses "org.write"
    resource "org"
    kind effect
    requires [input]
    provides [r]
    config {
      operation "delete"
      roles ["admin", "super_admin"]
    }
  }
}

# The workspace tree the caller may see.
intent "casekit.workspace_tree" {
  response "r"
  node "r" {
    uses "org.query"
    resource "org"
    provides [r]
    config {
      operation "tree"
    }
  }
}

# Reference data of a workspace: every entry the workspace sees for a set, with where it comes from.
intent "casekit.lookup" {
  response "r"
  node "r" {
    uses "lookup.resolve"
    resource "org"
    requires [input]
    provides [r]
    config {
      set_fact "input.set"
      node_fact "input.node"
      include_disabled true
    }
  }
}

intent "casekit.lookup_write" {
  response "r"
  node "r" {
    uses "lookup.write"
    resource "org"
    kind effect
    requires [input]
    provides [r]
    config {
      operation "upsert"
      roles ["admin", "super_admin"]
    }
  }
}

intent "casekit.lookup_delete" {
  response "r"
  node "r" {
    uses "lookup.write"
    resource "org"
    kind effect
    requires [input]
    provides [r]
    config {
      operation "delete"
      roles ["admin", "super_admin"]
    }
  }
}

# What the data source behind lookup_resource yields for a workspace (read-only).
intent "casekit.lookup_sources" {
  response "r"
  node "r" {
    uses "pipeline.lookup_sources"
    resource "cases"
    requires [input]
    provides [r]
  }
}

# Messages for one person on the inbox channel: one row per item, so a digest of several cases
# becomes several inbox entries, each linking to its own case.
intent "casekit.deliver" {
  response "r"
  node "r" {
    uses "database.insert_many"
    resource "db"
    kind effect
    requires [input]
    provides [r]
    config {
      table "inbox"
      columns ["subject", "body", "case_id", "case_number", "event", "severity", "at"]
      rows "input.items"
      set { user_id "input.user" }
    }
  }
}

# The signed-in person's own inbox: every operation is scoped to them.
intent "casekit.inbox" {
  response "r"
  node "r" {
    uses "database.crud"
    resource "db"
    provides [r]
    config {
      operation "list"
      table "inbox"
      columns ["id", "subject", "body", "case_id", "case_number", "event", "severity", "at", "read"]
      owner_column "user_id"
      order_by "id"
      descending true
      limit 30
    }
  }
}

intent "casekit.inbox_read" {
  response "r"
  node "id" {
    uses "request.param"
    provides [id]
    config { name "id" }
  }
  node "r" {
    uses "database.crud"
    resource "db"
    kind effect
    requires [input, id]
    provides [r]
    config {
      operation "update"
      table "inbox"
      columns ["id", "read"]
      writable ["read"]
      owner_column "user_id"
      id_fact "id"
    }
  }
}

intent "casekit.login" {
  response "r"
  node "r" {
    uses "identity.login"
    resource "people"
    kind effect
    requires [input]
    provides [r]
    config {
      session "sessions"
      email_fact "input.email"
      password_fact "input.password"
      tenant_fact "input.tenant_id"
      code_fact "input.code"
      session_fields [
        { key "user_id" source "id" }
        { key "username" source "username" }
        { key "email" source "email" }
        { key "tenant_id" source "tenant_id" }
        { key "roles" source "roles" }
        { key "name" source "claims.name" optional true }
        { key "org_units" source "claims.org_units" optional true }
        { key "workspace_roles" source "claims.workspace_roles" optional true }
      ]
    }
  }
}

intent "casekit.me" {
  response "r"
  node "user_id" { uses "session.get" resource "sessions" provides [user_id] config { key "user_id" required true } }
  node "username" { uses "session.get" resource "sessions" provides [username] config { key "username" } }
  node "email" { uses "session.get" resource "sessions" provides [email] config { key "email" } }
  node "tenant_id" { uses "session.get" resource "sessions" provides [tenant_id] config { key "tenant_id" } }
  node "roles" { uses "session.get" resource "sessions" provides [roles] config { key "roles" } }
  node "name" { uses "session.get" resource "sessions" provides [name] config { key "name" } }
  node "org_units" { uses "session.get" resource "sessions" provides [org_units] config { key "org_units" } }
  node "workspace_roles" { uses "session.get" resource "sessions" provides [workspace_roles] config { key "workspace_roles" } }
  node "r" {
    uses "collect"
    requires [user_id, username, email, tenant_id, roles, name, org_units, workspace_roles]
    provides [r]
    config { unwrap true }
  }
}

intent "casekit.logout" {
  response "r"
  node "user" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "done" { uses "auth.logout" resource "sessions" kind effect requires [user_id] provides [done] }
  node "r" { uses "collect" requires [done] provides [r] config { unwrap true } }
}

intent "casekit.people" {
  response "r"
  node "r" {
    uses "identity.admin"
    resource "people"
    requires [input]
    provides [r]
    config {
      operation "list_users"
      input_fact "input"
      tenant_sources ["input.tenant_id", "request.tenant", "principal.tenant_id"]
      user_sources ["request.path.id", "request.path.user_id", "input.user_id"]
    }
  }
}

intent "casekit.invite" {
