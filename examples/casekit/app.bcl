}

# Event hook: keep a durable record of what happened and why.
intent "casekit.record" {
  response "recorded"
  node "recorded" {
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [recorded]
    config {
      statement "INSERT INTO notifications (event, case_number, stage, actor, at) VALUES ($1, $2, $3, $4, $5)"
      args ["input.event.name", "input.case.number", "input.event.stage", "input.event.actor", "input.event.at"]
    }
  }
}

# The breach and its resolution carry a reason (why the deadline was missed, how it was settled).
intent "casekit.record_why" {
  response "recorded"
  node "recorded" {
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [recorded]
    config {
      statement "INSERT INTO notifications (event, case_number, stage, actor, reason, at) VALUES ($1, $2, $3, $4, $5, $6)"
      args ["input.event.name", "input.case.number", "input.event.stage", "input.event.actor", "input.event.detail.reason", "input.event.at"]
    }
  }
}

intent "casekit.notifications" {
  response "rows"
  node "rows" {
    uses "database.query"
    resource "db"
    provides [rows]
    config {
      roles ["admin"]
      statement "SELECT event, case_number, stage, actor, reason, at FROM notifications ORDER BY id DESC LIMIT 100"
    }
  }
}

schedule "casekit_sweep" {
  every 1m
  queue "jobs"
  intent "cases.sweep"
  payload {
    reason "schedule"
  }
}

