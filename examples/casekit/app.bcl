  intent "cases.act"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "node" {
  method POST
  cache_control "no-store"
  max_body_bytes 33554432
  rate_limit { limiter "limits" limit 30 window "1m" }
  path "/api/cases/:id/stages/:stage/nodes/:node/:verb"
  intent "cases.node"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "work" {
  method POST
  cache_control "no-store"
  max_body_bytes 1048576
  rate_limit { limiter "limits" limit 30 window "1m" }
  path "/api/cases/:id/stages/:stage/work/:op"
