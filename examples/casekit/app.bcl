    provides [r]
  }
}

intent "cases.verify" {
  response "r"
  node "r" {
    uses "pipeline.verify"
    resource "cases"
    provides [r]
  }
}

route "catalog" {
  method GET
  path "/api/pipelines"
  intent "cases.catalog"
  auth "jwt"
  allow_anonymous true
}
route "describe" {
  method GET
  path "/api/pipelines/:pipeline"
  intent "cases.describe"
  auth "jwt"
  allow_anonymous true
}
route "start" {
  method POST
  path "/api/pipelines/:pipeline/cases"
  intent "cases.start"
  auth "jwt"
  allow_anonymous true
  status 201
  rate_limit {
    limiter "limits"
    limit 60
    window "1m"
  }
}
route "list" {
  method GET
  path "/api/cases"
  intent "cases.list"
  auth "jwt"
}
route "view" {
  method GET
  path "/api/cases/:id"
  intent "cases.view"
  auth "jwt"
  allow_anonymous true
}
route "view_stage" {
  method GET
  path "/api/cases/:id/stages/:stage"
  intent "cases.view"
  auth "jwt"
  allow_anonymous true
}
route "history" {
  method GET
  path "/api/cases/:id/history"
  intent "cases.get"
  auth "jwt"
  allow_anonymous true
}
route "save" {
  method PUT
  path "/api/cases/:id/stages/:stage"
  intent "cases.save"
  auth "jwt"
  allow_anonymous true
}
route "act" {
  method POST
  path "/api/cases/:id/stages/:stage/actions/:action"
  intent "cases.act"
  auth "jwt"
  allow_anonymous true
}
route "node" {
  method POST
  path "/api/cases/:id/stages/:stage/nodes/:node/:verb"
  intent "cases.node"
  auth "jwt"
  allow_anonymous true
}
route "work" {
  method POST
  path "/api/cases/:id/stages/:stage/work/:op"
  intent "cases.work"
  auth "jwt"
  allow_anonymous true
}
route "rfi" {
  method POST
  path "/api/cases/:id/information-request"
  intent "cases.rfi"
  auth "jwt"
  allow_anonymous true
}
route "answer" {
  method POST
  path "/api/cases/:id/information-response"
  intent "cases.answer"
  auth "jwt"
  allow_anonymous true
}
route "note" {
  method POST
  path "/api/cases/:id/notes"
  intent "cases.note"
  auth "jwt"
  allow_anonymous true
}
route "verify" {
  method GET
  path "/api/certificates/:key"
  intent "cases.verify"
  auth "jwt"
  allow_anonymous true
}

static "assets" {
  prefix "/static"
  root "static"
}

# ---- server-rendered pages (SPL templates) ---------------------------------
route "api.entry_new" {
  method POST
  path "/api/cases/:id/stages/:stage/entries"
  intent "cases.entry"
  auth "jwt"
  allow_anonymous true
}
route "api.entry_op" {
  method POST
  path "/api/cases/:id/stages/:stage/entries/:entry/:op"
  intent "cases.entry"
  auth "jwt"
  allow_anonymous true
}
route "api.link_view" {
  method GET
  path "/api/links/:token"
  intent "cases.link_view"
  allow_anonymous true
}
route "api.link_submit" {
  method POST
  path "/api/links/:token"
  intent "cases.link_submit"
  allow_anonymous true
}
route "page.link" {
  method GET
  path "/links/:token"
  title "Verification"
  template "pages/case"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}

route "api.overview" {
  method GET
  path "/api/cases/:id/overview"
  intent "cases.overview"
  auth "jwt"
  allow_anonymous true
}
route "api.notifications" {
  method GET
  path "/api/notifications"
  intent "casekit.notifications"
  auth "jwt"
}

route "page.home" {
  method GET
  path "/"
  intent "cases.catalog"
  title "Home"
  template "pages/home"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
route "page.intro" {
  method GET
  path "/start/:pipeline"
  intent "cases.describe"
  title "Start"
  template "pages/intro"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
route "page.guide" {
  method GET
  path "/guide"
  intent "cases.catalog"
  title "Guide"
  template "pages/guide"
  layout "layouts/base"
  allow_anonymous true
}
route "page.guide_detail" {
  method GET
  path "/guide/:pipeline"
  intent "cases.describe"
  title "Guide"
  template "pages/guide_detail"
  layout "layouts/base"
  allow_anonymous true
}
route "page.work" {
  method GET
  path "/work"
  title "My work"
  template "pages/work"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
route "page.case" {
  method GET
  path "/cases/:id"
  title "Case"
  template "pages/case"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
route "page.task" {
  method GET
  path "/tasks/:id"
  title "Task"
  template "pages/case"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
route "page.task_stage" {
  method GET
  path "/tasks/:id/:stage"
  title "Task"
  template "pages/case"
  layout "layouts/base"
  allow_anonymous true
  cache_control "no-store"
}
