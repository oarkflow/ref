####################################################################
# Casekit: a solution-agnostic case runner.
#
# One pipeline.cases resource serves every pipeline in this document. The
# routes and the browser UI know nothing about any particular solution: they
# read the catalog and render each pipeline's forms, stages, nodes and
# actions from the server's view model. Add a `pipeline` block and it
# appears in the UI; remove one and it is gone.
#
# Included pipelines:
#   onboarding  identity (KYC) onboarding: details, webcam liveness, officer
#               review. Returning customers are routed past liveness.
#   expense     expense approval: tiny claims auto-approve, mid-size claims
#               go to a manager, big ones to a director (stage routes).
####################################################################

name "casekit"
version "1"

resource "db" {
  kind "database.sql"
  config {
    driver env("CASEKIT_DB_DRIVER", "sqlite")
    dsn env("CASEKIT_DSN", "file:.data/casekit.db?_pragma=busy_timeout(5000)")
    migrations [
      "CREATE TABLE IF NOT EXISTS notifications (id INTEGER PRIMARY KEY AUTOINCREMENT, event TEXT NOT NULL, case_number TEXT NOT NULL, stage TEXT NOT NULL DEFAULT '', actor TEXT NOT NULL DEFAULT '', reason TEXT NOT NULL DEFAULT '', at TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP)"
    ]
  }
}

# Durable queue: fires the SLA sweep on exactly one replica.
resource "jobs" {
  kind "queue.sql"
  config {
    database "db"
    table "casekit_jobs"
    workers 1
    poll_interval 1s
  }
}

resource "limits" {
  kind "ratelimit.memory"
}

resource "jwt" {
  kind "auth.jwt"
  config {
    secret env.required("CASEKIT_JWT_SECRET")
  }
}

resource "cases" {
  kind "pipeline.cases"
  config {
    database "db"
    allow_anonymous true
    signing_secret env.required("CASEKIT_SIGNING_SECRET")
    liveness_url env("CASEKIT_LIVENESS_URL", "")
    liveness_token env("CASEKIT_LIVENESS_TOKEN", "")
  }
}

pipeline "onboarding" {
  title "Identity onboarding"
  description "Verify who a customer is: details, a webcam liveness check, then officer review."
  number_format "KYC-{year}-{seq:5}"
  subject ["identity.email"]

  # Every stage inherits these unless it sets its own.
  suspend_roles ["officer", "manager", "director"]
  resume_roles  ["manager", "director"]
  info_roles    ["officer", "manager", "director"]
  # Admins take a stand when a deadline is missed: reset, reassign, extend, waive.
  admin_roles   ["admin"]

  worker "demo-officer"  { roles ["officer"] }
  worker "demo-officer2" { roles ["officer"] }
  worker "demo-admin"    { roles ["admin"] }

  # Every event of interest is recorded and could be forwarded (email, chat...).
  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }

  # The page shown before anyone starts.
  intro {
    title "Verify your identity"
    image "/static/img/onboarding.svg"
    image_alt "A person holding an ID card"
    content "<h3>What you need</h3><ul><li>Your name and email</li><li>A device with a camera</li><li>About 3 minutes</li></ul><p>We check you are a real person, then an officer reviews your details.</p>"
    button "Start verification"
    document "privacy" {
      title "Privacy notice"
      url "/static/docs/privacy.html"
    }
  }

  form "identity" {
    input "full_name" {
      label "Full name"
      kind text
      required true
      min_length 3
    }
    input "email" {
      label "Email"
      kind email
      required true
      pii true
    }
    input "country" {
      label "Country"
      kind select
      options ["Nepal", "India", "Other"]
      required true
    }
    input "returning" {
      label "I have been verified here before"
      kind boolean
    }
  }
  form "officer" {
    input "notes" {
      label "Officer notes"
      kind textarea
    }
  }

  stage "details" {
    title "Your details"
    public true
    page {
      group "who" {
        title "About you"
        forms ["identity"]
      }
    }
    route "returning" {
      when "identity.returning == true"
      to "review"
    }
    summary {
      title "Check your details"
      description "Make sure everything is right before we continue. You cannot change it afterwards."
      button "Yes, continue"
    }
    action "submit" {
      label "Continue"
      outcome advance
    }
  }

  stage "liveness" {
    title "Liveness check"
    public true
    auto_advance true
    node "live" {
      title "Prove you are live"
      description "Follow the prompts in front of your camera."
      kind liveness
      challenges 2
      max_attempts 3
      challenge_ttl "2m"
    }
  }

  stage "review" {
    title "Officer review"
    roles ["officer"]
    claimable true
    require_start true
    sla {
      duration "4h"
      warn_before "1h"
      # notify: record why it was missed and tell the admins; they take the stand.
      on_breach "notify"
      notify ["role:admin"]
    }
    page {
      group "submitted" {
        title "Submitted"
        mode readonly
        forms ["identity"]
      }
      group "notes" {
        title "Notes"
        forms ["officer"]
      }
    }
    node "identity_ok" {
      title "Identity details look right"
      kind review
      forms ["identity"]
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }
}

pipeline "certificate" {
  title "Residence certificate"
  description "Request a certificate. An outside agent verifies your identity, an officer reviews, and you may be asked for more information before it is issued."
  number_format "CERT-{year}-{seq:5}"

  suspend_roles ["officer", "manager"]
  resume_roles  ["manager"]
  info_roles    ["officer", "manager"]
  admin_roles   ["admin"]

  worker "demo-officer"  { roles ["officer"] }
  worker "demo-officer2" { roles ["officer"] }
  worker "demo-manager"  { roles ["manager"] }
  worker "demo-admin"    { roles ["admin"] }

  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }
  on "link.*"        { hook "casekit.record" }
  on "entry.*"       { hook "casekit.record" }

  intro {
    title "Request a residence certificate"
    image "/static/img/certificate.svg"
    image_alt "A certificate with a seal"
    content "<h3>How it works</h3><ol><li>You fill in your details and name who can verify you.</li><li>That person verifies your identity through a private link, with no account needed.</li><li>An officer reviews. If something is missing you will be asked, and you answer on this site.</li><li>A manager approves and your certificate is issued.</li></ol>"
    button "Request a certificate"
    document "privacy" {
      title "Privacy notice"
      url "/static/docs/privacy.html"
    }
  }

  form "request" {
    input "full_name" {
      label "Full name"
      kind text
      required true
    }
    input "email" {
      label "Email"
      kind email
      required true
    }
    input "address" {
      label "Address to certify"
      kind textarea
      required true
    }
    input "purpose" {
      label "What is it for?"
      kind select
      options ["Bank", "Embassy", "Employment", "Other"]
      required true
    }
    input "kyc_agent" {
      label "Who will verify your identity?"
      kind text
      required true
      help "Name or email of the person (a ward officer, a notary) who knows you."
    }
  }
  form "kyc" {
    input "verified" {
      label "Is the applicant who they say they are?"
      kind select
      options ["Yes", "No"]
      required true
    }
    input "id_seen" {
      label "ID document seen"
      kind select
      options ["Citizenship card", "Passport", "Driving licence"]
      required true
    }
    input "agent_notes" {
      label "Notes"
      kind textarea
    }
  }
  form "review" {
    input "needs_info" {
      label "More information is needed from the applicant"
      kind boolean
    }
    input "question" {
      label "What do you need from the applicant?"
      kind textarea
      visible_if "review.needs_info == true"
      required_if "review.needs_info == true"
    }
  }
  form "more" {
    input "answer" {
      label "Your answer"
      kind textarea
      required true
    }
    input "reference" {
      label "Supporting reference (document number, link)"
      kind text
    }
  }

  # 1. The applicant (public) enters their request: one entry, editable, may be kept as a draft.
  stage "request" {
    title "Your request"
    public true
    page {
      group "request" {
        title "About you"
        forms ["request"]
      }
    }
    entries {
      per_user 1
      allow_edit true
      allow_draft true
    }
    summary {
      title "Check your request"
      description "Your verifier will be contacted next."
      button "Send request"
    }
    sla {
      duration "7d"
      warn_before "1d"
      # nobody finished it: the request is closed
      on_breach "expire"
    }
    action "submit" {
      label "Send request"
      outcome advance
    }
  }

  # 2. Someone outside the workflow (not a workflow user) verifies identity through a private link.
  stage "kyc" {
    title "Identity verification"
    view_roles ["officer", "manager"]
    page {
      group "kyc" {
        title "Verification"
        forms ["kyc"]
      }
    }
    external {
      party "KYC verifier"
      assignee_from "request.kyc_agent"
      ttl "5d"
    }
    sla {
      duration "3d"
      warn_before "1d"
      on_breach "notify"
      notify ["role:admin"]
    }
  }

  # 3. An officer reviews and may ask the applicant for more.
  stage "review" {
    title "Officer review"
    roles ["officer"]
    claimable true
    require_start true
    page {
      group "request" {
        title "Request"
        mode readonly
        forms ["request"]
      }
      group "kyc" {
        title "Verification result"
        mode readonly
        forms ["kyc"]
      }
      group "review" {
        title "Decision"
        forms ["review"]
      }
    }
    route "needs_info" {
      when "review.needs_info == true"
      to "more_info"
    }
    route "clear" {
      to "approval"
    }
    sla {
      duration "4h"
      warn_before "1h"
      on_breach "notify"
      notify ["role:admin"]
    }
    action "submit" {
      label "Submit review"
      outcome advance
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  # 4. Only when the officer asked: the applicant answers, then the case moves on to approval.
  stage "more_info" {
    title "More information needed"
    public true
    page {
      group "ask" {
        title "What we need"
        mode readonly
        forms ["review"]
      }
      group "more" {
        title "Your answer"
        forms ["more"]
      }
    }
    entries {
      per_user 3
      min 1
      allow_edit true
      allow_draft true
    }
    sla {
      duration "3d"
      warn_before "1d"
      on_breach "expire"
    }
    action "submit" {
      label "Send my answer"
      outcome advance
    }
  }

  stage "approval" {
    title "Manager approval"
    roles ["manager"]
    claimable true
    require_start true
    page {
      group "request" {
        title "Request"
        mode readonly
        forms ["request"]
      }
      group "kyc" {
        title "Verification result"
        mode readonly
        forms ["kyc"]
      }
    }
    sla {
      duration "8h"
      warn_before "2h"
      on_breach "reassign"
      reassign_roles ["manager"]
      notify ["role:admin"]
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  stage "issue" {
    title "Certificate issued"
    roles ["manager"]
    auto_advance true
    node "issue" {
      title "Issue the certificate"
      kind certificate
      certificate "residence"
      auto true
    }
  }

  certificate "residence" {
    title "Residence certificate"
    number_format "RC-{year}-{seq:4}"
    fields ["request.full_name", "request.address", "request.purpose"]
    validity "8760h"
  }
}

pipeline "expense" {
  title "Expense approval"
  description "Small claims are approved automatically; larger ones need a manager or a director."
  number_format "EXP-{year}-{seq:5}"

  suspend_roles ["manager", "director"]
  resume_roles  ["director"]
  info_roles    ["manager", "director"]
  admin_roles   ["admin"]

  worker "demo-manager"  { roles ["manager"] }
  worker "demo-manager2" { roles ["manager"] }
  worker "demo-director" { roles ["director"] }
  worker "demo-admin"    { roles ["admin"] }

  on "sla.breached"  { hook "casekit.record_why" }
  on "sla.resolved"  { hook "casekit.record_why" }
  on "sla.warning"   { hook "casekit.record" }
  on "sla.escalated" { hook "casekit.record" }
  on "stage.*"       { hook "casekit.record" }
  on "case.*"        { hook "casekit.record" }

  intro {
    title "Submit an expense claim"
    image "/static/img/expense.svg"
    image_alt "A receipt"
    content "<p>Claims under 100 are approved automatically. Larger claims go to a manager, and claims of 5000 or more go to a director.</p><p>Keep your receipt number ready for anything of 100 or more.</p>"
    button "Start a claim"
  }

  form "claim" {
    input "title" {
      label "What is it for?"
      kind text
      required true
    }
    input "amount" {
      label "Amount"
      kind integer
      required true
      min "1"
    }
    input "category" {
      label "Category"
      kind select
      options ["Travel", "Equipment", "Training", "Other"]
      required true
    }
    input "receipt_no" {
      label "Receipt number"
      kind text
      required_if "claim.amount >= 100"
      visible_if "claim.amount >= 100"
    }
  }

  stage "submit" {
    title "Submit claim"
    public true
    page {
      group "claim" {
        title "Claim"
        forms ["claim"]
      }
    }
    route "tiny" {
      when "claim.amount < 100"
      to "end"
    }
    route "big" {
      when "claim.amount >= 5000"
      to "director"
    }
    next "manager"
    summary {
      title "Review your claim"
      description "Check the amount and category. This is what the approver will see."
      button "Send claim"
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }

  stage "manager" {
    title "Manager approval"
    roles ["manager"]
    claimable true
    require_start true
    sla {
      duration "8h"
      warn_before "2h"
      # reassign: hand it to another manager automatically.
      on_breach "reassign"
      reassign_roles ["manager"]
      notify ["role:admin"]
    }
    page {
      group "claim" {
        title "Claim"
        mode readonly
        forms ["claim"]
      }
    }
    route "done" {
      to "end"
    }
    node "sign_off" {
      title "Manager sign-off"
      kind approval
      approvals 1
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }

  stage "director" {
    title "Director approval"
    roles ["director"]
    claimable true
    require_start true
    sla {
      duration "24h"
      warn_before "4h"
      on_breach "notify"
      notify ["role:admin"]
    }
    page {
      group "claim" {
        title "Claim"
        mode readonly
        forms ["claim"]
      }
    }
    node "sign_off" {
      title "Director sign-off"
      kind approval
      approvals 1
    }
    action "approve" {
      label "Approve"
      outcome approve
    }
    action "reject" {
      label "Reject"
      outcome reject
      comment_required true
    }
  }
}

intent "cases.catalog" {
  response "r"
  node "r" {
    uses "pipeline.catalog"
    resource "cases"
    provides [r]
  }
}

intent "cases.describe" {
  response "r"
  node "r" {
    uses "pipeline.describe"
    resource "cases"
    provides [r]
  }
}

intent "cases.start" {
  response "r"
  node "r" {
    uses "pipeline.start"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.list" {
  response "r"
  node "r" {
    uses "pipeline.list"
    resource "cases"
    provides [r]
  }
}

intent "cases.view" {
  response "r"
  node "r" {
    uses "pipeline.view"
    resource "cases"
    provides [r]
  }
}

intent "cases.get" {
  response "r"
  node "r" {
    uses "pipeline.get"
    resource "cases"
    provides [r]
  }
}

intent "cases.save" {
  response "r"
  node "r" {
    uses "pipeline.save"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.act" {
  response "r"
  node "r" {
    uses "pipeline.act"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.node" {
  response "r"
  node "r" {
    uses "pipeline.node"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.entry" {
  response "r"
  node "r" {
    uses "pipeline.entry"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.link_view" {
  response "view"
  node "view" {
    uses "pipeline.link_view"
    resource "cases"
    provides [view]
  }
}

intent "cases.link_submit" {
  response "result"
  node "result" {
    uses "pipeline.link_submit"
    resource "cases"
    kind effect
    requires [input]
    provides [result]
  }
}

intent "cases.overview" {
  response "r"
  node "r" {
    uses "pipeline.overview"
    resource "cases"
    requires [input]
    provides [r]
  }
}

intent "cases.sweep" {
  response "result"
  node "result" {
    uses "pipeline.sweep"
    resource "cases"
    kind effect
    provides [result]
  }
}

# Event hook: keep a durable record of what happened and why.
intent "casekit.record" {
  response "recorded"
  node "recorded" {
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [recorded]
    config {
      statement "INSERT INTO notifications (event, case_number, stage, actor, at) VALUES ($1, $2, $3, $4, $5)"
      args ["input.event.name", "input.case.number", "input.event.stage", "input.event.actor", "input.event.at"]
    }
  }
}

# The breach and its resolution carry a reason (why the deadline was missed, how it was settled).
intent "casekit.record_why" {
  response "recorded"
  node "recorded" {
    uses "database.exec"
    resource "db"
    kind effect
    requires [input]
    provides [recorded]
    config {
      statement "INSERT INTO notifications (event, case_number, stage, actor, reason, at) VALUES ($1, $2, $3, $4, $5, $6)"
      args ["input.event.name", "input.case.number", "input.event.stage", "input.event.actor", "input.event.detail.reason", "input.event.at"]
    }
  }
}

intent "casekit.notifications" {
  response "rows"
  node "rows" {
    uses "database.query"
    resource "db"
    provides [rows]
    config {
      roles ["admin"]
      statement "SELECT event, case_number, stage, actor, reason, at FROM notifications ORDER BY id DESC LIMIT 100"
    }
  }
}

schedule "casekit_sweep" {
  every 1m
  queue "jobs"
  intent "cases.sweep"
  payload {
    reason "schedule"
  }
}

intent "cases.work" {
  response "r"
  node "r" {
    uses "pipeline.work"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.rfi" {
  response "r"
  node "r" {
    uses "pipeline.request_information"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.answer" {
  response "r"
  node "r" {
    uses "pipeline.submit_information"
    resource "cases"
    kind effect
    requires [input]
    provides [r]
  }
}

intent "cases.note" {
  response "r"
  node "r" {
    uses "pipeline.note"
    resource "cases"
    kind effect
