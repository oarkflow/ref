  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "answer" {
  method POST
  cache_control "no-store"
  max_body_bytes 1048576
  rate_limit { limiter "limits" limit 30 window "1m" }
  path "/api/cases/:id/information-response"
  intent "cases.answer"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "note" {
  method POST
  cache_control "no-store"
  max_body_bytes 1048576
  rate_limit { limiter "limits" limit 30 window "1m" }
  path "/api/cases/:id/notes"
  intent "cases.note"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "verify" {
  method GET
