route "catalog" {
  method GET
  path "/api/pipelines"
  intent "cases.catalog"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "describe" {
  method GET
  path "/api/pipelines/:pipeline"
  intent "cases.describe"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
}
route "start" {
  method POST
  max_body_bytes 1048576
  path "/api/pipelines/:pipeline/cases"
  intent "cases.start"
  auth "web_auth"
  session "sessions"
  allow_anonymous true
  status 201
  rate_limit {
    limiter "limits"
    limit 10
    window "1m"
  }
}
route "list" {
  method GET
  cache_control "no-store"
  path "/api/cases"
  intent "cases.list"
  auth "web_auth"
  session "sessions"
}
route "view" {
  method GET
  rate_limit { limiter "limits" limit 60 window "1m" }
  cache_control "no-store"
