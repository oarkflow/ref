# Copy to .env (git-ignored). Real environment variables take precedence.
CASEKIT_JWT_SECRET=change-me-at-least-32-random-characters
CASEKIT_SIGNING_SECRET=change-me-another-32-random-characters
# A real faceworker is required for liveness nodes (use -demo for a stub):
CASEKIT_LIVENESS_URL=http://127.0.0.1:9100
CASEKIT_LIVENESS_TOKEN=change-me
