# ===========================================================================
# Business rule — github.com/oarkflow/rules, wired into ref/platform's core
# (platform/resources_rules_engine.go's "rules.engine" resource and
# "rules.evaluate" action — no Go code, this file and one BCL node is the
# whole integration).
#
# This is a separate policy dialect from bcl/*.bcl (rules' own
# module/decision_schema/decision_table blocks, not ref's
# resource/intent/route), published by "policy_engine" in
# bcl/01_resources.bcl and evaluated from orders.create
# (bcl/09_workflow_example.bcl)'s "policy" node.
#
# Why this exists as a *separate* layer from orders.create's own
# flow.branch tier classification (large/small at $500) and its
# decision.table status machine: those are inline in the application
# document, redeployed with everything else. A real self-service cap like
# this — "orders over $5,000 need manual approval" — is a business policy a
# compliance or ops team changes on its own schedule, wants versioned and
# rollback-able independent of a code deploy (rules.Service.Activate /
# Rollback), and wants a clear allow/deny + reason_code an API response can
# surface verbatim. decision.table can express the same condition, but
# gives you none of that lifecycle — that lifecycle is the actual reason to
# reach for a second engine here, not the condition itself.
#
# Why this file lives at rules/orders/policy.bcl, not rules/order_policy.bcl:
# "policy_engine"'s `dir "./rules"` config (bcl/01_resources.bcl) scans
# recursively and names each definition after its own path — this becomes
# definition "orders.policy" (see the "policy" node's `config { definition
# "orders.policy" }`). A product with many independent policies gets one
# nested directory per domain instead of a definition block per file;
# `_schema.bcl` next to this one is the shared piece this file imports,
# proving both the nesting and the composition, not just the directory scan.
# ===========================================================================

bcl { version "1.0" }

import "./_schema.bcl"

# One numeric row plus `default allow` covers both branches; a second row
# for the complement (`input.amount <= 5000`) trips the engine's
# overlapping-numeric-rule check even when the two are mathematically
# exhaustive, since it does not prove that itself — `default` is the
# engine's own way to say "everything else", and is exactly what it is
# for here.
decision_table "approval" {
  default allow
  hit_policy first

  row "over-self-service-cap" {
    when { input.amount > 5000 }
    then { decision deny reason "orders over $5,000 need manual approval; contact support" }
    reason "orders over $5,000 need manual approval; contact support"
    reason_code "AMOUNT_OVER_CAP"
  }
}
