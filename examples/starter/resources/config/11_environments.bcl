# ===========================================================================
# Environment overlays
#
# `environment env("APP_ENV", "development")` (resources/config/00_app.bcl) is one
# informational string a handful of checks branch on (crypto.signer's
# ephemeral-key refusal in platform/resources_signer.go, for one). For
# actually CHANGING a resource's configuration per environment, BCL has its
# own native mechanism — no filename convention, no code change: a
# `profile` block, applied only when platform.LoadOptions.Profile matches
# (cmd/server/main.go sets it from the same APP_ENV).
#
# A profile's `override "<type>.<name>" { ... }` merges its body into that
# block's existing config — only the keys you list change; everything else
# in resources/config/01_resources.bcl stays as declared. A top-level key inside the
# profile (not "override") would merge directly into the document itself,
# e.g. a different `version`.
# ===========================================================================

profile "production" {
  # HTTPS-only cookies. resources/config/01_resources.bcl's default (secure false) is
  # correct for `go run` over plain HTTP; a real deployment behind TLS
  # should not send the session cookie over an unencrypted connection.
  override "resource.sessions" {
    secure "true"
  }

  # No loopback/private-network deliveries once this is a real deployment:
  # NOTIFY_URL should point at a real service, and a private address
  # getting through would mean an SSRF guard silently doing nothing.
  override "resource.notifications" {
    allow_private_networks "false"
  }
}

# Run with the override active:
#   APP_ENV=production ... go run ./cmd/server
# Confirm it applied — this prints "true" only under the profile above:
#   grep secure resources/config/01_resources.bcl   # shows the *unmodified* source; the
#                                       # override only ever exists at compile time.
