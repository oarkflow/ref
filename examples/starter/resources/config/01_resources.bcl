# ===========================================================================
# Infrastructure
#
# Every backend this document uses is declared here, and every one of them
# defaults to the variant that is correct when this process runs alongside
# other replicas: `session.sql`, `cache.sql` and `queue.sql` — not the
# `.memory`/`.file` variants — all riding on the one `database` resource so
# a product this size needs no second datastore. See CONFIGURATION.md for
# what each kind means and the failure you get for the wrong choice.
#
# Swapping SQLite for PostgreSQL in production is a two-line change: the
# `driver`/`dsn` below, plus one blank import in cmd/server/main.go (already
# there, commented, for exactly this). No other file changes.
#
# Schema is owned by cmd/migrator, not by this resource: `AUTOINCREMENT`
# (SQLite) and `SERIAL` (PostgreSQL) have no spelling both accept, and
# hand-branching every dialect-sensitive statement in a BCL ternary (an
# earlier version of this file did exactly that) doesn't scale past the
# first such column. `../migrations/*.bcl`, applied with
# `go run ./cmd/migrator migrate`, describes the schema once and lets
# github.com/oarkflow/migrate generate the dialect-correct DDL. See
# CONFIGURATION.md's "Schema migrations" section.
# ===========================================================================

resource "database" {
  kind "database.sql"
  description "Users, sessions, jobs and the cache all live in one database — add a second only when you actually need one"
  config {
    driver env("DB_DRIVER", "sqlite")
    dsn env("DB_DSN", "file:.data/starter/app.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)")
    max_open_connections env("DB_MAX_OPEN_CONNECTIONS", "20")
    max_idle_connections env("DB_MAX_IDLE_CONNECTIONS", "5")
    connection_max_lifetime 30m
    # ping defaults to true as of this starter: an unreachable database is a
    # startup failure here, never a surprise on the first request. Set
    # `ping false` only for a throwaway :memory: database in a test.
    #
    # journal_mode(WAL) is load-tested, not just copied from a tutorial:
    # without it, a `hey -c 50` burst against an authenticated, DB-backed
    # route reliably produced sporadic "disk I/O error"/500s under SQLite's
    # default rollback-journal mode (readers and the writer blocking each
    # other under concurrency busy_timeout alone doesn't fully resolve).
    # With WAL, the same burst ran clean with no errors and roughly 3x the
    # throughput and a third of the p99 latency. Irrelevant once DB_DRIVER
    # is pgx (PostgreSQL has no such mode/setting to mirror).
    #
    # No `migrations` list here — run `go run ./cmd/migrator migrate`
    # before starting the server (once per schema change, not once per
    # process boot). starter_test.go's test harness does the same, against
    # its own temporary database, before compiling this document.
  }
}

# Shared cache. cache.sql is the multi-replica-safe default (as opposed to
# cache.memory, which is per-process — see CONFIGURATION.md and the startup
# warning the platform itself now gives you if you use a per-process
# resource in a multi-replica document).
resource "cache" {
  kind "cache.sql"
  config { database "database" }
}

# Rate limiting, layered over the same cache so a limit is shared across
# every replica rather than reset per instance.
resource "limits" {
  kind "ratelimit.store"
  config { cache "cache" }
}

# Durable, multi-replica-safe job queue. Every worker in 05_workers.bcl and
# every schedule in 06_schedules.bcl reads from this one queue.
resource "jobs" {
  kind "queue.sql"
  config { database "database" workers 2 max_attempts 5 }
}

# Signed session cookies. session.sql (not session.file) so every replica
# behind a load balancer sees the same session state.
resource "sessions" {
  kind "session.sql"
  config {
    database "database"
    secret env.required("SESSION_SECRET")
    cookie "starter_sid"
    max_age 24h
    secure env("SESSION_COOKIE_SECURE", "false")
  }
}

# Resolves the caller's principal (id, roles) from the signed session
# cookie. Every protected route names this as its `auth`.
resource "session_auth" {
  kind "auth.session"
  config { session "sessions" roles_claim "roles" }
}

# Role-based authorization. `superuser_roles` only bypasses an `authz {
# permissions [...] }` check (via this resource's own HasPermission) — a
# route or group's `authz { roles [...] }` is a literal membership check
# with no bypass, checked directly against the principal's roles
# (platform/actions_decision.go's authzGate.evaluate), never consulting this
# resource at all. See CONFIGURATION.md's "RBAC: what superuser_roles
# actually does" — this comment used to claim the opposite, which is
# exactly the bug 04_routes.bcl's route_group "api" hit (see its comment).
resource "authorization" {
  kind "authz.rbac"
  config {
    superuser_roles ["admin"]
    default_roles ["user"]
  }
}

# Outbound delivery target for notify.welcome (03_intents.bcl) — the intent
# reused across a route, a worker, a schedule and a webhook trigger. Point
# it at a real notification service; the default is a loopback echo for
# local development, refused by allow_private_networks in production.
resource "notifications" {
  kind "service.http"
  config {
    timeout 10s
    max_response_bytes 1048576
    allowed_hosts env("NOTIFY_HOST", "127.0.0.1")
    allow_private_networks env("NOTIFY_ALLOW_PRIVATE", "true")
  }
}

# Circuit breaker over the one outbound dependency this app calls
# (notifications). `cache` (not a dedicated store) so the breaker's state is
# shared across every replica the same way sessions/rate limits already
# are — a breaker that only one replica sees is not protecting the
# dependency from the other replicas' traffic. After 5 consecutive
# failures the circuit opens for 30s (refusing calls immediately, not
# waiting out each one's own timeout) then admits one probe; see
# 03_intents.bcl's notify.welcome and notification.password_reset for the
# guard-before/record-after pattern around their "deliver" node.
resource "delivery_breaker" {
  kind "circuit_breaker.store"
  config {
    cache "cache"
    failure_threshold 5
    reset_after 30s
  }
}

# Network/API abuse-detection perimeter guard (github.com/oarkflow/tcpguard,
# wired into ref/platform's core — platform/resources_security.go). Declaring
# this resource is the only wiring needed: platform/routes.go's serve()
# evaluates every request through it before authentication runs. The policy
# itself — its own BCL dialect, not this one — lives in
# resources/security/, a sibling of this file's own resources/config/
# rather than inside it, since it is not an application document ref
# compiles. Like the sqlite DSN in "database" above, this path is resolved
# against the process's working directory, not this file's — run from
# examples/starter (as every command in this starter's README does), the
# same way `.data/starter/app.db` above already assumes.
resource "guard" {
  kind "security.tcpguard"
  config {
    path "./resources/security"
    mode env("GUARD_MODE", "enforce")
    # Populates the per-account half of resources/security/rules/
    # auth-abuse-velocity.bcl's check (abuse.auth.user_failures) from the
    # request body's "email" field — auth.login's own shape
    # (resources/config/02_shapes.bcl's login_input) — so a credential-
    # stuffing attack spread across many IPs against ONE account is still
    # caught, not just a single-IP brute force.
    identity_fields ["email"]
  }
}

# Business-rules engine (github.com/oarkflow/rules, core ref/platform's
# "rules.engine" resource). `dir` scans resources/rules recursively and
# publishes one definition per ".bcl" file found, named by its path
# (resources/rules/orders/policy.bcl becomes definition "orders.policy") —
# a product with many independent policies gets one nested directory per
# domain instead of a `definition` block per file; an underscore-prefixed
# file (resources/rules/orders/_schema.bcl) is a fragment another file
# `import`s, not a definition of its own. See resources/rules/orders/
# policy.bcl for what's published here and why it's a separate layer from
# orders.create's own flow.branch/decision.table; see
# 09_workflow_example.bcl's "policy" node for where it's evaluated.
resource "policy_engine" {
  kind "rules.engine"
  config {
    environment env("APP_ENV", "development")
    dir "./resources/rules"
  }
}

# Durable process store for resources/config/12_todo_workflow_example.bcl's
# `process "todo.workflow"` — runs, step states, timers and human tasks, all
# on the same `database` resource (table_prefix keeps them out of the
# app's own tables, the same convention `store.sql` uses everywhere else in
# this platform). The process reuses the *existing* `jobs` queue above
# rather than declaring a second one — see that file's own header comment.
resource "todo_runs" {
  kind "store.sql"
  description "Durable process rows, steps, timers and tasks for the todo workflow example"
  config { database "database" table_prefix "todo_process" }
}
