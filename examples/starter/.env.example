# Copy this file to .env and fill in real values for local development.
# .env is loaded automatically by cmd/server/main.go (see dotenv.go) — a
# real environment variable (from your shell, Docker, CI, ...) always wins
# over a value set here, so committing this file is safe; committing your
# own .env with real secrets in it is not — .env is gitignored on purpose.

# --- Required ---------------------------------------------------------------
SESSION_SECRET=change-me-to-32-plus-random-bytes-eg-openssl-rand-hex-32
WEBHOOK_SECRET=change-me-to-a-different-32-plus-random-bytes

# --- Host bootstrap (cmd/server/main.go's Bootstrap) ------------------------
PORT=8080
APP_ENV=development
# APP_VERSION=0.1.0
# REPLICA_ID=
LOG_LEVEL=info
MAINTENANCE=false
# LOG_WEBHOOK_URL=
# LOG_WEBHOOK_AUTH=

# --- Database (bcl/01_resources.bcl) ----------------------------------------
DB_DRIVER=sqlite
DB_DSN=file:.data/starter/app.db?_pragma=busy_timeout(5000)
# DB_MAX_OPEN_CONNECTIONS=20
# DB_MAX_IDLE_CONNECTIONS=5

# --- Sessions (bcl/01_resources.bcl) ----------------------------------------
# SESSION_COOKIE_SECURE=false

# --- Notifications (bcl/01_resources.bcl, bcl/09_workflow_example.bcl) -----
# NOTIFY_HOST=127.0.0.1
# NOTIFY_ALLOW_PRIVATE=true
# NOTIFY_URL=http://127.0.0.1:8099/welcome

# --- Scheduled digest (bcl/06_schedules.bcl) --------------------------------
# DIGEST_EMAIL=ops@example.com

# --- Network protection (bcl/01_resources.bcl, security/tcpguard.bcl) -------
# GUARD_MODE=enforce   # "monitor" to log findings without blocking anything

# --- Point at a different .env file instead of ./.env -----------------------
# ENV_FILE=.env.local
