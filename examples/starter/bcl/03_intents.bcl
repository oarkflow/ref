# ===========================================================================
# Business logic
#
# Everything below is a fact-DAG intent: transport-neutral business logic
# that a route, a worker, a schedule or a webhook trigger can invoke without
# duplicating it. `notify.welcome` is deliberately invoked from all four in
# 04_routes.bcl / 05_workers.bcl / 06_schedules.bcl / 07_triggers.bcl, so
# that claim is something you can see, not just read.
#
# Add a product feature by adding an intent (and, if it's HTTP-reachable, a
# route) here — never by adding a Go handler.
# ===========================================================================

# A dependency-free liveness smoke test, independent of /livez and /readyz
# (which check the database). Useful as the very first thing to curl.
intent "health.ping" {
  response "pong"
  node "pong" { uses "collect" requires [input] provides [pong] config { unwrap true } }
}

# ---------------------------------------------------------------------------
# Authentication — session cookies, argon2id passwords.
# ---------------------------------------------------------------------------

intent "auth.register" {
  description "Register a new account and sign in"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config { source_fact "input" shape "user" }
  }

  node "check-duplicate" {
    uses "database.query"
    resource "database"
    kind read
    speculation pre_auth_safe
    requires [input, validated]
    provides [existing_users]
    config { statement "SELECT id FROM users WHERE email = LOWER($1) LIMIT 1" args [input.email] }
  }

  # validate.expression, not decision.expression: a decision records
  # allow/deny but never publishes its provides fact, so a node requiring it
  # would never run and every registration would end as a generic 403.
  node "guard-duplicate" {
    uses "validate.expression"
    requires [existing_users]
    provides [not_duplicate]
    config {
      expression "len(existing_users) < 1"
      message "An account with this email already exists"
    }
  }

  node "hash-password" {
    uses "auth.password_hash"
    requires [input, not_duplicate]
    provides [password_hash]
    config { value_fact "input.password" algorithm "argon2id" memory 65536 iterations 3 parallelism 4 min_length 8 }
  }

  node "insert-user" {
    uses "database.query"
    resource "database"
    kind effect
    requires [input, password_hash]
    provides [users]
    config {
      statement "INSERT INTO users (id, email, name, password_hash, roles, status) VALUES (LOWER($1), LOWER($1), $2, $3, 'user', 'active') RETURNING id, email, name, password_hash, roles, status, created_at"
      args [input.email, input.name, password_hash]
    }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input]
    provides [audit_logged]
    config { statement "INSERT INTO audit_log (action, actor_id) VALUES ('user.registered', $1)" args [input.email] }
  }

  # auth.login verifies the password against the row's password_hash (which
  # is why insert-user's RETURNING includes it) and never copies the hash
  # into the principal it issues a session for.
  node "login" {
    uses "auth.login"
    resource "sessions"
    kind pure
    requires [input, users]
    provides [principal]
    config { user_fact "users" password_fact "input.password" roles_field "roles" }
  }

  node "response" { uses "collect" requires [principal, audit_logged] provides [response] }
}

intent "auth.login" {
  description "Verify credentials with argon2id and open a session"
  response "response"
  timeout 5s

  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config { source_fact "input" shape "login_input" }
  }

  node "find-user" {
    uses "database.query"
    resource "database"
    kind read
    speculation pre_auth_safe
    requires [input, validated]
    provides [users]
    config { statement "SELECT id, email, name, password_hash, roles, status FROM users WHERE email = LOWER($1) LIMIT 1" args [input.email] }
  }

  node "login" {
    uses "auth.login"
    resource "sessions"
    kind pure
    requires [input, users]
    provides [principal]
    config { user_fact "users" password_fact "input.password" roles_field "roles" disabled_field "status != 'active'" }
  }

  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [principal]
    provides [audit_logged]
    config { statement "INSERT INTO audit_log (action, actor_id) VALUES ('auth.login', $1)" args [principal.id] }
  }

  node "response" { uses "collect" requires [principal, audit_logged] provides [response] }
}

intent "auth.logout" {
  description "Destroy the session and clear the cookie"
  response "response"

  node "require-user" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "logout" { uses "auth.logout" resource "sessions" kind effect requires [user_id] provides [logged_out] }
  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, logged_out]
    provides [audit_logged]
    config { statement "INSERT INTO audit_log (action, actor_id) VALUES ('auth.logout', $1)" args [user_id] }
  }
  node "response" { uses "collect" requires [logged_out, audit_logged] provides [response] }
}

intent "auth.change_password" {
  description "Verify the current password and set a new argon2id hash"
  response "response"
  timeout 5s

  node "user" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "validate" {
    uses "validate.schema"
    requires [input]
    provides [validated]
    config { source_fact "input" shape "change_password_input" }
  }
  node "load-user" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id, validated]
    provides [user_rows]
    config { statement "SELECT password_hash FROM users WHERE id = $1 LIMIT 1" args [user_id] }
  }
  node "verify-current" {
    uses "auth.password_verify"
    kind pure
    requires [input, user_rows]
    provides [verified]
    config { password_fact "input.current_password" hash_fact "user_rows.0.password_hash" }
  }
  node "hash-new" {
    uses "auth.password_hash"
    requires [input, verified]
    provides [new_password_hash]
    config { value_fact "input.new_password" algorithm "argon2id" memory 65536 iterations 3 parallelism 4 min_length 8 }
  }
  node "update-password" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, new_password_hash]
    provides [password_updated]
    config { statement "UPDATE users SET password_hash = $1, updated_at = CURRENT_TIMESTAMP WHERE id = $2" args [new_password_hash, user_id] }
  }
  node "audit" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [user_id, password_updated]
    provides [audit_logged]
    config { statement "INSERT INTO audit_log (action, actor_id) VALUES ('auth.password_changed', $1)" args [user_id] }
  }
  node "response" { uses "collect" requires [password_updated, audit_logged] provides [response] }
}

# ---------------------------------------------------------------------------
# Password reset — a one-time token, delivered asynchronously.
#
# auth.forgot_password never reveals whether the email exists: the
# INSERT...SELECT below simply inserts nothing when no user matches, and the
# response is identical either way. The delivery itself is queued (the same
# queue.publish + worker pattern notify.welcome uses for its async entry
# point), reusing the "notifications" resource — swap that for a real
# mailer/SMTP action in production; a webhook target is what this starter
# ships without adding SMTP as a dependency.
# ---------------------------------------------------------------------------

intent "auth.forgot_password" {
  description "Create a one-time reset token and queue its delivery"
  response "response"
  timeout 5s

  node "validate" { uses "validate.required" requires [input] provides [validated] config { fields [input.email] } }
  node "token" { uses "auth.reset_token" requires [validated] provides [reset_token] config { ttl 15m } }
  node "store-token" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input, reset_token]
    provides [token_stored]
    config {
      statement "INSERT INTO password_resets (token_hash, user_id, expires_at) SELECT $1, id, $2 FROM users WHERE email = LOWER($3)"
      args [reset_token.hash, reset_token.expires_at, input.email]
    }
  }
  node "payload" { uses "collect" requires [input, reset_token, token_stored] provides [notification_payload] }
  node "enqueue" {
    uses "queue.publish"
    resource "jobs"
    kind async_effect
    requires [notification_payload]
    provides [notification_job]
    config { job_type "auth.password_reset" payload_fact "notification_payload" }
  }
  node "response" { uses "collect" requires [notification_job] provides [response] }
}

intent "auth.reset_password" {
  description "Consume a valid reset token exactly once"
  response "response"
  timeout 5s

  node "validate" { uses "validate.schema" requires [input] provides [validated] config { source_fact "input" shape "password_reset_input" } }
  node "token-hash" { uses "auth.token_hash" requires [input, validated] provides [token_hash] config { value_fact "input.token" } }
  node "password-hash" {
    uses "auth.password_hash"
    requires [input, validated]
    provides [new_password_hash]
    config { value_fact "input.new_password" algorithm "argon2id" memory 65536 iterations 3 parallelism 4 min_length 8 }
  }
  node "consume-token" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [token_hash, new_password_hash]
    provides [password_reset]
    config {
      statement "UPDATE users SET password_hash = $1, updated_at = CURRENT_TIMESTAMP WHERE id = (SELECT user_id FROM password_resets WHERE token_hash = $2 AND expires_at > CURRENT_TIMESTAMP AND used_at IS NULL)"
      args [new_password_hash, token_hash]
      require_affected true
      not_found_message "reset token is invalid or expired"
    }
  }
  node "mark-used" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [token_hash, password_reset]
    provides [token_consumed]
    config { statement "UPDATE password_resets SET used_at = CURRENT_TIMESTAMP WHERE token_hash = $1" args [token_hash] }
  }
  node "response" { uses "collect" requires [password_reset, token_consumed] provides [response] }
}

# The worker (bcl/05_workers.bcl) invokes this for job_type
# "auth.password_reset". Point NOTIFY_URL at a real notification service —
# the loopback default is for local development only.
intent "notification.password_reset" {
  description "Deliver a password-reset token to the notification service"
  response "response"
  timeout 15s
  max_external_io 1

  # The worker that runs this (bcl/05_workers.bcl) bypasses the HTTP
  # maintenance middleware entirely — this guard is what makes maintenance
  # mode apply here too. See internal/ops.MaintenanceGate.RegisterAction.
  node "maintenance" { uses "ops.maintenance_status" provides [maintenance_on] }
  node "not-in-maintenance" {
    uses "validate.expression"
    requires [maintenance_on]
    provides [maintenance_ok]
    config { expression "maintenance_on == false" message "maintenance mode is on; delivery is paused" }
  }

  node "deliver" {
    uses "service.http"
    resource "notifications"
    kind effect
    requires [input, maintenance_ok]
    provides [delivery]
    bulkhead { name "notify-welcome-delivery" limit 5 }
    config { method POST url env("NOTIFY_URL", "http://127.0.0.1:8099/welcome") body_fact "input" }
  }
  node "response" { uses "collect" requires [delivery] provides [response] }
}

# ---------------------------------------------------------------------------
# Protected pages
# ---------------------------------------------------------------------------

intent "dashboard.index" {
  description "The signed-in member's own dashboard"
  response "response"

  node "user-id" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "load-user" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [user_rows]
    config { statement "SELECT id, email, name, roles, status, created_at FROM users WHERE id = $1 LIMIT 1" args [user_id] }
  }
  node "user" { uses "data.first" requires [user_rows] provides [user] config { source_fact "user_rows" } }
  node "response" { uses "collect" requires [user] provides [response] }
}

intent "dashboard.admin" {
  description "The admin-only user directory"
  response "response"

  node "user-id" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }

  # Loaded so the page's own navbar (which renders from this same response)
  # shows the signed-in admin, not just the directory table.
  node "load-caller" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [caller_rows]
    config { statement "SELECT id, email, name, roles, status, created_at FROM users WHERE id = $1 LIMIT 1" args [user_id] }
  }
  node "user" { uses "data.first" requires [caller_rows] provides [user] config { source_fact "caller_rows" } }

  node "users" {
    uses "database.query"
    resource "database"
    kind read
    requires [user]
    provides [users]
    config { statement "SELECT id, email, name, roles, status, created_at FROM users ORDER BY created_at DESC LIMIT 50" }
  }
  node "response" { uses "collect" requires [user, users] provides [response] }
}

intent "api.me" {
  description "The caller's own profile — reachable by any signed-in role, unlike api.users"
  response "response"

  node "user-id" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "rows" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [rows]
    config { statement "SELECT id, email, name, roles FROM users WHERE id = $1 LIMIT 1" args [user_id] }
  }
  node "me" { uses "data.first" requires [rows] provides [me] config { source_fact "rows" } }
  node "response" { uses "collect" requires [me] provides [response] }
}

intent "api.users" {
  description "JSON: list every account — the API twin of dashboard.admin"
  response "response"

  node "user-id" { uses "auth.require_session" resource "sessions" kind decision provides [user_id] }
  node "users" {
    uses "database.query"
    resource "database"
    kind read
    requires [user_id]
    provides [users]
    config { statement "SELECT id, email, name, roles, status, created_at FROM users ORDER BY created_at DESC LIMIT 50" }
  }
  node "response" { uses "collect" requires [users] provides [response] }
}

# ---------------------------------------------------------------------------
# notify.welcome — one intent, four entry points.
#
# It takes { email, name } and delivers a welcome notification. The
# `bulkhead` caps how many deliveries can be in flight at once, so a slow or
# unreachable notification service cannot exhaust every worker goroutine
# regardless of which entry point is driving it — the limiter is shared by
# name across all of them.
# ---------------------------------------------------------------------------

intent "notify.welcome" {
  description "Deliver a welcome notification — invoked by a route, a worker, a schedule and a webhook trigger"
  response "response"
  timeout 15s
  max_external_io 1

  node "validate" {
    uses "validate.required"
    requires [input]
    provides [validated]
    config { fields [input.email] }
  }

  # The worker/schedule/webhook-trigger entry points bypass the HTTP
  # maintenance middleware entirely — this guard is what makes maintenance
  # mode apply to them too. See internal/ops.MaintenanceGate.RegisterAction.
  node "maintenance" { uses "ops.maintenance_status" provides [maintenance_on] }
  node "not-in-maintenance" {
    uses "validate.expression"
    requires [maintenance_on]
    provides [maintenance_ok]
    config { expression "maintenance_on == false" message "maintenance mode is on; welcome delivery is paused" }
  }

  node "deliver" {
    uses "service.http"
    resource "notifications"
    kind effect
    requires [input, validated, maintenance_ok]
    provides [delivery]
    bulkhead { name "notify-welcome-delivery" limit 5 }
    config { method POST url env("NOTIFY_URL", "http://127.0.0.1:8099/welcome") body_fact "input" }
  }

  node "response" { uses "collect" requires [delivery] provides [response] }
}

# The asynchronous entry point: enqueues the same payload for the worker in
# 05_workers.bcl to run notify.welcome on. A route can call notify.welcome
# directly (synchronous) or this intent (fire-and-forget) for the identical
# business outcome — the caller picks the transport, the business logic
# never changes.
intent "notify.welcome_async" {
  description "Queue a welcome notification for background delivery"
  response "response"
  node "validate" {
    uses "validate.required"
    requires [input]
    provides [validated]
    config { fields [input.email] }
  }
  node "enqueue" {
    uses "queue.publish"
    resource "jobs"
    kind async_effect
    requires [input, validated]
    provides [job]
    config { job_type "notify.welcome" payload_fact "input" }
  }
  node "response" { uses "collect" requires [job] provides [response] }
}

# ---------------------------------------------------------------------------
# One example entity (docs/entities.md), commented out: a full CRUD REST
# resource — migrated table, filters, search, export and access rules — from
# one declarative block. Uncomment and rename to start a real feature; a
# `column { kind decimal }` is included because money/quantity columns are a
# common source of float-rounding bugs and worth doing correctly from the
# first day (docs/localization-and-money.md).
# ---------------------------------------------------------------------------

# entity "items" {
#   database "database"
#   path "/api/v1/items"
#   auth "session_auth"
#   tenant_scoped true
#   soft_delete true
#   versioned true
#   search ["name"]
#
#   column "name" { kind string required true }
#   column "quantity" { kind int default 0 }
#   column "unit_price" { kind decimal scale 2 }
#
#   allow "read" { roles ["admin", "user"] }
#   allow "write" { roles ["admin"] }
# }
