pipeline "education_alumni_registration" {
  title "Alumni Registration"
  description "Alumni registration and network building workflow"
  form "alumni_profile" {
    title "Alumni Profile"
    input "full_name" {
      label "Full Name"
      kind text
      required true
    }
    input "graduation_year" {
      label "Graduation Year"
      kind text
      required true
    }
    input "program" {
      label "Program"
      kind text
      required true
    }
    input "current_occupation" {
      label "Current Occupation"
      kind text
    }
    input "company" {
      label "Company/Organization"
      kind text
    }
    input "email" {
      label "Email"
      kind text
      required true
    }
    input "phone" {
      label "Phone"
      kind text
    }
    input "photo" {
      label "Photo"
      kind file
      accept ["image/*"]
    }
    input "certificate" {
      label "Certificate/ID"
      kind file
      accept ["application/pdf,image/*"]
    }
  }
  form "verification_form" {
    title "Verification"
    input "verified" {
      label "Verified"
      kind boolean
      required true
    }
    input "notes" {
      label "Notes"
      kind textarea
    }
  }
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  stage "registration" {
    title "Registration"
    kind submission
    public true
    require_account true
    roles ["alumni"]
    page {
      title "Registration"
      layout wizard
      group "application_block" {
        title "application_block"
        forms ["alumni_profile"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "verification" {
    title "Verification"
    kind review
    roles ["admin"]
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Verification"
      layout wizard
      group "verification_block" {
        title "verification_block"
        forms ["verification_form"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["verification_form"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
