pipeline "bank_account_closure" {
  title "Bank Account Closure"
  description "Bank account closure request and processing"
  form "account_info" {
    title "Account Information"
    input "account_number" {
      label "Account Number"
      kind text
      required true
    }
    input "account_holder_name" {
      label "Account Holder Name"
      kind text
      required true
    }
    input "branch" {
      label "Branch"
      kind select
      required true
      options ["ho", "ktm_main", "pokhara", "lalitpur", "bhaktapur"]
    }
    input "closure_reason" {
      label "Reason for Closure"
      kind select
      required true
      options ["relocating", "switching", "not_needed", "inactivity", "other"]
    }
    input "other_reason" {
      label "Other Reason"
      kind textarea
    }
    input "id_document" {
      label "ID Document"
      kind file
      required true
      accept ["image/*,application/pdf"]
    }
    input "passbook" {
      label "Passbook"
      kind file
      required true
      accept ["image/*,application/pdf"]
    }
  }
  form "verification_form" {
    title "Verification"
    input "documents_verified" {
      label "Documents Verified"
      kind boolean
      required true
    }
    input "account_status_check" {
      label "Account Status Check"
      kind boolean
      required true
    }
    input "verification_notes" {
      label "Verification Notes"
      kind textarea
    }
  }
  form "clearance_form" {
    title "Account Clearance"
    input "balance_check" {
      label "Balance Check"
      kind text
      required true
    }
    input "pending_transactions" {
      label "Pending Transactions"
      kind textarea
    }
    input "clearance_status" {
      label "Clearance Status"
      kind select
      required true
      options ["cleared", "pending", "blocked"]
    }
    input "clearance_notes" {
      label "Clearance Notes"
      kind textarea
    }
  }
  form "approval_form" {
    title "Approval"
    input "approval_decision" {
      label "Approval Decision"
      kind select
      required true
      options ["approved", "rejected"]
    }
    input "approval_notes" {
      label "Approval Notes"
      kind textarea
    }
  }
  form "closure_form" {
    title "Closure"
    input "account_closed" {
      label "Account Closed"
      kind boolean
      required true
    }
    input "closure_date" {
      label "Closure Date"
      kind date
      required true
    }
    input "final_balance" {
      label "Final Balance"
      kind text
      required true
    }
    input "closure_reference" {
      label "Closure Reference"
      kind text
      required true
    }
  }
  form "account_closure_rfi_response" {
    title "Response to Information Request"
    input "clarification_note" {
      label "Clarification Note"
      kind textarea
      required true
    }
  }
  allow_rfi true
  notify "case.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.completed"
    body "Case {case.number} has event case.completed"
  }
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "verification"
  }
  stage "request" {
    title "Request"
    kind submission
    public true
    require_account true
    roles ["account_holder"]
    page {
      title "Request"
      layout wizard
      group "request_block" {
        title "request_block"
        forms ["account_info"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "verification" {
    title "Verification"
    kind review
    roles ["verification_officer"]
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Verification"
      layout wizard
      group "verification_block" {
        title "verification_block"
        forms ["verification_form"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["verification_form"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "clearance" {
    title "Clearance"
    kind processing
    roles ["clearance_officer"]
    sla {
      duration "2880m"
      on_breach "notify"
    }
    page {
      title "Clearance"
      layout wizard
      group "clearance_block" {
        title "clearance_block"
        forms ["clearance_form"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "approval" {
    title "Approval"
    kind approval
    roles ["approval_officer"]
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Approval"
      layout wizard
      group "approval_block" {
        title "approval_block"
        forms ["approval_form"]
      }
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "closure" {
    title "Closure"
    kind processing
    roles ["admin"]
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Closure"
      layout wizard
      group "closure_block" {
        title "closure_block"
        forms ["closure_form"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
