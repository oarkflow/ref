pipeline "bank_atm_card_issuance" {
  title "ATM Card Issuance"
  description "ATM and debit card application, verification, and issuance process"
  form "card_application" {
    title "Card Application"
    input "account_number" {
      label "Account Number"
      kind text
      required true
    }
    input "account_holder_name" {
      label "Account Holder Name"
      kind text
      required true
    }
    input "card_type" {
      label "Card Type"
      kind select
      required true
      options ["debit", "credit", "prepaid"]
    }
    input "card_brand" {
      label "Card Brand"
      kind select
      required true
      options ["visa", "mastercard", "unionpay"]
    }
    input "branch" {
      label "Home Branch"
      kind select
      required true
      options ["ho", "ktm_main", "pokhara", "lalitpur"]
    }
    input "delivery_branch" {
      label "Delivery Branch"
      kind select
      required true
      options ["same", "nearest"]
    }
    input "photo" {
      label "Passport Photo"
      kind file
      required true
      accept ["image/*"]
    }
    input "id_copy" {
      label "ID Copy"
      kind file
      required true
      accept ["image/*,application/pdf"]
    }
  }
  form "verification_form" {
    title "Verification"
    input "account_verified" {
      label "Account Verified"
      kind boolean
      required true
    }
    input "documents_verified" {
      label "Documents Verified"
      kind boolean
      required true
    }
    input "verification_notes" {
      label "Verification Notes"
      kind textarea
    }
  }
  form "approval_form" {
    title "Approval"
    input "approval_decision" {
      label "Approval Decision"
      kind select
      required true
      options ["approved", "rejected"]
    }
    input "approval_notes" {
      label "Approval Notes"
      kind textarea
    }
  }
  form "issuance_form" {
    title "Issuance"
    input "card_issued" {
      label "Card Issued"
      kind boolean
      required true
    }
    input "card_number" {
      label "Card Number"
      kind text
      required true
    }
    input "issue_date" {
      label "Issue Date"
      kind date
      required true
    }
    input "expiry_date" {
      label "Expiry Date"
      kind date
      required true
    }
    input "dispatch_mode" {
      label "Dispatch Mode"
      kind select
      required true
      options ["branch", "courier"]
    }
  }
  form "atm_rfi_response" {
    title "Response to Information Request"
    input "clarification_note" {
      label "Clarification Note"
      kind textarea
      required true
    }
  }
  allow_rfi true
  notify "case.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.completed"
    body "Case {case.number} has event case.completed"
  }
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "verification"
  }
  stage "application" {
    title "Application"
    kind submission
    public true
    require_account true
    roles ["account_holder"]
    page {
      title "Application"
      layout wizard
      group "application_block" {
        title "application_block"
        forms ["card_application"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "verification" {
    title "Verification"
    kind review
    roles ["verification_officer"]
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Verification"
      layout wizard
      group "verification_block" {
        title "verification_block"
        forms ["verification_form"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["verification_form"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "approval" {
    title "Approval"
    kind approval
    roles ["approval_officer"]
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Approval"
      layout wizard
      group "approval_block" {
        title "approval_block"
        forms ["approval_form"]
      }
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "issuance" {
    title "Issuance"
    kind processing
    roles ["admin"]
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Issuance"
      layout wizard
      group "issuance_block" {
        title "issuance_block"
        forms ["issuance_form"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
