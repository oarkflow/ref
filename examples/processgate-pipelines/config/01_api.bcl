route "catalog" {
  method GET
  path "/api/pipelines"
  intent "cases.catalog"
  auth "jwt"
}

route "describe" {
  method GET
  path "/api/pipelines/:pipeline"
  intent "cases.describe"
  auth "jwt"
  allow_anonymous true
}

route "start" {
  method POST
  path "/api/pipelines/:pipeline/cases"
  intent "cases.start"
  auth "jwt"
  allow_anonymous true
  status 201
}

route "list" {
  method GET
  path "/api/pipelines/:pipeline/cases"
  intent "cases.list"
  auth "jwt"
}

route "get" {
  method GET
  path "/api/pipelines/:pipeline/cases/:id"
  intent "cases.get"
  auth "jwt"
  allow_anonymous true
}

route "view" {
  method GET
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage"
  intent "cases.view"
  auth "jwt"
  allow_anonymous true
}

route "save" {
  method PUT
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage"
  intent "cases.save"
  auth "jwt"
  allow_anonymous true
}

route "act" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/actions/:action"
  intent "cases.act"
  auth "jwt"
  allow_anonymous true
}

route "node" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/nodes/:node/:verb"
  intent "cases.node"
  auth "jwt"
}

route "work" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/work/:op"
  intent "cases.work"
  auth "jwt"
}

route "upload" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/files/:path"
  intent "cases.upload"
  auth "jwt"
  allow_anonymous true
  max_body_bytes 10485760
}

route "file" {
  method GET
  path "/api/pipelines/:pipeline/cases/:id/files/:path"
  intent "cases.file"
  auth "jwt"
  allow_anonymous true
}

route "schedule_list" {
  method GET
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/schedules"
  intent "cases.schedule_list"
  auth "jwt"
  allow_anonymous true
}

route "schedule_create" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/schedules"
  intent "cases.schedule_create"
  auth "jwt"
  allow_anonymous true
}

route "schedule_submit" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/stages/:stage/schedules/:schedule/submissions"
  intent "cases.schedule_submit"
  auth "jwt"
  allow_anonymous true
}

route "payment_record" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/payments/verify"
  intent "cases.payment_record"
  auth "jwt"
}

route "request_information" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/request-information"
  intent "cases.request_information"
  auth "jwt"
  allow_anonymous true
}

route "submit_information" {
  method POST
  path "/api/pipelines/:pipeline/cases/:id/submit-information"
  intent "cases.submit_information"
  auth "jwt"
  allow_anonymous true
}

static "app" {
  prefix "/app"
  root env("PROCESSGATE_PIPELINES_STATIC", "static")
  index "index.html"
}

resource "bus" {
  kind "queue.sql"
  description "Durable queue so one replica fires each scheduled sweep"
  config {
    database "database"
    table "processgate_jobs"
    workers 1
  }
}

intent "sla.sweep" {
  response "sweep"
  node "sweep" {
    uses "pipeline.sweep"
    resource "cases"
    kind effect
    provides [sweep]
    config {
      roles ["admin"]
    }
  }
}

route "sla.sweep" {
  method POST
  path "/api/admin/sla/sweep"
  intent "sla.sweep"
  auth "jwt"
}

schedule "sla_sweep" { every 1m queue "bus" intent "sla.sweep" }
