intent "notifications.deliver" {
  response "stored"
  node "stored" {
    uses "database.exec"
    resource "database"
    kind effect
    requires [input]
    provides [stored]
    config {
      statement "INSERT INTO processgate_messages (tenant_id, user_id, channel, subject, body) VALUES ($1, $2, $3, $4, $5)"
      args ["input.tenant_id", "input.user", "input.channel", "input.subject", "input.body"]
    }
  }
}

intent "notifications.mine" {
  response "messages"
  node "messages" {
    uses "database.crud"
    resource "database"
    provides [messages]
    config {
      operation "list"
      table "processgate_messages"
      columns ["id", "tenant_id", "user_id", "channel", "subject", "body", "created_at"]
      tenant_column "tenant_id"
      owner_column "user_id"
      order_by "id"
      descending true
    }
  }
}

route "notifications.mine" {
  method GET
  path "/api/notifications"
  intent "notifications.mine"
  auth "jwt"
}

intent "auth.register" {
  response "registration"
  node "registration" {
    uses "identity.register_totp"
    resource "users"
    kind effect
    requires [input]
    provides [registration]
    config {
      tenant "processgate"
      role "applicant"
      issuer "REF ProcessGate Pipelines"
    }
  }
}

intent "auth.confirm" {
  response "registration"
  node "registration" {
    uses "identity.confirm_totp"
    resource "users"
    kind effect
    requires [input]
    provides [registration]
  }
}

intent "auth.login" {
  response "session"
  node "session" {
    uses "identity.login"
    resource "users"
    kind effect
    requires [input]
    provides [session]
  }
}

intent "auth.invite" {
  response "invitation"
  node "invitation" {
    uses "identity.admin"
    resource "users"
    kind effect
    requires [input]
    provides [invitation]
    config {
      operation "invite"
    }
  }
}

intent "auth.accept_invite" {
  response "member"
  node "member" {
    uses "identity.accept_invite"
    resource "users"
    kind effect
    requires [input]
    provides [member]
  }
}

route "auth.register" {
  method POST
  path "/api/auth/register"
  intent "auth.register"
  cache_control "no-store"
  rate_limit { limiter "limits" limit 10 window 1m }
}

route "auth.confirm" {
  method POST
  path "/api/auth/register/confirm"
  intent "auth.confirm"
  cache_control "no-store"
  rate_limit { limiter "limits" limit 10 window 1m }
}

route "auth.login" {
  method POST
  path "/api/auth/login"
  intent "auth.login"
  cache_control "no-store"
  rate_limit { limiter "limits" limit 10 window 1m }
}

route "auth.invite" {
  method POST
  path "/api/auth/invite"
  intent "auth.invite"
  cache_control "no-store"
  auth "jwt"
}

route "auth.accept_invite" {
  method POST
  path "/api/auth/invitations/accept"
  intent "auth.accept_invite"
  cache_control "no-store"
  rate_limit { limiter "limits" limit 10 window 1m }
}

