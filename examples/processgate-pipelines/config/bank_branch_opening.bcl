pipeline "bank_branch_opening" {
  title "Bank Branch Opening"
  description "New bank branch opening process with feasibility study, regulatory approval, and operational launch"
  form "feasibility_study" {
    title "Feasibility Study"
    input "proposed_location" {
      label "Proposed Location"
      kind text
      required true
    }
    input "market_potential" {
      label "Market Potential"
      kind textarea
      required true
    }
    input "competition_analysis" {
      label "Competition Analysis"
      kind textarea
      required true
    }
  }
  form "location_analysis" {
    title "Location Analysis"
    input "area_demographics" {
      label "Area Demographics"
      kind textarea
      required true
    }
    input "accessibility" {
      label "Accessibility"
      kind text
      required true
    }
  }
  form "market_assessment" {
    title "Market Assessment"
    input "market_size" {
      label "Market Size"
      kind text
      required true
    }
    input "customer_potential" {
      label "Customer Potential"
      kind text
      required true
    }
  }
  form "financial_projection" {
    title "Financial Projection"
    input "revenue_projection" {
      label "Revenue Projection"
      kind text
      required true
    }
    input "cost_projection" {
      label "Cost Projection"
      kind text
      required true
    }
    input "profitability" {
      label "Profitability"
      kind text
      required true
    }
  }
  form "infrastructure_setup" {
    title "Infrastructure Setup"
    input "premises_ready" {
      label "Premises Ready"
      kind boolean
      required true
    }
    input "equipment_installed" {
      label "Equipment Installed"
      kind boolean
      required true
    }
    input "it_systems_ready" {
      label "IT Systems Ready"
      kind boolean
      required true
    }
  }
  form "staff_deployment" {
    title "Staff Deployment"
    input "staff_hired" {
      label "Staff Hired"
      kind text
      required true
    }
    input "staff_trained" {
      label "Staff Trained"
      kind boolean
      required true
    }
  }
  form "compliance_verification" {
    title "Compliance Verification"
    input "regulatory_requirements_met" {
      label "Regulatory Requirements Met"
      kind boolean
      required true
    }
    input "nrb_application_submitted" {
      label "NRB Application Submitted"
      kind boolean
      required true
    }
  }
  form "license_application" {
    title "License Application"
    input "application_date" {
      label "Application Date"
      kind date
      required true
    }
    input "application_status" {
      label "Application Status"
      kind select
      required true
      options ["submitted", "under_review", "approved"]
    }
  }
  form "nrb_approval_form" {
    title "NRB Approval"
    input "nrb_approved" {
      label "NRB Approved"
      kind boolean
      required true
    }
    input "license_number" {
      label "License Number"
      kind text
    }
  }
  form "license_issuance" {
    title "License Issuance"
    input "license_issued" {
      label "License Issued"
      kind boolean
      required true
    }
    input "launch_date" {
      label "Launch Date"
      kind date
      required true
    }
  }
  form "branch_rfi_response" {
    title "Response to Information Request"
    input "clarification_note" {
      label "Clarification Note"
      kind textarea
      required true
    }
  }
  allow_rfi true
  notify "case.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.completed"
    body "Case {case.number} has event case.completed"
  }
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "assessment"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "compliance"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "preparation"
  }
  stage "proposal" {
    title "Proposal"
    kind submission
    roles ["proposal_team"]
    page {
      title "Proposal"
      layout wizard
      group "proposal_block" {
        title "proposal_block"
        forms ["feasibility_study", "location_analysis"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "assessment" {
    title "Assessment"
    kind review
    roles ["branch_manager"]
    sla {
      duration "21600m"
      on_breach "notify"
    }
    page {
      title "Assessment"
      layout wizard
      group "assessment_block" {
        title "assessment_block"
        forms ["market_assessment", "financial_projection"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["market_assessment", "financial_projection"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "preparation" {
    title "Preparation"
    kind processing
    roles ["operations_officer"]
    sla {
      duration "86400m"
      on_breach "notify"
    }
    page {
      title "Preparation"
      layout wizard
      group "preparation_block" {
        title "preparation_block"
        forms ["infrastructure_setup", "staff_deployment"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "compliance" {
    title "Compliance"
    kind review
    roles ["compliance_officer"]
    sla {
      duration "43200m"
      on_breach "notify"
    }
    page {
      title "Compliance"
      layout wizard
      group "compliance_block" {
        title "compliance_block"
        forms ["compliance_verification", "license_application"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["compliance_verification", "license_application"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "nrb_approval" {
    title "NRB Approval"
    kind approval
    roles ["nrb_officer"]
    sla {
      duration "129600m"
      on_breach "notify"
    }
    page {
      title "NRB Approval"
      layout wizard
      group "approval_block" {
        title "approval_block"
        forms ["nrb_approval_form", "license_issuance"]
      }
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
