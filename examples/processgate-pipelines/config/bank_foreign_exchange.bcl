pipeline "bank_foreign_exchange" {
  title "Bank Foreign Exchange"
  description "Foreign exchange transaction processing in Nepali banks aligned with Nepal Rastra Bank regulations"
  form "exchange_request" {
    title "Exchange Request"
    input "exchange_type" {
      label "Exchange Type"
      kind select
      required true
      options ["buy", "sell"]
    }
    input "from_currency" {
      label "From Currency"
      kind select
      required true
      options ["NPR", "USD", "EUR", "GBP", "INR", "JPY", "CHF", "AUD", "CAD"]
    }
    input "to_currency" {
      label "To Currency"
      kind select
      required true
      options ["NPR", "USD", "EUR", "GBP", "INR", "JPY", "CHF", "AUD", "CAD"]
    }
    input "amount" {
      label "Amount"
      kind text
      required true
    }
  }
  form "purpose" {
    title "Purpose of Exchange"
    input "purpose_type" {
      label "Purpose"
      kind select
      required true
      options ["travel", "education", "medical", "import", "investment", "remittance", "other"]
    }
    input "purpose_details" {
      label "Purpose Details"
      kind textarea
      required true
    }
  }
  form "rate_verification" {
    title "Rate Verification"
    input "exchange_rate" {
      label "Exchange Rate"
      kind text
      required true
    }
    input "bank_margin" {
      label "Bank Margin"
      kind text
      required true
    }
    input "rate_valid_until" {
      label "Rate Valid Until"
      kind text
      required true
    }
    input "rate_verified" {
      label "Rate Verified"
      kind boolean
      required true
    }
  }
  form "transaction_details" {
    title "Transaction Details"
    input "charges" {
      label "Bank Charges (NPR)"
      kind text
      required true
    }
    input "total_payable" {
      label "Total Payable (NPR)"
      kind text
      required true
    }
    input "processing_complete" {
      label "Processing Complete"
      kind boolean
      required true
    }
    input "processing_notes" {
      label "Processing Notes"
      kind textarea
    }
  }
  form "compliance_check" {
    title "Compliance Check"
    input "regulatory_compliance" {
      label "Regulatory Compliance"
      kind boolean
      required true
    }
    input "purpose_valid" {
      label "Purpose Valid"
      kind boolean
      required true
    }
    input "sanction_check" {
      label "Sanction Check"
      kind boolean
      required true
    }
    input "compliance_notes" {
      label "Compliance Notes"
      kind textarea
    }
  }
  form "documentation" {
    title "Documentation"
    input "documents_verified" {
      label "Documents Verified"
      kind boolean
      required true
    }
    input "document_type" {
      label "Document Type"
      kind select
      options ["passport", "lc", "invoice", "ticket", "other"]
    }
    input "document_reference" {
      label "Document Reference"
      kind text
    }
  }
  form "execution_record" {
    title "Execution Record"
    input "execution_complete" {
      label "Execution Complete"
      kind boolean
      required true
    }
    input "transaction_date" {
      label "Transaction Date"
      kind date
      required true
    }
    input "reference_number" {
      label "Reference Number"
      kind text
      required true
    }
  }
  form "receipt_generation" {
    title "Receipt Generation"
    input "receipt_issued" {
      label "Receipt Issued"
      kind boolean
      required true
    }
    input "receipt_number" {
      label "Receipt Number"
      kind text
      required true
    }
    input "currency_disbursed" {
      label "Currency Disbursed"
      kind text
      required true
    }
  }
  form "forex_rfi_response" {
    title "Response to Information Request"
    input "clarification_note" {
      label "Clarification Note"
      kind textarea
      required true
    }
    input "additional_documents" {
      label "Additional Documents"
      kind file
      accept ["image/*,application/pdf"]
    }
  }
  payment {
    currency "NPR"
    amount 0
    verifier_roles ["payment_officer", "admin"]
  }
  allow_rfi true
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "compliance"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "processing"
  }
  stage "request_submission" {
    title "Request Submission"
    kind submission
    public true
    require_account true
    roles ["customer"]
    page {
      title "Request Submission"
      layout wizard
      group "request_block" {
        title "request_block"
        forms ["exchange_request", "purpose"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "processing" {
    title "Processing"
    kind review
    roles ["forex_officer"]
    sla {
      duration "30m"
      on_breach "notify"
    }
    page {
      title "Processing"
      layout wizard
      group "processing_block" {
        title "processing_block"
        forms ["rate_verification", "transaction_details"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["rate_verification", "transaction_details"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "compliance" {
    title "Compliance Check"
    kind approval
    roles ["compliance_officer"]
    sla {
      duration "120m"
      on_breach "notify"
    }
    page {
      title "Compliance Check"
      layout wizard
      group "compliance_block" {
        title "compliance_block"
        forms ["compliance_check", "documentation"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["compliance_check", "documentation"]
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "execution" {
    title "Transaction Execution"
    kind processing
    roles ["operations_manager"]
    sla {
      duration "30m"
      on_breach "notify"
    }
    page {
      title "Transaction Execution"
      layout wizard
      group "execution_block" {
        title "execution_block"
        forms ["execution_record", "receipt_generation"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
