pipeline "government_death_certificate" {
  title "Death Certificate"
  description "Death certificate registration and issuance in Nepal"
  form "deceased_info" {
    title "Deceased Information"
    input "deceased_name" {
      label "Deceased Name"
      kind text
      required true
    }
    input "gender" {
      label "Gender"
      kind select
      required true
      options ["male", "female", "other"]
    }
    input "date_of_death" {
      label "Date of Death"
      kind date
      required true
    }
    input "place_of_death" {
      label "Place of Death"
      kind text
      required true
    }
    input "age" {
      label "Age"
      kind text
      required true
    }
    input "citizenship_number" {
      label "Citizenship Number (if any)"
      kind text
    }
  }
  form "applicant_info" {
    title "Applicant Information"
    input "applicant_name" {
      label "Applicant Name"
      kind text
      required true
    }
    input "relationship" {
      label "Relationship to Deceased"
      kind select
      required true
      options ["spouse", "child", "parent", "sibling", "other"]
    }
    input "address" {
      label "Address"
      kind text
      required true
    }
    input "phone" {
      label "Phone"
      kind text
      required true
    }
    input "death_certificate_hospital" {
      label "Hospital Death Certificate"
      kind file
      required true
      accept ["application/pdf"]
    }
  }
  form "verification_form" {
    title "Verification"
    input "documents_verified" {
      label "Documents Verified"
      kind boolean
      required true
    }
    input "verification_notes" {
      label "Verification Notes"
      kind textarea
    }
  }
  form "approval_form" {
    title "Approval"
    input "approval_decision" {
      label "Approval Decision"
      kind select
      required true
      options ["approved", "rejected"]
    }
    input "approval_notes" {
      label "Approval Notes"
      kind textarea
    }
  }
  form "issuance_form" {
    title "Issuance"
    input "certificate_issued" {
      label "Certificate Issued"
      kind boolean
      required true
    }
    input "certificate_number" {
      label "Certificate Number"
      kind text
      required true
    }
    input "issue_date" {
      label "Issue Date"
      kind date
      required true
    }
  }
  form "death_rfi_response" {
    title "Response to Information Request"
    input "clarification_note" {
      label "Clarification Note"
      kind textarea
      required true
    }
  }
  allow_rfi true
  notify "case.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.completed"
    body "Case {case.number} has event case.completed"
  }
  notify "case.started" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: case.started"
    body "Case {case.number} has event case.started"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
  }
  notify "stage.completed" {
    to ["applicant", "assignee"]
    channels ["in_app"]
    subject "ProcessGate case {case.number}: stage.completed"
    body "Case {case.number} has event stage.completed"
    stage "verification"
  }
  stage "registration" {
    title "Registration"
    kind submission
    public true
    require_account true
    roles ["applicant"]
    page {
      title "Registration"
      layout wizard
      group "registration_block" {
        title "registration_block"
        forms ["deceased_info", "applicant_info"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "verification" {
    title "Verification"
    kind review
    roles ["verification_officer"]
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Verification"
      layout wizard
      group "verification_block" {
        title "verification_block"
        forms ["verification_form"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["verification_form"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "approval" {
    title "Approval"
    kind approval
    roles ["approval_officer"]
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Approval"
      layout wizard
      group "approval_block" {
        title "approval_block"
        forms ["approval_form"]
      }
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "issuance" {
    title "Issuance"
    kind processing
    roles ["admin"]
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Issuance"
      layout wizard
      group "issuance_block" {
        title "issuance_block"
        forms ["issuance_form"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
