pipeline "government_disability_id_card" {
  title "Government Disability ID Card"
  description "Disability ID card application, verification, category review, approval, and issuance flow."
  form "disability_applicant_profile" {
    title "disability_applicant_profile"
    input "applicant_name" {
      label "Applicant Full Name"
      kind text
      required true
      placeholder "Full legal name"
    }
    input "guardian_name" {
      label "Guardian Name"
      kind text
      placeholder "Guardian or caregiver name"
    }
    input "date_of_birth" {
      label "Date of Birth"
      kind date
      placeholder "Select DOB"
    }
    input "ward_number" {
      label "Ward Number"
      kind select
      required true
      options ["1", "2", "3"]
      placeholder "Select ward"
    }
    input "contact_phone" {
      label "Contact Phone"
      kind text
      required true
      placeholder "+977-98XXXXXXXX"
    }
  }
  form "disability_assessment_basis" {
    title "disability_assessment_basis"
    input "disability_type_note" {
      label "Disability Type"
      kind textarea
      required true
      placeholder "Describe the applicant-reported disability type"
    }
    input "existing_recommendation_reference" {
      label "Existing Recommendation Reference"
      kind text
      placeholder "Prior certificate/reference id if available"
    }
    input "support_need_note" {
      label "Support Need Note"
      kind textarea
      placeholder "Reason for support and assistance needed"
    }
  }
  form "disability_id_documents" {
    title "disability_id_documents"
    input "citizenship_upload" {
      label "Citizenship Upload"
      kind file
      required true
      accept ["image/*,.pdf"]
    }
    input "photo_upload" {
      label "Applicant Photo"
      kind file
      required true
      accept ["image/*"]
    }
    input "medical_recommendation_upload" {
      label "Medical Recommendation"
      kind file
      required true
      accept ["image/*,.pdf"]
    }
  }
  form "disability_verification" {
    title "disability_verification"
    input "identity_match_confirmed" {
      label "Identity Match Confirmed"
      kind boolean
    }
    input "residency_confirmed" {
      label "Residency Confirmed"
      kind boolean
    }
    input "document_completeness_confirmed" {
      label "Document Completeness Confirmed"
      kind boolean
    }
    input "verification_note" {
      label "Verification Note"
      kind textarea
      required true
      placeholder "Audit-ready verification comments"
    }
    input "verification_outcome" {
      label "Verification Outcome"
      kind select
      required true
      options ["verified", "needs_info", "reject"]
      placeholder "Select outcome"
    }
  }
  form "category_assessment" {
    title "category_assessment"
    input "disability_category" {
      label "Proposed Disability Category"
      kind select
      required true
      options ["physical", "visual", "hearing", "intellectual", "multiple"]
      placeholder "Select category"
    }
    input "severity_note" {
      label "Severity and Impact Note"
      kind textarea
      required true
      placeholder "Assessment rationale and degree"
    }
    input "assessment_reference" {
      label "Assessment Reference"
      kind text
      placeholder "Committee or medical assessment reference"
    }
    input "reviewer_note" {
      label "Reviewer Note"
      kind textarea
      placeholder "Reviewer comments"
    }
  }
  form "disability_id_decision" {
    title "disability_id_decision"
    input "decision" {
      label "Decision"
      kind select
      required true
      options ["approve", "reject", "request_information"]
      placeholder "Select decision"
    }
    input "approved_category" {
      label "Approved Category"
      kind select
      options ["physical", "visual", "hearing", "intellectual", "multiple"]
      placeholder "Select final category"
    }
    input "decision_note" {
      label "Decision Note"
      kind textarea
      placeholder "Explain approval rationale"
    }
    input "rejection_reason" {
      label "Rejection Reason"
      kind textarea
      placeholder "Required when rejecting"
    }
  }
  form "disability_id_issue" {
    title "disability_id_issue"
    input "card_number" {
      label "Card Number"
      kind text
      required true
      placeholder "DIS/2072/0001"
    }
    input "issue_date" {
      label "Issue Date"
      kind date
      placeholder "Select issue date"
    }
    input "dispatch_mode" {
      label "Dispatch Mode"
      kind select
      options ["pickup", "courier", "email"]
      placeholder "Select mode"
    }
    input "issue_note" {
      label "Issue Note"
      kind textarea
      placeholder "Additional issuance notes"
    }
  }
  form "disability_id_rfi_response" {
    title "disability_id_rfi_response"
    input "clarification_note" {
      label "Clarification / Response"
      kind textarea
      required true
      placeholder "Address the missing information request"
    }
    input "replacement_document_upload" {
      label "Replacement Evidence"
      kind file
      accept ["image/*,.pdf"]
    }
  }
  stage "citizen_submission" {
    title "Citizen Submission"
    kind submission
    public true
    page {
      title "Citizen Submission"
      layout wizard
      group "application_block" {
        title "application_block"
        forms ["disability_applicant_profile", "disability_assessment_basis"]
      }
      group "application_documents" {
        title "application_documents"
        forms ["disability_id_documents"]
      }
    }
    action "submit" {
      label "Submit"
      outcome advance
    }
  }
  stage "helpdesk_intake" {
    title "Helpdesk Intake"
    kind processing
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Helpdesk Intake"
      layout wizard
      group "application_block" {
        title "application_block"
        forms ["disability_applicant_profile", "disability_assessment_basis", "disability_id_documents"]
      }
    }
    action "rollback" {
      label "Return to previous stage"
      outcome return
      return_to "citizen_submission"
      comment_required true
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "eligibility_verification" {
    title "Eligibility Verification"
    kind review
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Eligibility Verification"
      layout wizard
      group "verification_block" {
        title "verification_block"
        forms ["disability_verification"]
      }
    }
    node "verification" {
      title "Verify submitted forms"
      kind review
      forms ["disability_verification"]
    }
    action "rollback" {
      label "Return to previous stage"
      outcome return
      return_to "helpdesk_intake"
      comment_required true
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "category_review" {
    title "Category Review"
    kind processing
    sla {
      duration "1440m"
      on_breach "notify"
    }
    page {
      title "Category Review"
      layout wizard
      group "assessment_block" {
        title "assessment_block"
        forms ["category_assessment"]
      }
    }
    action "rollback" {
      label "Return to previous stage"
      outcome return
      return_to "eligibility_verification"
      comment_required true
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "approval_stage" {
    title "Approval"
    kind approval
    sla {
      duration "240m"
      on_breach "notify"
    }
    page {
      title "Approval"
      layout wizard
      group "approval_block" {
        title "approval_block"
        forms ["disability_id_decision"]
      }
    }
    node "approval" {
      title "Approve stage"
      kind approval
      approvals 1
      distinct_from ["applicant"]
    }
    action "rollback" {
      label "Return to previous stage"
      outcome return
      return_to "category_review"
      comment_required true
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
  stage "id_issue_stage" {
    title "Issue Stage"
    kind processing
    sla {
      duration "480m"
      on_breach "notify"
    }
    page {
      title "Issue Stage"
      layout wizard
      group "issuance_block" {
        title "issuance_block"
        forms ["disability_id_issue"]
      }
    }
    action "complete" {
      label "Complete stage"
      outcome advance
    }
  }
}
