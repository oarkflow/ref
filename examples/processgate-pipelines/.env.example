# Local example values. Set unique secrets and a persistent database for deployment.
PROCESSGATE_PIPELINES_SIGNING_SECRET=local-example-signing-secret-change-before-deploy-2026
PROCESSGATE_PIPELINES_JWT_SECRET=local-example-jwt-secret-change-before-deploy-2026
PROCESSGATE_PIPELINES_DSN=file:.data/processgate-pipelines.db?_pragma=busy_timeout(5000)
PROCESSGATE_PIPELINES_FILES=.data/files
PROCESSGATE_PIPELINES_ADMIN_EMAIL=admin@example.test
PROCESSGATE_PIPELINES_ADMIN_PASSWORD=local-admin-password-change-before-deploy-2026
# Set to a deployed intent that verifies payment settlements with your gateway.
# PROCESSGATE_PAYMENT_VERIFY_INTENT=payments.verify
